<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="{{{or site.url siteRootPath}}}">{{site.title}}</a>
      <div class="navbar-item oca-title-text">Open Chiplet Atlas&#174; (OCA&#174;) Documentation</div>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search the docs"{{#if page.home}} autofocus{{/if}}>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <div class="navbar-item has-dropdown is-hoverable guides-menu">
          <a class="navbar-link" href="#">Guides</a>
          <div class="navbar-dropdown">
            <!-- One entry per book. Add a line here whenever a new book's
                 antora.yml/nav.adoc scaffolding lands -- these are plain
                 static links, deliberately not auto-generated from Antora's
                 component list, since that would require relying on
                 Handlebars helpers (resolvePage/relativize) we haven't
                 verified against the real UI bundle -- see tracking doc.

                 NOTE on the path shape: {{{siteRootPath}}} only ever
                 resolves back to the root of THIS SAME Antora build (e.g.
                 the "trm" folder once staged for gh-pages) -- it has no
                 concept of a sibling book living one level up. Since
                 doc/gh-pages.mk physically nests each book's whole output
                 under /trm/ or /integrator/ at deploy time, every link here
                 -- including the link back to the book you're already in --
                 goes {{{siteRootPath}}}/../<book-folder>/... , climbing one
                 extra level out to the shared gh-pages root before
                 descending into whichever book is being linked to. This is
                 deliberately uniform (same pattern for self-links and
                 cross-book links) so it doesn't need any per-page
                 conditional logic on which book is currently being viewed. -->
            <a class="navbar-item" href="{{{siteRootPath}}}/../trm/ocah-docs/latest/index.html">Technical Reference Manual</a>
            <a class="navbar-item" href="{{{siteRootPath}}}/../integrator/ocah-integrator-guide/latest/index.html">Integrator Guide</a>
            <a class="navbar-item" href="{{{siteRootPath}}}/../programmer/ocah-programmer-guide/latest/index.html">Programmer's Guide</a>
            <a class="navbar-item" href="{{{siteRootPath}}}/../appnotes/ocah-appnotes/latest/index.html">Application Notes</a>
          </div>
        </div>
        <div class="navbar-item has-dropdown is-hoverable downloads-menu">
          <a class="navbar-link" href="#">Downloads</a>
          <div class="navbar-dropdown">
            <!-- Deliberately NOT one-per-book: only list a PDF once a book
                 has real content and a working PDF build. A "coming soon"
                 placeholder page isn't worth a PDF download link yet --
                 add a line here as each book's PDF becomes real.
                 Same up-and-over path shape as the Guides menu above, into
                 a shared top-level downloads/ folder (sibling to trm/ and
                 integrator/) staged by doc/gh-pages.mk. -->
            <a class="navbar-item" href="{{{siteRootPath}}}/../downloads/ocah-trm.pdf">Technical Reference Manual (PDF)</a>
            <a class="navbar-item" href="{{{siteRootPath}}}/../downloads/ocah-integrator-guide.pdf">Integrator Guide (PDF)</a>
          </div>
        </div>
		<div class="navbar-item tt-link">
		  <a href="https://tenstorrent.com/" target="_blank" rel="noopener" title="Tenstorrent">
			<img src="{{{uiRootPath}}}/img/tenstorrent.png" alt="Tenstorrent" style="height: 24px;">
		  </a>
		</div>
      </div>
    </div>
  </nav>
</header>
