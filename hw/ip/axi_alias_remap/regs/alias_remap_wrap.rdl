`ifndef ALIAS_REMAP_WRAP_RDL
`define ALIAS_REMAP_WRAP_RDL

`include "alias_remap.rdl"

addrmap alias_remap_wrap #(
    longint unsigned NUM_REGIONS = 8
) {
    name = "AXI Alias Remap Wrapper Address Map";
    desc = "Wrapper address map instantiating one alias remap register block per remap region.";

    /////////////////
    // Address Map //
    /////////////////

    alias_remap    alias_remap[NUM_REGIONS]    @0x0 += 0x20;
};

`endif
