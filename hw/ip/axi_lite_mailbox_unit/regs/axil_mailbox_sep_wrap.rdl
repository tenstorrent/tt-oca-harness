`ifndef AXIL_MAILBOX_SEP_WRAP_RDL_DEFINED
`define AXIL_MAILBOX_SEP_WRAP_RDL_DEFINED

`include "axil_mailbox.rdl"

addrmap axil_mailbox_sep_wrap {
    name = "SEP AXI-Lite Mailbox Wrapper Address Map";
    desc = "SEP-side wrapper instantiating the inbound and outbound AXI-Lite mailbox pairs.";
    
    axil_mailbox     outbound_mailbox_0      @0x000_0000;
    axil_mailbox     inbound_mailbox_0       @0x000_0800;
    axil_mailbox     outbound_mailbox_1      @0x000_1000;
    axil_mailbox     inbound_mailbox_1       @0x000_1800;
    axil_mailbox     outbound_mailbox_2      @0x000_2000;
    axil_mailbox     inbound_mailbox_2       @0x000_2800;
    axil_mailbox     outbound_mailbox_3      @0x000_3000;
    axil_mailbox     inbound_mailbox_3       @0x000_3800;
    axil_mailbox     outbound_mailbox_4      @0x000_4000;
    axil_mailbox     inbound_mailbox_4       @0x000_4800;
    axil_mailbox     outbound_mailbox_5      @0x000_5000;
    axil_mailbox     inbound_mailbox_5       @0x000_5800;
    axil_mailbox     outbound_mailbox_6      @0x000_6000;
    axil_mailbox     inbound_mailbox_6       @0x000_6800;
    axil_mailbox     outbound_mailbox_7      @0x000_7000;
    axil_mailbox     inbound_mailbox_7       @0x000_7800;

};

`endif
