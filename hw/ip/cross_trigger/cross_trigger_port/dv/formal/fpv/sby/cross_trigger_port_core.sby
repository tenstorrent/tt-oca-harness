#
# Open-path formal run for cross_trigger_port_core. The filelist in [files] is generated by
# bender into ../../build/ (hw/common/dv/docs/formal-property-style.adoc); sby copies every
# [files] entry into the task's src/ directory, so the paths inside the filelist must be absolute.
# The cover depth must exceed the step at which the deepest cov_ label is reached; the bmc depth
# matches it so that every property is checked over the same horizon.

[tasks]
bmc
cover
prove

[options]
bmc:   mode bmc
bmc:   depth 24
cover: mode cover
cover: depth 24
prove: mode prove

[engines]
bmc:   smtbmc yices
cover: smtbmc yices
prove: abc pdr

[script]
plugin -i slang
read_slang -D FORMAL --top cross_trigger_port_core --allow-use-before-declare --timescale=1ns/1ps -f cross_trigger_port_core.f cross_trigger_port_core_props.sv cross_trigger_port_core_bind.sv
prep -top cross_trigger_port_core

[files]
../../build/cross_trigger_port_core.f
../../props/cross_trigger_port_core_props.sv
../../props/cross_trigger_port_core_bind.sv
