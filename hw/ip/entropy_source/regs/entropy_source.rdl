        } PROB_01[7:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Unused - probability calculation not implemented (no division in RTL). Always reads 0. Use MARKOV_TEST_COUNTS_0.COUNT_10 for raw transition count.";
        } PROB_10[15:8] = 0x0;
        field {
            sw = r;
            hw = w;
