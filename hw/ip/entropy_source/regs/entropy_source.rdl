            desc = "Sample clock division factor for generator 8. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div2 (ratio: 18.2x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x1;
