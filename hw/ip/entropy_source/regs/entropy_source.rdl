`ifndef ENTROPY_SOURCE_RDL
`define ENTROPY_SOURCE_RDL

//------------------------------------------------------------------------------
// Copyright 2025 Tenstorrent Inc.
// Entropy Source Configuration and Status Registers
//------------------------------------------------------------------------------

addrmap entropy_source {
    name = "Entropy Source Address Map";
    desc = "Configuration and status registers for the entropy source";
    reg COMPONENT_ID {
        desc = "Component Identification";
        field {
            sw = r;
            hw = na;
            desc = "Entropy Source";
        } NAME[15:0] = 0x0001;
        field {
            sw = r;
            hw = na;
            desc = "Minor Version";
        } MINOR_VERSION[27:24] = 0x1;
        field {
            sw = r;
            hw = na;
            desc = "Major Version";
        } MAJOR_VERSION[31:28] = 0x0;
    };

    reg CTRL {
        desc = "Entropy Source Control";
        field {
            sw = rw;
            hw = r;
            desc = "Software controlled reset when asserted high. Resets all internal state including health test counters, FIFO pointers, decorrelator shift registers, and the downsample phase counter. Ring oscillators continue running. Level-sensitive: the reset holds while this bit is 1, so software must write 0 to release it.";
        } RESET[0:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK: SW writes ignored while FIPS_LOCK.LOCK=1 (cleared only by reset).
            desc = "Master enable for the OpenTitan entropy_src_main_sm boot/startup gate. Drives main_sm's enable_i. When 0, main_sm stays in Idle and MAIN_SM_STATUS.BOOT_PHASE_DONE never asserts, so no entropy reaches the whitener/FIFO. When 1 (default), main_sm runs the boot health-test window and asserts BOOT_PHASE_DONE once it passes. Locked by FIPS_LOCK.LOCK. See doc/main_sm_boot_gate_functional_compat.md.";
        } MODULE_ENABLE[1:1] = 0x1;
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK: forces the certified value (default 0) to hold under lock.
            desc = "Enable automatic detuning of individual ring oscillator noise generators when corresponding per-generator health tests fail. When enabled, a failing health test causes the generator's noise RO to switch to its detuned (higher frequency) tap point. The shared sampling RO also detunes if ANY generator requests it. Automatic detuning is disabled by default (manual tuning via RING_OSC_TUNE required). Locked by FIPS_LOCK.LOCK: the lock freezes this field at whatever value it holds when FIPS_LOCK is set (swwel is value-agnostic). The certified flow writes 0 and then locks, so the entropy-source noise geometry cannot silently self-adjust mid-operation (SP 800-90B validated configuration).";
        } AUTOTUNE_ENABLE[4:4] = 0x0;
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK: certified path is compressor-enabled (default 0); raw bypass blocked under lock.
            desc = "Bypass Entropy Compressor (BIW extractor) when asserted high. When bypassed, all 96 bytes from the 12 generators (8 bytes each) are pushed directly into the FIFO without compression, increasing FIFO fill rate by 3x (96 bytes vs 32 bits per cycle). Used for raw entropy analysis and testing. Disabled by default (32-bit compressed output). Locked by FIPS_LOCK.LOCK: raw (uncompressed, unconditioned) output is not a validated FIPS mode, so firmware locks this at 0 for certified operation.";
        } BYPASS_ENTROPY_COMPRESSOR[8:8] = 0x0;
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK: rate is part of the validated sampling configuration.
            desc = "Downsample Rate for the decorrelator output. Specifies additional clock cycles to wait between entropy byte outputs. Value of N means output every (N+1) cycles. Applied after DECORRELATOR_CTRL.SAMPLE_CLK_DIV. Example: if SAMPLE_CLK_DIV=63 (div64) and DOWNSAMPLE_RATE=3, effective rate is div256 (64*(3+1)). Default=0 (no additional downsampling). Locked by FIPS_LOCK.LOCK (only wired into the push path in BYPASS_ENTROPY_COMPRESSOR mode).";
        } DOWNSAMPLE_RATE[25:16] = 0;
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK: certified operation requires the SHA-256 conditioner enabled (default 1).
            desc = "Enable SHA-256 whitening stage after BIW compression. When enabled, 16 × 32-bit BIW outputs (512 bits) are accumulated and hashed using SHA-256, producing 8 × 32-bit digest words (256 bits). This provides cryptographic conditioning per NIST SP 800-90B. When disabled, BIW output goes directly to FIFO (passthrough mode). Default=1 (enabled). Locked by FIPS_LOCK.LOCK: the vetted conditioning component must not be disabled during certified operation.";
        } SHA256_WHITENING_ENABLE[28:28] = 0x1;
    };

    reg STATUS {
        desc = "Entropy Source Status (currently unused, reserved for future expansion)";
        field {
            sw = r;
            hw = w;
            desc = "Reserved for future use. Always reads 0.";
        } RSVD[0:0] = 0x0;
    };

    reg SHA256_STATUS {
        desc = "SHA-256 Whitening Status";
        field {
            sw = r;
            hw = w;
            desc = "SHA-256 is actively hashing. Set when accumulating input buffer is complete and hash computation is in progress. Cleared when digest output phase completes.";
        } BUSY[0:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 32-bit words accumulated in SHA-256 input buffer (0-15). When this reaches 15 and the next word arrives, hashing begins. Useful for monitoring whitener activity and throughput.";
        } INPUT_COUNT[7:4] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 32-bit digest words remaining to be output (0-7). When hashing completes, 8 words are available for output. This counter decrements as words are consumed by downstream FIFO. 0 indicates all digest words have been output.";
        } OUTPUT_COUNT[10:8] = 3'h0;
    };

    reg DEBUG_CTRL {
        desc = "Debug control to monitor internal entropy noise source signals.";
        field {
            sw = rw;
            hw = r;
            desc = "Select Signal. Selects one of 256 internal signals to route to the external debug monitor pin. Signal mapping: [0-11]: Raw noise bits from generators 0-11 (1 bit per generator). [12-15]: Reserved. [16-27]: Divided sample clocks from generators 0-11 (1 bit per generator). [28-31]: Reserved. [32-63]: Compressed 32-bit entropy stream (BIW extractor output). [64-95]: FIFO input 32-bit entropy stream (pre-FIFO buffering). [96-127]: Reserved. [128-223]: Uncompressed per-generator entropy bytes (96 bits total): Generator 0 byte [135:128], Generator 1 byte [143:136], Generator 2 byte [151:144], Generator 3 byte [159:152], Generator 4 byte [167:160], Generator 5 byte [175:168], Generator 6 byte [183:176], Generator 7 byte [191:184], Generator 8 byte [199:192], Generator 9 byte [207:200], Generator 10 byte [215:208], Generator 11 byte [223:216]. [224-255]: Reserved. Reserved selections drive the signal mux output to 0. With SELECT_FREQ_DIV=0 the external monitor pin is also 0. With SELECT_FREQ_DIV nonzero, the selected ripple-divider stage retains its previous value while the mux output is 0, so the monitor pin can hold 0 or 1 until the divider is reset. Set SELECT_FREQ_DIV=0 before selecting a reserved value when a constant-zero pin output is required.";
        } SELECT_SIGNAL[7:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select Frequency Divider for debug monitor output pin. Division ratios: 0=div1 (no division), 1=div2, 2=div4, 3=div8, 4=div16, 5=div32, 6=div64, 7=div128. Used to slow down high-frequency signals for external observation. Default=0 (no division).";
        } SELECT_FREQ_DIV[10:8] = 0x0;
    };

    reg INTR_STATUS {
        desc = "Interrupt Status (write 1 to clear)";
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "Health Test Failed Interrupt. Set when any enabled health test (Repetition, APT, or Markov) fails on the 32-bit entropy stream or any per-generator test fails. Check HEALTH_TEST_STATUS and GENERATOR_*_HEALTH_STATUS for details. Write 1 to clear.";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Error Interrupt. Set on FIFO read/write protocol violations. Write 1 to clear.";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Overflow Interrupt. Set when entropy data is pushed to a full FIFO (64 entries deep). Data is discarded on overflow. Write 1 to clear.";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Underflow Interrupt. Set when software reads from an empty FIFO. Read returns stale/undefined data. Write 1 to clear.";
        } FIFO_UNDERFLOW[12:12] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "Persistent Failure Interrupt. Set when the health-test alert threshold is reached (ALERT_SUMMARY_FAIL_COUNTS.ANY_FAIL_COUNT >= ALERT_THRESHOLD), asserting main_sm.alert_thresh_fail_i and latching MAIN_SM_STATUS.ALERT. Indicates a persistent (not transient) entropy failure requiring firmware attention. Write 1 to clear.";
        } PERSISTENT_FAILURE[16:16] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "Autotune Failure Interrupt. Set when automatic ring-oscillator detuning fires in response to a per-generator health-test failure (CTRL.AUTOTUNE_ENABLE=1). Signals that the noise-source geometry self-adjusted, which is not permitted during FIPS-certified operation. Write 1 to clear.";
        } AUTOTUNE_FAIL[20:20] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "BIW Observe FIFO Overflow Interrupt. Set when a word is pushed to the full post-BIW diagnostic observe FIFO (BIW_OBS); the word is dropped. A gap in the diagnostic mirror is benign, but indicates software is not draining BIW_OBS_RDATA fast enough. Write 1 to clear.";
        } BIW_OBS_OVERFLOW[24:24] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "Noise Observe FIFO Overflow Interrupt. Set when a word is pushed to the full raw per-lane observe FIFO (NOISE_OBS); the word is dropped. This is a gap in the SP 800-90B raw-noise collection run for the selected lane, so software should drain NOISE_OBS_RDATA before the FIFO fills. Write 1 to clear.";
        } NOISE_OBS_OVERFLOW[28:28] = 0x0;
    };

    reg INTR_ENABLE {
        desc = "Interrupt Enable (individual enable bits for each interrupt source)";
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "Health Test Failed Interrupt Enable. Set to 1 to enable interrupt generation on health test failures. Default=0 (disabled).";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Error Interrupt Enable. Set to 1 to enable interrupt generation on FIFO errors. Default=0 (disabled).";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Overflow Interrupt Enable. Set to 1 to enable interrupt generation on FIFO overflow. Default=0 (disabled).";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Underflow Interrupt Enable. Set to 1 to enable interrupt generation on FIFO underflow. Default=0 (disabled).";
        } FIFO_UNDERFLOW[12:12] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "Persistent Failure Interrupt Enable. Set to 1 to enable interrupt generation on persistent health-test failure. Default=0 (disabled).";
        } PERSISTENT_FAILURE[16:16] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "Autotune Failure Interrupt Enable. Set to 1 to enable interrupt generation on automatic detune events. Default=0 (disabled).";
        } AUTOTUNE_FAIL[20:20] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "BIW Observe FIFO Overflow Interrupt Enable. Set to 1 to enable interrupt generation when the post-BIW diagnostic observe FIFO overflows. Default=0 (disabled).";
        } BIW_OBS_OVERFLOW[24:24] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "Noise Observe FIFO Overflow Interrupt Enable. Set to 1 to enable interrupt generation when the raw per-lane observe FIFO overflows. Default=0 (disabled).";
        } NOISE_OBS_OVERFLOW[28:28] = 0x0;
    };

    reg INTR_TEST {
        desc = "Interrupt Test (write 1 to manually trigger interrupt for testing)";
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Health Test Failed Interrupt Test. Write 1 to manually set INTR_STATUS.HEALTH_TEST_FAILED for interrupt handler testing. Self-clearing.";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Error Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_ERROR for interrupt handler testing. Self-clearing.";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Overflow Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_OVERFLOW for interrupt handler testing. Self-clearing.";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Underflow Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_UNDERFLOW for interrupt handler testing. Self-clearing.";
        } FIFO_UNDERFLOW[12:12] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Persistent Failure Interrupt Test. Write 1 to manually set INTR_STATUS.PERSISTENT_FAILURE for interrupt handler testing. Self-clearing.";
        } PERSISTENT_FAILURE[16:16] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Autotune Failure Interrupt Test. Write 1 to manually set INTR_STATUS.AUTOTUNE_FAIL for interrupt handler testing. Self-clearing.";
        } AUTOTUNE_FAIL[20:20] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "BIW Observe FIFO Overflow Interrupt Test. Write 1 to manually set INTR_STATUS.BIW_OBS_OVERFLOW for interrupt handler testing. Self-clearing.";
        } BIW_OBS_OVERFLOW[24:24] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Noise Observe FIFO Overflow Interrupt Test. Write 1 to manually set INTR_STATUS.NOISE_OBS_OVERFLOW for interrupt handler testing. Self-clearing.";
        } NOISE_OBS_OVERFLOW[28:28] = 0x0;
    };

    reg FIFO_CTRL {
        desc = "FIFO Control (64-entry x 32-bit entropy collection buffer)";
        field {
            sw = rw;
            hw = r;
            desc = "FIFO write enable control. When enabled (1=default), entropy data flows into FIFO and write pointer updates normally. When disabled (set to 0), write operations are blocked: no entropy pushed, write pointer frozen, data collection paused. IMPORTANT: Read operations remain functional when disabled - software can still drain the FIFO by reading FIFO_RDATA. This allows capturing a snapshot of entropy and reading it out without new data being added. Use case: Stop entropy collection, drain FIFO for analysis, re-enable collection. Default=1 (enabled).";
        } ENABLE[0:0] = 0x1;
        field {
            sw = rw;
            hw = r;
            desc = "Entropy Churning Mode Enable. When asserted high, incoming entropy data is XORed with existing FIFO data located at (write_ptr + DEPTH/2) % DEPTH before being written. This creates a circular feedback churning pattern where new entropy is combined with entropy from halfway around the FIFO buffer (32 entries earlier for DEPTH=64). Churning operation: write_data = incoming_data XOR mem[(wptr + 32) % 64]. Purpose: Enhance entropy quality through continuous churning of fresh randomness with accumulated randomness. Useful for additional conditioning and resistance to entropy source degradation. Default=0 (disabled, direct write without churning).";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } ENTROPY_CHURN_ENABLE[4:4] = 0x0;
    };

    reg FIFO_STATUS {
        desc = "FIFO Status (real-time buffer occupancy and pointers)";
        field {
            sw = r;
            hw = w;
            desc = "Fill Level. Number of valid 32-bit entropy words currently in FIFO (0-64). Poll this field to determine when data is available for reading. LEVEL=0 means FIFO empty, LEVEL=64 means FIFO full.";
        } LEVEL[6:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Write Pointer. Current FIFO write address (0-63). Updated by hardware when entropy data is pushed. Read-only for software.";
        } WPTR[13:8] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Read Pointer. Current FIFO read address (0-63). Updated by hardware when FIFO_RDATA is read. Read-only for software.";
        } RPTR[21:16] = 0x0;
    };

    reg FIFO_RDATA {
        desc = "FIFO Read Data (auto-incrementing read port)";
        field {
            sw = r;
            hw = w;
            onread = ruser;
            desc = "Data read from the FIFO. Reading this register automatically advances the read pointer and decrements FIFO_STATUS.LEVEL by 1. Returns 32-bit entropy word (compressed BIW output or raw generator bytes depending on CTRL.BYPASS_ENTROPY_COMPRESSOR setting). Reading from empty FIFO triggers INTR_STATUS.FIFO_UNDERFLOW and returns undefined data. Always check FIFO_STATUS.LEVEL before reading.";
        } RDATA[31:0] = 0x0;
    };

    reg HEALTH_TEST_CTRL {
        desc = "Health Test Control (NIST SP 800-90B compliant continuous tests)";
        field {
            sw = rw;
            hw = r;
            desc = "Enable bits for health tests [7:0]. Bit allocation: [0]=Repetition Count Test, [1:2]=Reserved, [3]=Adaptive Proportion Test (APT), [4:7]=Markov Test. Set bit to 1 to enable corresponding test. When a test is disabled (bit=0), its internal state (counters, windows) is reset. Tests run on 32-bit entropy stream. Default=0x7 (Repetition, APT, Markov enabled).";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } ENABLE[7:0] = 0x7;
        field {
            sw = rw;
            hw = r;
            desc = "Repetition Count Test threshold. Maximum allowed consecutive repetitions of the same value before test fails. NIST SP 800-90B recommends 15-30 for typical entropy sources. Lower values (5-10) increase sensitivity but may cause false alarms. Higher values (20-40) reduce false alarms but may miss stuck-at faults. Default=25 (covers 32 per-bit counters with <1% false positive rate).";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } REPETITION_LIMIT[15:8] = 25;
    };

    reg HEALTH_TEST_WINDOW_SIZE {
        desc = "Health Test Window Size (sample count per test window)";
        field {
            sw = rw;
            hw = r;
            desc = "Number of samples per health test window. Health tests (APT, Markov) reset their counters every WINDOW_SIZE samples to provide continuous monitoring. Default=2048 samples. Valid range: 256-8192. Smaller windows (256-1024) provide faster failure detection but may increase false positives. Larger windows (4096-8192) reduce noise but delay failure detection. NIST SP 800-90B recommends 512-2048 for typical entropy sources.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SIZE[15:0] = 16'd2048;
    };

    reg MARKOV_TEST_PROB_THRESHOLDS {
        desc = "Markov Test Transition Count Thresholds (16-bit direct count thresholds)";
        field {
            sw = rw;
            hw = r;
            desc = "High transition count threshold (0->1 transitions). Test fails if transition count exceeds this value. For window_size=2048 with good entropy, expect ~1024 transitions. Default=1200 (59% of window, provides 5σ margin above good noise). 16-bit width supports window sizes up to 8192.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } PROB_01_THRESHOLD[15:0] = 1200;
        field {
            sw = rw;
            hw = r;
            desc = "Low transition count threshold (1->0 transitions). Test fails if transition count falls below this value. Detects stuck-at or severely degraded noise (near-zero transitions). Default=100 (5% of window=2048).";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } PROB_10_THRESHOLD[31:16] = 100;
    };

    reg HEALTH_TEST_STATUS {
        desc = "Health Test Status for 32-bit Entropy Stream (Write-1-to-Clear). Latches health test failures until firmware clears by writing 1. Bit allocation: [0]=Repetition, [1:2]=Reserved, [3]=APT, [4]=Markov-Hi, [5]=Markov-Lo, [6:7]=Reserved.";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Health test status bits. Latches on failure, write 1 to clear.";
        } HEALTH_STATUS[7:0] = 0x0;
    };

    reg APT_PATTERN_COUNT_1BIT {
        desc = "Adaptive Proportion Test (APT) high one-count statistics. The single APT instance counts ones independently on each lane of the 32-bit entropy stream over HEALTH_TEST_WINDOW_SIZE.SIZE samples (default 2048). PATTERN_COUNT exposes the maximum current per-lane count. TARGET_PATTERN and SAMPLES_PROCESSED are not implemented and read zero.";
        field {
            sw = r;
            hw = w;
            desc = "Maximum per-lane ones count in the current APT window (apt_test_cnt_hi). The count updates on each valid sample and clears at the window boundary. For good entropy expect approximately half of HEALTH_TEST_WINDOW_SIZE.SIZE.";
        } PATTERN_COUNT[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero. (RTL ties apt_target_pattern_1bit_o to 4'd0.)";
        } TARGET_PATTERN[19:16] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero. (RTL ties apt_samples_processed_1bit_o to 10'd0.)";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_2BIT {
        desc = "Adaptive Proportion Test (APT) low one-count statistics. The single APT instance counts ones independently on each lane of the 32-bit entropy stream over HEALTH_TEST_WINDOW_SIZE.SIZE samples (default 2048). PATTERN_COUNT exposes the minimum current per-lane count. TARGET_PATTERN and SAMPLES_PROCESSED are not implemented and read zero.";
        field {
            sw = r;
            hw = w;
            desc = "Minimum per-lane ones count in the current APT window (apt_test_cnt_lo). The count updates on each valid sample and clears at the window boundary.";
        } PATTERN_COUNT[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero. (RTL ties apt_target_pattern_2bit_o to 4'd0.)";
        } TARGET_PATTERN[19:16] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero. (RTL ties apt_samples_processed_2bit_o to 10'd0.)";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_3BIT {
        desc = "APT 3-bit statistics register. PATTERN_COUNT, TARGET_PATTERN, and SAMPLES_PROCESSED are not implemented and all read zero. (RTL ties apt_pattern_count_3bit_o, apt_target_pattern_3bit_o, and apt_samples_processed_3bit_o to 0.)";
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } PATTERN_COUNT[9:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } TARGET_PATTERN[13:10] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_4BIT {
        desc = "APT 4-bit statistics register. PATTERN_COUNT, TARGET_PATTERN, and SAMPLES_PROCESSED are not implemented and all read zero. (RTL ties apt_pattern_count_4bit_o, apt_target_pattern_4bit_o, and apt_samples_processed_4bit_o to 0.)";
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } PATTERN_COUNT[9:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } TARGET_PATTERN[13:10] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Not implemented. Reads zero.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg REPETITION_TEST_COUNT {
        desc = "Repetition Test Count (current consecutive repetition streak)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of consecutive identical values observed in the 32-bit entropy stream. Increments on each match, resets to 0 on mismatch. Read this register to monitor real-time repetition behavior. Compare to HEALTH_TEST_CTRL.REPETITION_LIMIT (default 15). If count reaches limit, test fails and INTR_STATUS.HEALTH_TEST_FAILED is set. Widened to 16-bit to support full counter range without wrapping.";
        } REPETITION_COUNT[15:0] = 0x0;
    };

    reg APT_PROPORTION_1BIT {
        desc = "Adaptive Proportion Test 1-bit Proportion Limit (16-bit direct count threshold)";
        field {
            sw = rw;
            hw = r;
            desc = "APT high count threshold. Test fails if count of ones exceeds this value. For window_size=2048 with good entropy, expect ~1024 ones per lane. Default=1200 (59% of window, provides 5σ margin above good noise). 16-bit width supports window sizes up to 8192. Both 8-bit and 32-bit health test instances use the same threshold value.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } LIMIT[15:0] = 1200;
    };

    reg APT_PROPORTION_2BIT {
        desc = "Legacy unused APT threshold register. RTL does not consume this register; writes have no effect on APT behavior. The active thresholds are APT_PROPORTION_1BIT and APT_PROPORTION_LO, applied to one APT over the 32-bit entropy stream using HEALTH_TEST_WINDOW_SIZE.SIZE.";
        field {
            sw = rw;
            hw = r;
            desc = "Legacy unused field retained for register compatibility. RTL does not read this value.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } LIMIT[9:0] = 128;
