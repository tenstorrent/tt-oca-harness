    // Watermark test selector enumeration
    enum WATERMARK_TEST {
        REPCNT_HI   = 4'h0 { desc = "Repetition count high watermark"; };
        APT_HI      = 4'h1 { desc = "APT high watermark"; };
        APT_LO      = 4'h2 { desc = "APT low watermark"; };
        MARKOV_HI   = 4'h3 { desc = "Markov high watermark"; };
        MARKOV_LO   = 4'h4 { desc = "Markov low watermark"; };
    };

    // Watermark selector register
    reg HT_WATERMARK_NUM {
        desc = "Health Test Watermark Selector. Selects which health-test counter updates the single shared HT_WATERMARK storage and whether it tracks a maximum or minimum. Writing this selector does not re-arm or clear the shared value, so a selector change alone carries the value recorded by the previous mode. To establish the selected mode's documented baseline, write HT_WATERMARK_NUM first and then pulse CTRL.RESET or toggle CTRL.MODULE_ENABLE from 0 to 1.";
        field {
            sw = rw;
            hw = rw;
            encode = WATERMARK_TEST;
            desc = "Shared watermark source selector. Unsupported values are sanitized to REPCNT_HI. A write changes the source but preserves the current shared value until an arming event or qualifying health-test event.";
        } WATERMARK_NUM[3:0] = 4'h0;
    };

    // Watermark value register
    reg HT_WATERMARK {
        desc = "Health Test Watermark Value. This is one shared storage location for the mode selected by HT_WATERMARK_NUM, not an independent bank per selector. It arms when the entropy source is enabled (MODULE_ENABLE 0 to 1) or on a CTRL.RESET pulse: high modes (REPCNT_HI, APT_HI, MARKOV_HI) arm to 0x0000 and hold the running maximum; low modes (APT_LO, MARKOV_LO) arm to 0xFFFF and hold the running minimum. HT_WATERMARK_NUM persists across CTRL.RESET so the clear uses the selected mode. Changing only HT_WATERMARK_NUM does not re-arm the storage and intentionally carries the previous mode's value. Software must select the mode before an arming event when a deterministic baseline is required. The all-zero reset value shown below is the raw power-on default before the automatic MODULE_ENABLE pulse performs the first mode-aware arm.";
        field {
            sw = r;
            hw = w;
            desc = "Current value in the shared selector-dependent watermark storage.";
        } WATERMARK_VALUE[15:0] = 16'h0;
    };

    // Repetition Test Total Fail Counter
    reg REPCNT_TOTAL_FAILS {
        desc = "Repetition Count Test Total Failures. Counts the total number of test failures since module enable. Increments at health_test_done_pulse when threshold is exceeded. Cleared on health_test_clr.";
        field {
            sw = r;
            hw = w;
            desc = "Total repetition test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // APT High Total Fail Counter
    reg APT_HI_TOTAL_FAILS {
        desc = "Adaptive Proportion Test High Threshold Total Failures. Counts the total number of APT high test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total APT high test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // APT Low Total Fail Counter
    reg APT_LO_TOTAL_FAILS {
        desc = "Adaptive Proportion Test Low Threshold Total Failures. Counts the total number of APT low test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total APT low test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Markov High Total Fail Counter
    reg MARKOV_HI_TOTAL_FAILS {
        desc = "Markov Test High Threshold Total Failures. Counts the total number of Markov high test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total Markov high test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Markov Low Total Fail Counter
    reg MARKOV_LO_TOTAL_FAILS {
        desc = "Markov Test Low Threshold Total Failures. Counts the total number of Markov low test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total Markov low test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Alert Summary Fail Counter
    reg ALERT_SUMMARY_FAIL_COUNTS {
        desc = "Alert Summary Fail Counter. Counts the number of health test windows that had any failure. Clears automatically after passing window.";
        field {
            sw = r;
            hw = w;
            desc = "Number of windows with any failure";
        } ANY_FAIL_COUNT[15:0] = 16'h0;
    };

    // Alert Per-Test Fail Counters
    reg ALERT_FAIL_COUNTS {
        desc = "Alert Per-Test Fail Counters. 4-bit counters tracking failures in current alert window. Auto-clears after passing window.";
        field {
            sw = r;
            hw = w;
            desc = "APT low test alert failures (4-bit, saturates at 15)";
        } APT_LO_FAIL_COUNT[3:0] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "APT high test alert failures (4-bit, saturates at 15)";
        } APT_HI_FAIL_COUNT[7:4] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Markov low test alert failures (4-bit, saturates at 15)";
        } MARKOV_LO_FAIL_COUNT[11:8] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Markov high test alert failures (4-bit, saturates at 15)";
        } MARKOV_HI_FAIL_COUNT[15:12] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Repetition test alert failures (4-bit, saturates at 15)";
        } REPCNT_FAIL_COUNT[19:16] = 4'h0;
    };

    //=========================================================================
    // FIPS 140-3 / SP 800-90B certification support registers
    //=========================================================================

    // FIPS configuration lock. Write-1-only latch; once set it can only be
    // cleared by reset (no debug-unlock path). While LOCK=1, every field marked
    // swwel=true (the certified-configuration inventory: CTRL functional bits,
    // health-test thresholds/window, ring-oscillator geometry, decorrelator
    // config, entropy churn) ignores software writes. This freezes the
    // SP 800-90B validated configuration for the operational lifetime so the
    // entropy-source behaviour cannot silently change after firmware hands off.
    reg FIPS_LOCK {
        desc = "FIPS configuration lock (write-1-only, cleared only by reset). When LOCK=1, all certified-configuration fields (CTRL functional bits, health-test thresholds/window, ring-oscillator enable/tune/select, per-generator sample clock dividers, decorrelator config, FIFO_CTRL.ENTROPY_CHURN_ENABLE) become read-only to software until the next reset. There is intentionally no debug-unlock path. Firmware sets this once, after programming the validated configuration, to enter FIPS operational mode.";
        field {
            sw = rw;
            hw = r;
            onwrite = woset;   // write-1-only: 1 sets, 0 has no effect
            desc = "FIPS configuration lock. Write 1 to lock the certified configuration. Cleared only by reset. Read returns current lock state (1=locked). Drives the swwel enable on every certified-config field and gates the SIZE>=1024 assertion.";
        } LOCK[0:0] = 0x0;
    };

    // Alert threshold: number of consecutive/aggregate failing health-test
    // windows that must accumulate before main_sm's alert_thresh_fail_i fires.
    // Locked under FIPS so the persistent-failure trip point is fixed.
    reg ALERT_THRESHOLD {
        desc = "Health-test alert threshold. When ALERT_SUMMARY_FAIL_COUNTS.ANY_FAIL_COUNT reaches this value, main_sm.alert_thresh_fail_i is asserted, tripping the persistent-failure path (MAIN_SM_STATUS.ALERT / INTR_STATUS.PERSISTENT_FAILURE). Default=4 windows. Locked by FIPS_LOCK.LOCK.";
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified persistent-failure trip point.
            desc = "Consecutive/aggregate failing-window count that trips the persistent-failure alert. 0 disables the threshold trip (alert path never fires from this source). Default=4.";
        } THRESHOLD[15:0] = 16'd4;
    };

    // Assessed per-sample min-entropy H used to derive recommended health-test
    // limits. Q4.4 unsigned fixed point: integer bits [7:4], fraction
    // [3:0]; e.g. 0x0C = 0.75 bits/sample. Locked under FIPS.
    reg MIN_ENTROPY_H {
        desc = "Assessed per-sample min-entropy H (SP 800-90B), Q4.4 unsigned fixed-point (integer [7:4].fraction [3:0]). Feeds the RECOMMENDED_THRESHOLDS combinational lookup that derives RCT/APT limits. Example: 0x0C = 0.75 bits/sample. Locked by FIPS_LOCK.LOCK so the assessed entropy cannot be altered mid-operation.";
        field {
            sw = rw;
            hw = r;
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified assessed min-entropy.
            desc = "Per-sample min-entropy H in Q4.4 unsigned fixed-point. Default=0x0C (0.75 bits/sample).";
        } H[7:0] = 8'h0C;
    };

    // Recommended RCT/APT cutoffs derived combinationally from MIN_ENTROPY_H
    // per SP 800-90B. Read-only: hardware computes, firmware may copy the
    // recommendation into HEALTH_TEST_CTRL.REPETITION_LIMIT / APT_PROPORTION_*
    // before locking. Purely advisory; does not gate the datapath itself.
    reg RECOMMENDED_THRESHOLDS {
        desc = "SP 800-90B recommended health-test cutoffs derived combinationally from MIN_ENTROPY_H. Read-only. Firmware reads these and programs HEALTH_TEST_CTRL.REPETITION_LIMIT and APT_PROPORTION_* accordingly before setting FIPS_LOCK. Advisory only.";
        field {
            sw = r;
            hw = w;
            desc = "Recommended Repetition Count Test cutoff C = 1 + ceil(20 / H) (SP 800-90B 4.4.1, alpha=2^-20).";
        } RCT_LIMIT[15:0] = 16'h0;
        field {
            sw = r;
            hw = w;
            desc = "Recommended Adaptive Proportion Test cutoff for the 1-bit window (SP 800-90B 4.4.2, Table derived from H and W=1024).";
        } APT_LIMIT[31:16] = 16'h0;
    };

    // Post-BIW extracted-stream diagnostic observe tap. Enables a copy-only
    // fan-out of the post-BIW, pre-SHA 32-bit entropy stream into a dedicated
    // observe FIFO, without disturbing the main datapath. NOTE: this is the
    // EXTRACTED (conditioned) stream, downstream of the decorrelator and the
    // BIW GF(2^8) extractor - it is a diagnostic/health-monitor tap and is NOT
    // the SP 800-90B raw noise source. The raw per-lane source is NOISE_OBS_*.
    reg BIW_OBS_CTRL {
        desc = "Post-BIW extracted-stream diagnostic observe control. Enables a copy-only fan-out of the post-BIW, pre-SHA entropy stream into the BIW observe FIFO. The main entropy datapath is unaffected (copy only). Gated by boot_phase_done. This is the conditioned/extracted stream (NOT the SP 800-90B raw source; see NOISE_OBS_* for raw per-lane noise).";
        field {
            sw = rw;
            hw = r;
            desc = "Enable post-BIW capture into the BIW observe FIFO. When 1 (and MAIN_SM_STATUS.BOOT_PHASE_DONE=1), each post-BIW entropy word is copied into the observe FIFO. Default=0. Stays writable under FIPS_LOCK so observation can be toggled during certified operation: this copy-only diagnostic tap leaves the certified output path unchanged.";
        } RAW_ENABLE[0:0] = 0x0;
    };

    reg BIW_OBS_STATUS {
        desc = "Post-BIW observe FIFO status (mirrors FIFO_STATUS layout).";
        field {
            sw = r;
            hw = w;
            desc = "Fill level. Number of 32-bit words currently held in the BIW observe FIFO (0-64).";
        } LEVEL[6:0] = 7'h0;
        field {
            sw = r;
            hw = w;
            desc = "Write pointer. Current BIW observe FIFO write address (0-63). Updated by hardware when a post-BIW word is pushed. Read-only.";
        } WPTR[13:8] = 6'h0;
        field {
            sw = r;
            hw = w;
            desc = "Read pointer. Current BIW observe FIFO read address (0-63). Updated by hardware when BIW_OBS_RDATA is read. Read-only.";
        } RPTR[21:16] = 6'h0;
    };

    // External read-data register: reading pops one word from the BIW observe
    // FIFO (same auto-advancing read-port pattern as FIFO_RDATA).
    reg BIW_OBS_RDATA {
        desc = "Post-BIW observe FIFO read data (auto-advancing read port). Reading this register pops one 32-bit word from the BIW observe FIFO and decrements BIW_OBS_STATUS.LEVEL. Returns 0/undefined when empty.";
        field {
            sw = r;
            hw = w;
            onread = ruser;
            desc = "Popped post-BIW word (extracted, pre-SHA entropy stream). Reading advances the BIW observe FIFO read pointer.";
        } RDATA[31:0] = 32'h0;
    };

    // GetNoise raw per-lane noise observation control. Selects one lane's
    // PRE-decorrelator raw metastable sample (noise_bit_monitor[LANE_SEL]),
    // packs one bit per lane sample-clock edge into 32-bit words, and copies
    // them into a dedicated observe FIFO. This is the SP 800-90B raw noise
    // source (before any decorrelation/extraction) used for per-lane min-
    // entropy estimation. Copy-only: the main datapath is unaffected.
    reg NOISE_OBS_CTRL {
        desc = "Raw per-lane noise observation control (GetNoise). Selects one lane's pre-decorrelator raw sample stream and packs it into the raw-noise observe FIFO for SP 800-90B per-lane raw entropy collection. Copy-only; the main entropy datapath is unaffected. Gated by RAW_ENABLE only (available during startup so it can be used to set health-test thresholds).";
        field {
            sw = rw;
            hw = r;
            desc = "Enable raw per-lane noise capture into the raw-noise observe FIFO. When 1, the selected lane's pre-decorrelator sample bit is captured once per lane sample-clock edge and packed (LSB-first) into 32-bit words. Default=0. Stays writable under FIPS_LOCK: this copy-only diagnostic tap leaves the certified output path unchanged.";
        } RAW_ENABLE[0:0] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Flush the raw-noise observe FIFO. Write 1 to discard all buffered raw words (e.g. after reconfiguring the lane sample rate) so a subsequent read starts from a clean, current-lane-only buffer. Self-clearing. The FIFO is also auto-flushed by hardware whenever LANE_SEL changes, so a lane switch never requires draining stale words.";
        } FLUSH[1:1] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Lane select. Chooses which generator lane (0-11) supplies the pre-decorrelator raw sample stream. Values >=12 are treated as lane 0 by hardware. Changing LANE_SEL restarts the current word packer and auto-flushes the observe FIFO so words never mix samples from two lanes and LEVEL only ever counts current-lane words. Default=0.";
        } LANE_SEL[7:4] = 4'h0;
    };

    reg NOISE_OBS_STATUS {
        desc = "Raw per-lane noise observe FIFO status (mirrors FIFO_STATUS layout).";
        field {
            sw = r;
            hw = w;
            desc = "Fill level. Number of 32-bit words currently held in the raw-noise observe FIFO (0-64).";
        } LEVEL[6:0] = 7'h0;
        field {
            sw = r;
            hw = w;
            desc = "Write pointer. Current raw-noise observe FIFO write address (0-63). Updated by hardware when a packed raw word is pushed. Read-only.";
        } WPTR[13:8] = 6'h0;
        field {
            sw = r;
            hw = w;
            desc = "Read pointer. Current raw-noise observe FIFO read address (0-63). Updated by hardware when NOISE_OBS_RDATA is read. Read-only.";
        } RPTR[21:16] = 6'h0;
    };

    // External read-data register: reading pops one word from the raw-noise
    // observe FIFO (same auto-advancing read-port pattern as FIFO_RDATA).
    reg NOISE_OBS_RDATA {
        desc = "Raw per-lane noise observe FIFO read data (auto-advancing read port). Reading this register pops one 32-bit packed raw word from the raw-noise observe FIFO and decrements NOISE_OBS_STATUS.LEVEL. Returns 0/undefined when empty.";
        field {
            sw = r;
            hw = w;
            onread = ruser;
            desc = "Popped raw-noise word: 32 packed pre-decorrelator samples from the selected lane (SP 800-90B raw source), LSB-first. Reading advances the raw-noise observe FIFO read pointer.";
        } RDATA[31:0] = 32'h0;
    };

             COMPONENT_ID                   COMPONENT_ID                       @0x0;
             CTRL                           CTRL                               @0x4;
             STATUS                         STATUS                             @0x8;
             SHA256_STATUS                  SHA256_STATUS                      @0x1C;
             DEBUG_CTRL                     DEBUG_CTRL                         @0xC;
             INTR_STATUS                    INTR_STATUS                        @0x10;
             INTR_ENABLE                    INTR_ENABLE                        @0x14;
             INTR_TEST                      INTR_TEST                          @0x18;
             FIFO_CTRL                      FIFO_CTRL                          @0x20;
             FIFO_STATUS                    FIFO_STATUS                        @0x24;
    external FIFO_RDATA                     FIFO_RDATA                         @0x28;
             HEALTH_TEST_CTRL               HEALTH_TEST_CTRL                   @0x30;
             HEALTH_TEST_WINDOW_SIZE        HEALTH_TEST_WINDOW_SIZE            @0x34;
             MARKOV_TEST_PROB_THRESHOLDS    MARKOV_TEST_PROB_THRESHOLDS        @0x38;
             HEALTH_TEST_STATUS             HEALTH_TEST_STATUS                 @0x40;
             REPETITION_TEST_COUNT          REPETITION_TEST_COUNT              @0x44;
             APT_PATTERN_COUNT_1BIT         APT_PATTERN_COUNT_1BIT             @0x50;
             APT_PATTERN_COUNT_2BIT         APT_PATTERN_COUNT_2BIT             @0x54;
             APT_PATTERN_COUNT_3BIT         APT_PATTERN_COUNT_3BIT             @0x58;
             APT_PATTERN_COUNT_4BIT         APT_PATTERN_COUNT_4BIT             @0x5C;
             APT_PROPORTION_1BIT            APT_PROPORTION_1BIT                @0x60;
             APT_PROPORTION_2BIT            APT_PROPORTION_2BIT                @0x64;
             APT_PROPORTION_3BIT            APT_PROPORTION_3BIT                @0x68;
             APT_PROPORTION_4BIT            APT_PROPORTION_4BIT                @0x6C;
             APT_PROPORTION_LO             APT_PROPORTION_LO                  @0x70;
             MARKOV_TEST_COUNTS_0           MARKOV_TEST_COUNTS_0               @0x80;
             MARKOV_TEST_COUNTS_1           MARKOV_TEST_COUNTS_1               @0x84;
             MARKOV_TEST_PROBABILITIES      MARKOV_TEST_PROBABILITIES          @0x88;
             // Individual Generator Health Test Status Registers at 0xC0 - 0xF0
             RING_OSC_ENABLE                RING_OSC_ENABLE                    @0x90;
             RING_OSC_TUNE                  RING_OSC_TUNE                      @0x94;
             RING_OSC_CTRL                  RING_OSC_CTRL                      @0x98;
             DECORRELATOR_CTRL              DECORRELATOR_CTRL                  @0xA0;
             DECORRELATOR_MASK              DECORRELATOR_MASK                  @0xA4;
             MAIN_SM_STATUS                 MAIN_SM_STATUS                     @0xB4;
             GENERATOR_0_HEALTH_STATUS      GENERATOR_0_HEALTH_STATUS          @0xC0;
             GENERATOR_1_HEALTH_STATUS      GENERATOR_1_HEALTH_STATUS          @0xC4;
             GENERATOR_2_HEALTH_STATUS      GENERATOR_2_HEALTH_STATUS          @0xC8;
             GENERATOR_3_HEALTH_STATUS      GENERATOR_3_HEALTH_STATUS          @0xCC;
             GENERATOR_4_HEALTH_STATUS      GENERATOR_4_HEALTH_STATUS          @0xD0;
             GENERATOR_5_HEALTH_STATUS      GENERATOR_5_HEALTH_STATUS          @0xD4;
             GENERATOR_6_HEALTH_STATUS      GENERATOR_6_HEALTH_STATUS          @0xD8;
             GENERATOR_7_HEALTH_STATUS      GENERATOR_7_HEALTH_STATUS          @0xDC;
             GENERATOR_8_HEALTH_STATUS      GENERATOR_8_HEALTH_STATUS          @0xE0;
             GENERATOR_9_HEALTH_STATUS      GENERATOR_9_HEALTH_STATUS          @0xE4;
             GENERATOR_10_HEALTH_STATUS     GENERATOR_10_HEALTH_STATUS         @0xE8;
             GENERATOR_11_HEALTH_STATUS     GENERATOR_11_HEALTH_STATUS         @0xEC;
             GENERATOR_0_SAMPLE_CLK_CONFIG  GENERATOR_0_SAMPLE_CLK_CONFIG      @0x100;
             GENERATOR_1_SAMPLE_CLK_CONFIG  GENERATOR_1_SAMPLE_CLK_CONFIG      @0x104;
             GENERATOR_2_SAMPLE_CLK_CONFIG  GENERATOR_2_SAMPLE_CLK_CONFIG      @0x108;
             GENERATOR_3_SAMPLE_CLK_CONFIG  GENERATOR_3_SAMPLE_CLK_CONFIG      @0x10C;
             GENERATOR_4_SAMPLE_CLK_CONFIG  GENERATOR_4_SAMPLE_CLK_CONFIG      @0x110;
             GENERATOR_5_SAMPLE_CLK_CONFIG  GENERATOR_5_SAMPLE_CLK_CONFIG      @0x114;
             GENERATOR_6_SAMPLE_CLK_CONFIG  GENERATOR_6_SAMPLE_CLK_CONFIG      @0x118;
             GENERATOR_7_SAMPLE_CLK_CONFIG  GENERATOR_7_SAMPLE_CLK_CONFIG      @0x11C;
             GENERATOR_8_SAMPLE_CLK_CONFIG  GENERATOR_8_SAMPLE_CLK_CONFIG      @0x120;
             GENERATOR_9_SAMPLE_CLK_CONFIG  GENERATOR_9_SAMPLE_CLK_CONFIG      @0x124;
             GENERATOR_10_SAMPLE_CLK_CONFIG GENERATOR_10_SAMPLE_CLK_CONFIG     @0x128;
             GENERATOR_11_SAMPLE_CLK_CONFIG GENERATOR_11_SAMPLE_CLK_CONFIG     @0x12C;

             // Watermark Registers
             HT_WATERMARK_NUM               HT_WATERMARK_NUM                   @0x130;
             HT_WATERMARK                   HT_WATERMARK                       @0x134;

             // Total Fail Counters
             REPCNT_TOTAL_FAILS             REPCNT_TOTAL_FAILS                 @0x138;
             APT_HI_TOTAL_FAILS             APT_HI_TOTAL_FAILS                 @0x13C;
             APT_LO_TOTAL_FAILS             APT_LO_TOTAL_FAILS                 @0x140;
             MARKOV_HI_TOTAL_FAILS          MARKOV_HI_TOTAL_FAILS              @0x144;
             MARKOV_LO_TOTAL_FAILS          MARKOV_LO_TOTAL_FAILS              @0x148;

             // Alert Fail Counters
             ALERT_SUMMARY_FAIL_COUNTS      ALERT_SUMMARY_FAIL_COUNTS          @0x14C;
             ALERT_FAIL_COUNTS              ALERT_FAIL_COUNTS                  @0x150;

             // FIPS 140-3 / SP 800-90B certification support registers
             FIPS_LOCK                      FIPS_LOCK                          @0x154;
             ALERT_THRESHOLD                ALERT_THRESHOLD                    @0x158;
             MIN_ENTROPY_H                  MIN_ENTROPY_H                      @0x15C;
             RECOMMENDED_THRESHOLDS         RECOMMENDED_THRESHOLDS             @0x160;
             BIW_OBS_CTRL                   BIW_OBS_CTRL                       @0x164;
             BIW_OBS_STATUS                 BIW_OBS_STATUS                     @0x168;
    external BIW_OBS_RDATA                  BIW_OBS_RDATA                      @0x16C;
             NOISE_OBS_CTRL                 NOISE_OBS_CTRL                     @0x170;
             NOISE_OBS_STATUS               NOISE_OBS_STATUS                   @0x174;
    external NOISE_OBS_RDATA                NOISE_OBS_RDATA                    @0x178;

    // TODO: Uncomment after PeakRDL bug fix
    // TODO // INTR_STATUS.HEALTH_TEST_FAILED->hwenable = INTR_ENABLE.HEALTH_TEST_FAILED;
    // TODO // INTR_STATUS.FIFO_ERROR        ->hwenable = INTR_ENABLE.FIFO_ERROR;
    // TODO // INTR_STATUS.FIFO_OVERFLOW     ->hwenable = INTR_ENABLE.FIFO_OVERFLOW;
    // TODO // INTR_STATUS.FIFO_UNDERFLOW    ->hwenable = INTR_ENABLE.FIFO_UNDERFLOW;

};

`endif
