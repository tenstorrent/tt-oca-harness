`ifndef ENTROPY_SOURCE_RDL
`define ENTROPY_SOURCE_RDL

//------------------------------------------------------------------------------
// Copyright 2025 Tenstorrent Inc.
// Entropy Source Configuration and Status Registers
//------------------------------------------------------------------------------

addrmap entropy_source {
    name = "Entropy Source Address Map";
    desc = "Configuration and status registers for the entropy source";
    reg COMPONENT_ID {
        desc = "Component Identification";
        field {
            sw = r;
            hw = na;
            desc = "Entropy Source";
        } NAME[15:0] = 0x0001;
        field {
            sw = r;
            hw = na;
            desc = "Minor Version";
        } MINOR_VERSION[27:24] = 0x1;
        field {
            sw = r;
            hw = na;
            desc = "Major Version";
        } MAJOR_VERSION[31:28] = 0x0;
    };

    reg CTRL {
        desc = "Entropy Source Control";
        field {
            sw = rw;
            hw = r;
            desc = "Software controlled reset when asserted high. Resets all internal state including health test counters, FIFO pointers, and decorrelator shift registers. Ring oscillators continue running. Self-clearing after 1 clock cycle.";
        } RESET[0:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Enable automatic detuning of individual ring oscillator noise generators when corresponding per-generator health tests fail. When enabled, a failing health test causes the generator's noise RO to switch to its detuned (higher frequency) tap point. The shared sampling RO also detunes if ANY generator requests it. Automatic detuning is disabled by default (manual tuning via RING_OSC_TUNE required).";
        } AUTOTUNE_ENABLE[4:4] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Bypass Entropy Compressor (BIW extractor) when asserted high. When bypassed, all 96 bytes from the 12 generators (8 bytes each) are pushed directly into the FIFO without compression, increasing FIFO fill rate by 3x (96 bytes vs 32 bits per cycle). Used for raw entropy analysis and testing. Disabled by default (32-bit compressed output).";
        } BYPASS_ENTROPY_COMPRESSOR[8:8] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Downsample Rate for the decorrelator output. Specifies additional clock cycles to wait between entropy byte outputs. Value of N means output every (N+1) cycles. Applied after DECORRELATOR_CTRL.SAMPLE_CLK_DIV. Example: if SAMPLE_CLK_DIV=63 (div64) and DOWNSAMPLE_RATE=3, effective rate is div256 (64*(3+1)). Default=0 (no additional downsampling).";
        } DOWNSAMPLE_RATE[25:16] = 0;
        field {
            sw = rw;
            hw = r;
            desc = "Enable SHA-256 whitening stage after BIW compression. When enabled, 16 × 32-bit BIW outputs (512 bits) are accumulated and hashed using SHA-256, producing 8 × 32-bit digest words (256 bits). This provides cryptographic conditioning per NIST SP 800-90B. When disabled, BIW output goes directly to FIFO (passthrough mode). Default=1 (enabled).";
        } SHA256_WHITENING_ENABLE[28:28] = 0x1;
    };

    reg STATUS {
        desc = "Entropy Source Status (currently unused, reserved for future expansion)";
        field {
            sw = r;
            hw = w;
            desc = "Reserved for future use. Always reads 0.";
        } RSVD[0:0] = 0x0;
    };

    reg SHA256_STATUS {
        desc = "SHA-256 Whitening Status";
        field {
            sw = r;
            hw = w;
            desc = "SHA-256 is actively hashing. Set when accumulating input buffer is complete and hash computation is in progress. Cleared when digest output phase completes.";
        } BUSY[0:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 32-bit words accumulated in SHA-256 input buffer (0-15). When this reaches 15 and the next word arrives, hashing begins. Useful for monitoring whitener activity and throughput.";
        } INPUT_COUNT[7:4] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 32-bit digest words remaining to be output (0-7). When hashing completes, 8 words are available for output. This counter decrements as words are consumed by downstream FIFO. 0 indicates all digest words have been output.";
        } OUTPUT_COUNT[10:8] = 3'h0;
    };

    reg DEBUG_CTRL {
        desc = "Debug control to monitor internal entropy noise source signals.";
        field {
            sw = rw;
            hw = r;
            desc = "Select Signal. Selects one of 256 internal signals to route to the external debug monitor pin. Signal mapping: [0-11]: Raw noise bits from generators 0-11 (1 bit per generator). [12-15]: Reserved/padding. [16-27]: Divided sample clocks from generators 0-11 (1 bit per generator). [28-31]: Reserved/padding. [32-63]: Compressed 32-bit entropy stream (BIW extractor output). [64-95]: FIFO input 32-bit entropy stream (pre-FIFO buffering). [96-127]: Reserved/padding. [128-223]: Uncompressed per-generator entropy bytes (96 bits total): Generator 0 byte [135:128], Generator 1 byte [143:136], Generator 2 byte [151:144], Generator 3 byte [159:152], Generator 4 byte [167:160], Generator 5 byte [175:168], Generator 6 byte [183:176], Generator 7 byte [191:184], Generator 8 byte [199:192], Generator 9 byte [207:200], Generator 10 byte [215:208], Generator 11 byte [223:216]. [224-255]: Reserved/padding.";
        } SELECT_SIGNAL[7:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select Frequency Divider for debug monitor output pin. Division ratios: 0=div1 (no division), 1=div2, 2=div4, 3=div8, 4=div16, 5=div32, 6=div64, 7=div128. Used to slow down high-frequency signals for external observation. Default=0 (no division).";
        } SELECT_FREQ_DIV[10:8] = 0x0;
    };

    reg INTR_STATUS {
        desc = "Interrupt Status (write 1 to clear)";
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "Health Test Failed Interrupt. Set when any enabled health test (Repetition, APT, or Markov) fails on the 32-bit entropy stream or any per-generator test fails. Check HEALTH_TEST_STATUS and GENERATOR_*_HEALTH_STATUS for details. Write 1 to clear.";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Error Interrupt. Set on FIFO read/write protocol violations. Write 1 to clear.";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Overflow Interrupt. Set when entropy data is pushed to a full FIFO (32 entries deep). Data is discarded on overflow. Write 1 to clear.";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = rw;
            hw = w;
            level intr;
            woclr;
            desc = "FIFO Underflow Interrupt. Set when software reads from an empty FIFO. Read returns stale/undefined data. Write 1 to clear.";
        } FIFO_UNDERFLOW[12:12] = 0x0;
    };

    reg INTR_ENABLE {
        desc = "Interrupt Enable (individual enable bits for each interrupt source)";
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "Health Test Failed Interrupt Enable. Set to 1 to enable interrupt generation on health test failures. Default=0 (disabled).";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Error Interrupt Enable. Set to 1 to enable interrupt generation on FIFO errors. Default=0 (disabled).";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Overflow Interrupt Enable. Set to 1 to enable interrupt generation on FIFO overflow. Default=0 (disabled).";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = rw;
            hw = r; // TODO: Change to na after PeakRDL bug fix
            desc = "FIFO Underflow Interrupt Enable. Set to 1 to enable interrupt generation on FIFO underflow. Default=0 (disabled).";
        } FIFO_UNDERFLOW[12:12] = 0x0;
    };

    reg INTR_TEST {
        desc = "Interrupt Test (write 1 to manually trigger interrupt for testing)";
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "Health Test Failed Interrupt Test. Write 1 to manually set INTR_STATUS.HEALTH_TEST_FAILED for interrupt handler testing. Self-clearing.";
        } HEALTH_TEST_FAILED[0:0] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Error Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_ERROR for interrupt handler testing. Self-clearing.";
        } FIFO_ERROR[4:4] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Overflow Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_OVERFLOW for interrupt handler testing. Self-clearing.";
        } FIFO_OVERFLOW[8:8] = 0x0;
        field {
            sw = w;
            hw = r;
            singlepulse;
            desc = "FIFO Underflow Interrupt Test. Write 1 to manually set INTR_STATUS.FIFO_UNDERFLOW for interrupt handler testing. Self-clearing.";
        } FIFO_UNDERFLOW[12:12] = 0x0;
    };

    reg FIFO_CTRL {
        desc = "FIFO Control (32-entry x 32-bit entropy collection buffer)";
        field {
            sw = rw;
            hw = r;
            desc = "FIFO write enable control. When enabled (1=default), entropy data flows into FIFO and write pointer updates normally. When disabled (set to 0), write operations are blocked: no entropy pushed, write pointer frozen, data collection paused. IMPORTANT: Read operations remain functional when disabled - software can still drain the FIFO by reading FIFO_RDATA. This allows capturing a snapshot of entropy and reading it out without new data being added. Use case: Stop entropy collection, drain FIFO for analysis, re-enable collection. Default=1 (enabled).";
        } ENABLE[0:0] = 0x1;
        field {
            sw = rw;
            hw = r;
            desc = "Entropy Churning Mode Enable. When asserted high, incoming entropy data is XORed with existing FIFO data located at (write_ptr + DEPTH/2) % DEPTH before being written. This creates a circular feedback churning pattern where new entropy is combined with entropy from halfway around the FIFO buffer (16 entries earlier for DEPTH=32). Churning operation: write_data = incoming_data XOR mem[(wptr + 16) % 32]. Purpose: Enhance entropy quality through continuous churning of fresh randomness with accumulated randomness. Useful for additional conditioning and resistance to entropy source degradation. Default=0 (disabled, direct write without churning).";
        } ENTROPY_CHURN_ENABLE[4:4] = 0x0;
    };

    reg FIFO_STATUS {
        desc = "FIFO Status (real-time buffer occupancy and pointers)";
        field {
            sw = r;
            hw = w;
            desc = "Fill Level. Number of valid 32-bit entropy words currently in FIFO (0-32). Poll this field to determine when data is available for reading. LEVEL=0 means FIFO empty, LEVEL=32 means FIFO full.";
        } LEVEL[6:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Write Pointer. Current FIFO write address (0-31). Updated by hardware when entropy data is pushed. Read-only for software.";
        } WPTR[12:8] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Read Pointer. Current FIFO read address (0-31). Updated by hardware when FIFO_RDATA is read. Read-only for software.";
        } RPTR[20:16] = 0x0;
    };

    reg FIFO_RDATA {
        desc = "FIFO Read Data (auto-incrementing read port)";
        field {
            sw = r;
            hw = w;
            onread = ruser;
            desc = "Data read from the FIFO. Reading this register automatically advances the read pointer and decrements FIFO_STATUS.LEVEL by 1. Returns 32-bit entropy word (compressed BIW output or raw generator bytes depending on CTRL.BYPASS_ENTROPY_COMPRESSOR setting). Reading from empty FIFO triggers INTR_STATUS.FIFO_UNDERFLOW and returns undefined data. Always check FIFO_STATUS.LEVEL before reading.";
        } RDATA[31:0] = 0x0;
    };

    reg HEALTH_TEST_CTRL {
        desc = "Health Test Control (NIST SP 800-90B compliant continuous tests)";
        field {
            sw = rw;
            hw = r;
            desc = "Enable bits for health tests [7:0]. Bit allocation: [0]=Repetition Count Test, [1:2]=Reserved, [3]=Adaptive Proportion Test (APT), [4:7]=Markov Test. Set bit to 1 to enable corresponding test. When a test is disabled (bit=0), its internal state (counters, windows) is reset. Tests run on 32-bit entropy stream. Default=0x7 (Repetition, APT, Markov enabled).";
        } ENABLE[7:0] = 0x7;
        field {
            sw = rw;
            hw = r;
            desc = "Repetition Count Test threshold. Maximum allowed consecutive repetitions of the same value before test fails. NIST SP 800-90B recommends 15-30 for typical entropy sources. Lower values (5-10) increase sensitivity but may cause false alarms. Higher values (20-40) reduce false alarms but may miss stuck-at faults. Default=25 (covers 32 per-bit counters with <1% false positive rate).";
        } REPETITION_LIMIT[15:8] = 25;
    };

    reg HEALTH_TEST_WINDOW_SIZE {
        desc = "Health Test Window Size (sample count per test window)";
        field {
            sw = rw;
            hw = r;
            desc = "Number of samples per health test window. Health tests (APT, Markov) reset their counters every WINDOW_SIZE samples to provide continuous monitoring. Default=2048 samples. Valid range: 256-8192. Smaller windows (256-1024) provide faster failure detection but may increase false positives. Larger windows (4096-8192) reduce noise but delay failure detection. NIST SP 800-90B recommends 512-2048 for typical entropy sources.";
        } SIZE[15:0] = 16'd2048;
    };

    reg MARKOV_TEST_PROB_THRESHOLDS {
        desc = "Markov Test Transition Count Thresholds (16-bit direct count thresholds)";
        field {
            sw = rw;
            hw = r;
            desc = "High transition count threshold (0->1 transitions). Test fails if transition count exceeds this value. For window_size=2048 with good entropy, expect ~1024 transitions. Default=1200 (59% of window, provides 5σ margin above good noise). 16-bit width supports window sizes up to 8192.";
        } PROB_01_THRESHOLD[15:0] = 1200;
        field {
            sw = rw;
            hw = r;
            desc = "Low transition count threshold (1->0 transitions). Test fails if transition count falls below this value. Detects stuck-at or severely degraded noise (near-zero transitions). Default=100 (5% of window=2048).";
        } PROB_10_THRESHOLD[31:16] = 100;
    };

    reg HEALTH_TEST_STATUS {
        desc = "Health Test Status for 32-bit Entropy Stream (Write-1-to-Clear). Latches health test failures until firmware clears by writing 1. Bit allocation: [0]=Repetition, [1:2]=Reserved, [3]=APT, [4]=Markov-Hi, [5]=Markov-Lo, [6:7]=Reserved.";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Health test status bits. Latches on failure, write 1 to clear.";
        } HEALTH_STATUS[7:0] = 0x0;
    };

    reg APT_PATTERN_COUNT_1BIT {
        desc = "Adaptive Proportion Test (APT) 1-bit Pattern Count (real-time statistics)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of the most frequently occurring 1-bit pattern in the sliding 512-sample window. For good entropy, expect ~256 (50% of 512). Values >280 indicate potential bias. Compare to APT_PROPORTION_1BIT.LIMIT. Updates continuously as window slides. Widened to 16-bit to support full counter range.";
        } PATTERN_COUNT[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Current 1-bit target pattern being tracked (0 or 1). Hardware automatically selects the most common pattern. Read to identify which bit value is dominant.";
        } TARGET_PATTERN[19:16] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 1-bit samples processed in current window (0-512). Used for window initialization and wraparound tracking. Pattern count is valid when this reaches 512.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_2BIT {
        desc = "Adaptive Proportion Test (APT) 2-bit Pattern Count (real-time statistics)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of the most frequently occurring 2-bit pattern in the sliding 256-sample window. For good entropy, expect ~64 (25% of 256). Values >75 indicate potential bias. Compare to APT_PROPORTION_2BIT.LIMIT. Updates continuously as window slides. Widened to 16-bit to support full counter range.";
        } PATTERN_COUNT[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Current 2-bit target pattern being tracked (0b00, 0b01, 0b10, or 0b11). Hardware automatically selects the most common pattern. Read to identify which 2-bit value is dominant.";
        } TARGET_PATTERN[19:16] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 2-bit samples processed in current window (0-256). Used for window initialization and wraparound tracking. Pattern count is valid when this reaches 256.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_3BIT {
        desc = "Adaptive Proportion Test (APT) 3-bit Pattern Count (real-time statistics)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of the most frequently occurring 3-bit pattern in the sliding 170-sample window. For good entropy, expect ~21 (12.5% of 170). Values >28 indicate potential bias. Compare to APT_PROPORTION_3BIT.LIMIT. Updates continuously as window slides.";
        } PATTERN_COUNT[9:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Current 3-bit target pattern being tracked (0b000 through 0b111). Hardware automatically selects the most common pattern. Read to identify which 3-bit value is dominant.";
        } TARGET_PATTERN[13:10] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 3-bit samples processed in current window (0-170). Used for window initialization and wraparound tracking. Pattern count is valid when this reaches 170.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg APT_PATTERN_COUNT_4BIT {
        desc = "Adaptive Proportion Test (APT) 4-bit Pattern Count (real-time statistics)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of the most frequently occurring 4-bit pattern in the sliding 128-sample window. For good entropy, expect ~8 (6.25% of 128). Values >12 indicate potential bias. Compare to APT_PROPORTION_4BIT.LIMIT. Updates continuously as window slides.";
        } PATTERN_COUNT[9:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Current 4-bit target pattern being tracked (0x0 through 0xF). Hardware automatically selects the most common pattern. Read to identify which 4-bit value is dominant.";
        } TARGET_PATTERN[13:10] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Number of 4-bit samples processed in current window (0-128). Used for window initialization and wraparound tracking. Pattern count is valid when this reaches 128.";
        } SAMPLES_PROCESSED[29:20] = 0x0;
    };

    reg REPETITION_TEST_COUNT {
        desc = "Repetition Test Count (current consecutive repetition streak)";
        field {
            sw = r;
            hw = w;
            desc = "Current count of consecutive identical values observed in the 32-bit entropy stream. Increments on each match, resets to 0 on mismatch. Read this register to monitor real-time repetition behavior. Compare to HEALTH_TEST_CTRL.REPETITION_LIMIT (default 15). If count reaches limit, test fails and INTR_STATUS.HEALTH_TEST_FAILED is set. Widened to 16-bit to support full counter range without wrapping.";
        } REPETITION_COUNT[15:0] = 0x0;
    };

    reg APT_PROPORTION_1BIT {
        desc = "Adaptive Proportion Test 1-bit Proportion Limit (16-bit direct count threshold)";
        field {
            sw = rw;
            hw = r;
            desc = "APT high count threshold. Test fails if count of ones exceeds this value. For window_size=2048 with good entropy, expect ~1024 ones per lane. Default=1200 (59% of window, provides 5σ margin above good noise). 16-bit width supports window sizes up to 8192. Both 8-bit and 32-bit health test instances use the same threshold value.";
        } LIMIT[15:0] = 1200;
    };

    reg APT_PROPORTION_2BIT {
        desc = "Adaptive Proportion Test 2-bit Proportion Limit (NIST SP 800-90B Window=256)";
        field {
            sw = rw;
            hw = r;
            desc = "APT proportion threshold for 2-bit samples. Maximum allowed count of most common 2-bit pattern in a 256-sample window. For unbiased source, expect ~64 (25%). Default=128 allows up to 50%. Reduce to ~75-85 to detect 2-bit pattern bias. Test fails if pattern count exceeds this limit.";
        } LIMIT[9:0] = 128;
    };

    reg APT_PROPORTION_3BIT {
        desc = "Adaptive Proportion Test 3-bit Proportion Limit (NIST SP 800-90B Window=170)";
        field {
            sw = rw;
            hw = r;
            desc = "APT proportion threshold for 3-bit samples. Maximum allowed count of most common 3-bit pattern in a 170-sample window. For unbiased source, expect ~21 (12.5%). Default=64 allows up to 38%. Reduce to ~28-32 to detect 3-bit pattern bias. Test fails if pattern count exceeds this limit.";
        } LIMIT[9:0] = 64;
    };

    reg APT_PROPORTION_4BIT {
        desc = "Adaptive Proportion Test 4-bit Proportion Limit (NIST SP 800-90B Window=128)";
        field {
            sw = rw;
            hw = r;
            desc = "APT proportion threshold for 4-bit samples. Maximum allowed count of most common 4-bit pattern in a 128-sample window. For unbiased source, expect ~8 (6.25%). Default=32 allows up to 25%. Reduce to ~12-15 to detect 4-bit pattern bias. Test fails if pattern count exceeds this limit.";
        } LIMIT[9:0] = 32;
    };

    reg APT_PROPORTION_LO {
        desc = "Adaptive Proportion Test Low Threshold (two-sided NIST SP 800-90B compliance). Detects low-bias noise where too few 1s are observed per bit lane. The APT counts 1s per bit lane over a health test window; if the minimum count across all lanes falls below this threshold, the test fails (apt_test_fail_lo). For window_size=2048 with good entropy, expect ~1024 ones per lane. Default=848 (41.4% of 2048, symmetric 5-sigma margin below mean, matching the high threshold at 1200=58.6%).";
        field {
            sw = rw;
            hw = r;
            desc = "APT low count threshold. Test fails if the minimum per-bit-lane ones count falls below this value at window wrap. Set to 0 to disable the low-side test. 16-bit width supports window sizes up to 8192.";
        } LIMIT[15:0] = 848;
    };

    reg MARKOV_TEST_COUNTS_0 {
        desc = "Markov Test Counts 0";
        field {
            sw = r;
            hw = w;
            desc = "Count of 0->1 transitions.";
        } COUNT_01[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Count of 1->0 transitions.";
        } COUNT_10[31:16] = 0x0;
    };

    reg MARKOV_TEST_COUNTS_1 {
        desc = "Markov Test Counts 1";
        field {
            sw = r;
            hw = w;
            desc = "Count of 0->0 transitions.";
        } COUNT_00[15:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Count of 1->1 transitions.";
        } COUNT_11[31:16] = 0x0;
    };

    reg MARKOV_TEST_PROBABILITIES {
        desc = "Markov Test Probabilities (legacy register - values are always 0, not implemented in current RTL)";
        field {
            sw = r;
            hw = w;
            desc = "Unused - probability calculation not implemented (no division in RTL). Always reads 0. Use MARKOV_TEST_COUNTS_0.COUNT_01 for raw transition count.";
        } PROB_01[7:0] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Unused - probability calculation not implemented (no division in RTL). Always reads 0. Use MARKOV_TEST_COUNTS_0.COUNT_10 for raw transition count.";
        } PROB_10[15:8] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Unused - not tracked by OpenTitan Markov test. Always reads 0.";
        } PROB_00[23:16] = 0x0;
        field {
            sw = r;
            hw = w;
            desc = "Unused - not tracked by OpenTitan Markov test. Always reads 0.";
        } PROB_11[31:24] = 0x0;
    };

    // Individual Generator Health Test Status Registers (Write-1-to-Clear)
    // Latch health test failures until firmware clears by writing 1.
    // Bit allocation: [0]=Repetition, [1:2]=Reserved, [3]=APT, [4]=Markov-Hi, [5]=Markov-Lo, [6:7]=Reserved.
    reg GENERATOR_0_HEALTH_STATUS {
        desc = "Generator 0 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 0 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_1_HEALTH_STATUS {
        desc = "Generator 1 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 1 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_2_HEALTH_STATUS {
        desc = "Generator 2 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 2 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_3_HEALTH_STATUS {
        desc = "Generator 3 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 3 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_4_HEALTH_STATUS {
        desc = "Generator 4 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 4 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_5_HEALTH_STATUS {
        desc = "Generator 5 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 5 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg GENERATOR_6_HEALTH_STATUS {
        desc = "Generator 6 Health Test Status (Write-1-to-Clear)";
        field {
