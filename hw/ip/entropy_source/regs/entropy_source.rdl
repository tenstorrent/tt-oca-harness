    reg GENERATOR_11_HEALTH_STATUS {
        desc = "Generator 11 Health Test Status (Write-1-to-Clear)";
        field {
            sw = rw;
            hw = w;
            woclr;
            stickybit;
            desc = "Generator 11 health test status. Latches on failure, write 1 to clear.";
        } STATUS[7:0] = 0x0;
    };

    reg RING_OSC_ENABLE {
        desc = "Ring Oscillator Enables (independent on/off control for all 12 generators)";
        field {
            sw = rw;
            hw = r;
            desc = "Enable for each of 12 noise generating ring oscillators (one bit per generator [11:0]). Set bit to 1 to enable oscillator, 0 to disable. Disabling stops entropy generation from that generator. RO lengths: Gen0=5, Gen1=7, Gen2=11, Gen3=13, Gen4=17, Gen5=19, Gen6=6, Gen7=8, Gen8=12, Gen9=14, Gen10=18, Gen11=20 stages. All enabled by default (0xFFF).";
        } ENABLE[11:0] = 0xFFF;
        field {
            sw = rw;
            hw = r;
            desc = "Enable for shared sampling ring oscillator (12 bits, one per generator [23:12]). Shared RO (109 stages) is enabled if ANY bit is set (OR-based control). Setting a bit to 0 disables that generator's use of the shared RO (must use external clock via RING_OSC_CTRL.SAMPLE_CLK_SELECT). All enabled by default (0xFFF). Note: This is not 12 separate ROs, but per-generator enable bits for the single shared RO.";
        } SAMPLE_CLK_ENABLE[23:12] = 0xFFF;
    };

    reg RING_OSC_TUNE {
        desc = "Ring Oscillator Tune Control (frequency adjustment via tap point selection)";
        field {
            sw = rw;
            hw = r;
            desc = "Detune control for each of 12 noise generating ring oscillators (one bit per generator [11:0]). Set bit to 1 to detune (increase frequency by selecting shorter tap point in RO chain). Frequency increase: ~40-67% depending on RO length. Example: Gen0 (5->3 stages) increases from 2.88 GHz to 4.80 GHz. Used for manual tuning when CTRL.AUTOTUNE_ENABLE=0, or automatically set by hardware when AUTOTUNE_ENABLE=1 and health test fails. Default=0x0 (all ROs at normal frequency).";
        } DETUNE[11:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Detune control for shared sampling ring oscillator (12 bits, one per generator [23:12]). Shared RO detunes if ANY bit is set (OR-based control). Detuning changes RO from 109->101 stages, increasing frequency from 264 MHz to 285 MHz (~8% increase). Used to adjust sampling frequency ratio when per-generator health tests indicate issues. Always manual control, independent of CTRL.AUTOTUNE_ENABLE. Default=0x0 (shared RO at normal 109-stage frequency).";
        } SAMPLE_CLK_DETUNE[23:12] = 0x0;
    };

    reg RING_OSC_CTRL {
        desc = "Ring Oscillator Sample Clock Select (per-generator clock source mux)";
        field {
            sw = rw;
            hw = r;
            desc = "Select sample clock source for each of 12 generators (one bit per generator [11:0]). Set bit to 1 to use shared internal sampling ring oscillator (109 stages, 264 MHz), set to 0 to use external sampling clock input (rosc_sample_clk_i port, typically 400 MHz). Shared RO provides area/power savings and consistent sampling across generators. External clock useful for characterization and debug. Each generator's clock is further divided by GENERATOR_*_SAMPLE_CLK_CONFIG.SAMPLE_CLK_DIVIDE (div1 to div32). Default=0xFFF (all generators use internal shared RO).";
        } SAMPLE_CLK_SELECT[11:0] = 0xFFF;
    };

    reg DECORRELATOR_CTRL {
        desc = "Decorrelator Control (LFSR-based entropy conditioning)";
        field {
            sw = rw;
            hw = r;
            desc = "Decorrelator bypass for each of 12 generators (one bit per generator [11:0]). Set bit to 1 to bypass LFSR decorrelator and capture raw noise bits directly. When bypassed, feedback loop is broken and shift register captures raw entropy stream. Useful for raw entropy analysis and NIST test suite validation. Bypass mode recommendation: set SAMPLE_CLK_DIV=7 (div8) to capture one byte every 8 cycles (all raw bits). Normal mode: keep default SAMPLE_CLK_DIV=63 (div64) for LFSR decorrelation. Default=0x0 (all decorrelators enabled).";
        } BYPASS[11:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Sample Clock Divider for decorrelator shift registers. Specifies clock cycles between entropy byte captures. Actual division = value + 1. Examples: 63->div64 (default), 7->div8 (bypass mode), 127->div128 (slow). This controls the byte capture rate from each generator's decorrelator. Higher values increase decorrelation but reduce throughput. Lower values capture more raw bits. Applies to all 12 generators. Default=63 (div64, ~4 kHz byte rate per generator at 264 MHz sampling).";
        } SAMPLE_CLK_DIV[31:12] = 63;
    };

    reg DECORRELATOR_MASK {
        desc = "Decorrelator Mask";
        field {
            sw = rw;
            hw = r;
            desc = "";
        } ENTROPY_BYTE_MASK[7:0] = 0xFF;
    };

    reg STARTUP_CTRL {
        desc = "Startup Control (ring oscillator stabilization delay)";
        field {
            sw = rw;
            hw = r;
            desc = "Startup delay in system clock cycles after power-on reset before entropy collection begins. A 16-bit countdown timer is loaded with this value on reset and decrements each cycle. When counter reaches 0, entropy collection activates. GATED (blocked until delay expires): (1) FIFO writes - no entropy data pushed to collection FIFO, (2) Health test processing - counters frozen, no samples processed, (3) External entropy valid signal (entropy_stream_vld_o) - remains low, (4) Downsample counter - does not advance. NOT GATED (continues running during delay): (1) Ring oscillators - all 12 noise ROs and shared sampling RO oscillate immediately, (2) Entropy generation - raw bits produced from metastable sampling, (3) Decorrelators - LFSR processing continues internally, (4) BIW extractor - compression logic remains active, (5) Synchronizers - clock domain crossing continues. Purpose: Allow ROs to reach thermal/electrical steady-state (frequency settling, jitter stabilization, bias settling, metastability equilibrium). Early transient samples are discarded. Recommended values: 1000-10000 cycles (1-10 uss at 1 GHz) for standard startup, 10000-100000 cycles (10-100 uss at 1 GHz) for high-assurance applications. Set to 0 to disable delay (use with caution - initial entropy may have reduced quality). Default=0 (no startup delay).";
        } DELAY_CYCLES[15:0] = 0x0;
    };

    // Sample Clock Configuration Registers (one per generator)
    // Defaults optimized for approximately 20x frequency ratios with 109-stage shared sampling RO:
    // - Generators 0, 1, 6, 7: div1 (ratios: 21.8x, 15.6x, 18.2x, 13.6x)
    // - Generators 2, 3, 8, 9: div2 (ratios: 19.8x, 16.8x, 18.2x, 15.6x)
    // - Generators 4, 5, 10, 11: div4 (ratios: 25.6x, 22.8x, 24.4x, 21.8x)
    reg GENERATOR_0_SAMPLE_CLK_CONFIG {
        desc = "Generator 0 Sample Clock Configuration";
        field {
            sw = rw;
            hw = r;
            desc = "Sample clock division factor for generator 0. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div1 (ratio: 21.8x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x0;
    };

    reg GENERATOR_1_SAMPLE_CLK_CONFIG {
        desc = "Generator 1 Sample Clock Configuration";
        field {
            sw = rw;
            hw = r;
            desc = "Sample clock division factor for generator 1. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div1 (ratio: 15.6x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x0;
    };

    reg GENERATOR_2_SAMPLE_CLK_CONFIG {
        desc = "Generator 2 Sample Clock Configuration";
        field {
            sw = rw;
            hw = r;
            desc = "Sample clock division factor for generator 2. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div2 (ratio: 19.8x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x1;
    };

    reg GENERATOR_3_SAMPLE_CLK_CONFIG {
        desc = "Generator 3 Sample Clock Configuration";
        field {
            sw = rw;
            hw = r;
            desc = "Sample clock division factor for generator 3. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div2 (ratio: 16.8x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x1;
    };

    reg GENERATOR_4_SAMPLE_CLK_CONFIG {
        desc = "Generator 4 Sample Clock Configuration";
        field {
            sw = rw;
            hw = r;
            desc = "Sample clock division factor for generator 4. Values: 0=div1, 1=div2, 2=div4, 3=div8, 4=div16, 5=div32. Default=div4 (ratio: 25.6x).";
        } SAMPLE_CLK_DIVIDE[4:0] = 0x2;
    };

    reg GENERATOR_5_SAMPLE_CLK_CONFIG {
