        } SAMPLE_CLK_DIVIDE[4:0] = 0x2;
    };

    // Watermark test selector enumeration
    enum WATERMARK_TEST {
        REPCNT_HI   = 4'h0 { desc = "Repetition count high watermark"; };
        APT_HI      = 4'h1 { desc = "APT high watermark"; };
        APT_LO      = 4'h2 { desc = "APT low watermark"; };
        MARKOV_HI   = 4'h3 { desc = "Markov high watermark"; };
        MARKOV_LO   = 4'h4 { desc = "Markov low watermark"; };
    };

    // Watermark selector register
    reg HT_WATERMARK_NUM {
        desc = "Health Test Watermark Selector. Selects which health test watermark to display in HT_WATERMARK register.";
        field {
            sw = rw;
            hw = rw;
            encode = WATERMARK_TEST;
            desc = "Watermark test selector";
        } WATERMARK_NUM[3:0] = 4'h0;
    };

    // Watermark value register
    reg HT_WATERMARK {
        desc = "Health Test Watermark Value. Displays the watermark value for the test selected by HT_WATERMARK_NUM. Low watermarks are initialized to all-1s after enabling entropy source.";
        field {
            sw = r;
            hw = w;
            desc = "Current watermark value for selected test";
        } WATERMARK_VALUE[15:0] = 16'h0;
    };

    // Repetition Test Total Fail Counter
    reg REPCNT_TOTAL_FAILS {
        desc = "Repetition Count Test Total Failures. Counts the total number of test failures since module enable. Increments at health_test_done_pulse when threshold is exceeded. Cleared on health_test_clr.";
        field {
            sw = r;
            hw = w;
            desc = "Total repetition test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // APT High Total Fail Counter
    reg APT_HI_TOTAL_FAILS {
        desc = "Adaptive Proportion Test High Threshold Total Failures. Counts the total number of APT high test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total APT high test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // APT Low Total Fail Counter
    reg APT_LO_TOTAL_FAILS {
        desc = "Adaptive Proportion Test Low Threshold Total Failures. Counts the total number of APT low test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total APT low test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Markov High Total Fail Counter
    reg MARKOV_HI_TOTAL_FAILS {
        desc = "Markov Test High Threshold Total Failures. Counts the total number of Markov high test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total Markov high test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Markov Low Total Fail Counter
    reg MARKOV_LO_TOTAL_FAILS {
        desc = "Markov Test Low Threshold Total Failures. Counts the total number of Markov low test failures since module enable.";
        field {
            sw = r;
            hw = w;
            desc = "Total Markov low test failures";
        } FAIL_COUNT[31:0] = 32'h0;
    };

    // Alert Summary Fail Counter
    reg ALERT_SUMMARY_FAIL_COUNTS {
        desc = "Alert Summary Fail Counter. Counts the number of health test windows that had any failure. Clears automatically after passing window.";
        field {
            sw = r;
            hw = w;
            desc = "Number of windows with any failure";
        } ANY_FAIL_COUNT[15:0] = 16'h0;
    };

    // Alert Per-Test Fail Counters
    reg ALERT_FAIL_COUNTS {
        desc = "Alert Per-Test Fail Counters. 4-bit counters tracking failures in current alert window. Auto-clears after passing window.";
        field {
            sw = r;
            hw = w;
            desc = "APT low test alert failures (4-bit, saturates at 15)";
        } APT_LO_FAIL_COUNT[3:0] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "APT high test alert failures (4-bit, saturates at 15)";
        } APT_HI_FAIL_COUNT[7:4] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Markov low test alert failures (4-bit, saturates at 15)";
        } MARKOV_LO_FAIL_COUNT[11:8] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Markov high test alert failures (4-bit, saturates at 15)";
        } MARKOV_HI_FAIL_COUNT[15:12] = 4'h0;
        field {
            sw = r;
            hw = w;
            desc = "Repetition test alert failures (4-bit, saturates at 15)";
        } REPCNT_FAIL_COUNT[19:16] = 4'h0;
    };

             COMPONENT_ID                   COMPONENT_ID                       @0x0;
             CTRL                           CTRL                               @0x4;
             STATUS                         STATUS                             @0x8;
             SHA256_STATUS                  SHA256_STATUS                      @0x1C;
             DEBUG_CTRL                     DEBUG_CTRL                         @0xC;
             INTR_STATUS                    INTR_STATUS                        @0x10;
             INTR_ENABLE                    INTR_ENABLE                        @0x14;
             INTR_TEST                      INTR_TEST                          @0x18;
             FIFO_CTRL                      FIFO_CTRL                          @0x20;
             FIFO_STATUS                    FIFO_STATUS                        @0x24;
    external FIFO_RDATA                     FIFO_RDATA                         @0x28;
             HEALTH_TEST_CTRL               HEALTH_TEST_CTRL                   @0x30;
             HEALTH_TEST_WINDOW_SIZE        HEALTH_TEST_WINDOW_SIZE            @0x34;
             MARKOV_TEST_PROB_THRESHOLDS    MARKOV_TEST_PROB_THRESHOLDS        @0x38;
             HEALTH_TEST_STATUS             HEALTH_TEST_STATUS                 @0x40;
             REPETITION_TEST_COUNT          REPETITION_TEST_COUNT              @0x44;
             APT_PATTERN_COUNT_1BIT         APT_PATTERN_COUNT_1BIT             @0x50;
             APT_PATTERN_COUNT_2BIT         APT_PATTERN_COUNT_2BIT             @0x54;
             APT_PATTERN_COUNT_3BIT         APT_PATTERN_COUNT_3BIT             @0x58;
             APT_PATTERN_COUNT_4BIT         APT_PATTERN_COUNT_4BIT             @0x5C;
             APT_PROPORTION_1BIT            APT_PROPORTION_1BIT                @0x60;
             APT_PROPORTION_2BIT            APT_PROPORTION_2BIT                @0x64;
             APT_PROPORTION_3BIT            APT_PROPORTION_3BIT                @0x68;
             APT_PROPORTION_4BIT            APT_PROPORTION_4BIT                @0x6C;
             APT_PROPORTION_LO             APT_PROPORTION_LO                  @0x70;
             MARKOV_TEST_COUNTS_0           MARKOV_TEST_COUNTS_0               @0x80;
             MARKOV_TEST_COUNTS_1           MARKOV_TEST_COUNTS_1               @0x84;
             MARKOV_TEST_PROBABILITIES      MARKOV_TEST_PROBABILITIES          @0x88;
             // Individual Generator Health Test Status Registers at 0xC0 - 0xF0
             RING_OSC_ENABLE                RING_OSC_ENABLE                    @0x90;
             RING_OSC_TUNE                  RING_OSC_TUNE                      @0x94;
             RING_OSC_CTRL                  RING_OSC_CTRL                      @0x98;
             DECORRELATOR_CTRL              DECORRELATOR_CTRL                  @0xA0;
             DECORRELATOR_MASK              DECORRELATOR_MASK                  @0xA4;
             STARTUP_CTRL                   STARTUP_CTRL                       @0xB0;
             GENERATOR_0_HEALTH_STATUS      GENERATOR_0_HEALTH_STATUS          @0xC0;
             GENERATOR_1_HEALTH_STATUS      GENERATOR_1_HEALTH_STATUS          @0xC4;
             GENERATOR_2_HEALTH_STATUS      GENERATOR_2_HEALTH_STATUS          @0xC8;
             GENERATOR_3_HEALTH_STATUS      GENERATOR_3_HEALTH_STATUS          @0xCC;
             GENERATOR_4_HEALTH_STATUS      GENERATOR_4_HEALTH_STATUS          @0xD0;
             GENERATOR_5_HEALTH_STATUS      GENERATOR_5_HEALTH_STATUS          @0xD4;
             GENERATOR_6_HEALTH_STATUS      GENERATOR_6_HEALTH_STATUS          @0xD8;
             GENERATOR_7_HEALTH_STATUS      GENERATOR_7_HEALTH_STATUS          @0xDC;
             GENERATOR_8_HEALTH_STATUS      GENERATOR_8_HEALTH_STATUS          @0xE0;
             GENERATOR_9_HEALTH_STATUS      GENERATOR_9_HEALTH_STATUS          @0xE4;
             GENERATOR_10_HEALTH_STATUS     GENERATOR_10_HEALTH_STATUS         @0xE8;
             GENERATOR_11_HEALTH_STATUS     GENERATOR_11_HEALTH_STATUS         @0xEC;
             GENERATOR_0_SAMPLE_CLK_CONFIG  GENERATOR_0_SAMPLE_CLK_CONFIG      @0x100;
             GENERATOR_1_SAMPLE_CLK_CONFIG  GENERATOR_1_SAMPLE_CLK_CONFIG      @0x104;
             GENERATOR_2_SAMPLE_CLK_CONFIG  GENERATOR_2_SAMPLE_CLK_CONFIG      @0x108;
             GENERATOR_3_SAMPLE_CLK_CONFIG  GENERATOR_3_SAMPLE_CLK_CONFIG      @0x10C;
             GENERATOR_4_SAMPLE_CLK_CONFIG  GENERATOR_4_SAMPLE_CLK_CONFIG      @0x110;
             GENERATOR_5_SAMPLE_CLK_CONFIG  GENERATOR_5_SAMPLE_CLK_CONFIG      @0x114;
             GENERATOR_6_SAMPLE_CLK_CONFIG  GENERATOR_6_SAMPLE_CLK_CONFIG      @0x118;
             GENERATOR_7_SAMPLE_CLK_CONFIG  GENERATOR_7_SAMPLE_CLK_CONFIG      @0x11C;
             GENERATOR_8_SAMPLE_CLK_CONFIG  GENERATOR_8_SAMPLE_CLK_CONFIG      @0x120;
             GENERATOR_9_SAMPLE_CLK_CONFIG  GENERATOR_9_SAMPLE_CLK_CONFIG      @0x124;
             GENERATOR_10_SAMPLE_CLK_CONFIG GENERATOR_10_SAMPLE_CLK_CONFIG     @0x128;
             GENERATOR_11_SAMPLE_CLK_CONFIG GENERATOR_11_SAMPLE_CLK_CONFIG     @0x12C;

             // Watermark Registers
             HT_WATERMARK_NUM               HT_WATERMARK_NUM                   @0x130;
             HT_WATERMARK                   HT_WATERMARK                       @0x134;

             // Total Fail Counters
             REPCNT_TOTAL_FAILS             REPCNT_TOTAL_FAILS                 @0x138;
             APT_HI_TOTAL_FAILS             APT_HI_TOTAL_FAILS                 @0x13C;
             APT_LO_TOTAL_FAILS             APT_LO_TOTAL_FAILS                 @0x140;
             MARKOV_HI_TOTAL_FAILS          MARKOV_HI_TOTAL_FAILS              @0x144;
             MARKOV_LO_TOTAL_FAILS          MARKOV_LO_TOTAL_FAILS              @0x148;

             // Alert Fail Counters
             ALERT_SUMMARY_FAIL_COUNTS      ALERT_SUMMARY_FAIL_COUNTS          @0x14C;
             ALERT_FAIL_COUNTS              ALERT_FAIL_COUNTS                  @0x150;

    // TODO: Uncomment after PeakRDL bug fix
    // TODO // INTR_STATUS.HEALTH_TEST_FAILED->hwenable = INTR_ENABLE.HEALTH_TEST_FAILED;
    // TODO // INTR_STATUS.FIFO_ERROR        ->hwenable = INTR_ENABLE.FIFO_ERROR;
    // TODO // INTR_STATUS.FIFO_OVERFLOW     ->hwenable = INTR_ENABLE.FIFO_OVERFLOW;
    // TODO // INTR_STATUS.FIFO_UNDERFLOW    ->hwenable = INTR_ENABLE.FIFO_UNDERFLOW;

};

`endif
