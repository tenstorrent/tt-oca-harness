            sw = rw;
            hw = r;
            desc = "Selects division by 1, 2, 4, 8, 16, or 32. FIPS_LOCK.LOCK prevents software changes.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SAMPLE_CLK_DIVIDE[4:0] = 0x1;
    };

    reg GENERATOR_4_SAMPLE_CLK_CONFIG {
        desc = "Controls generator 4 sample-clock division.";
        field {
            sw = rw;
            hw = r;
            desc = "Selects division by 1, 2, 4, 8, 16, or 32. FIPS_LOCK.LOCK prevents software changes.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SAMPLE_CLK_DIVIDE[4:0] = 0x2;
    };

    reg GENERATOR_5_SAMPLE_CLK_CONFIG {
        desc = "Controls generator 5 sample-clock division.";
        field {
            sw = rw;
            hw = r;
            desc = "Selects division by 1, 2, 4, 8, 16, or 32. FIPS_LOCK.LOCK prevents software changes.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SAMPLE_CLK_DIVIDE[4:0] = 0x2;
    };

    reg GENERATOR_6_SAMPLE_CLK_CONFIG {
        desc = "Controls generator 6 sample-clock division.";
        field {
            sw = rw;
            hw = r;
            desc = "Selects division by 1, 2, 4, 8, 16, or 32. FIPS_LOCK.LOCK prevents software changes.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SAMPLE_CLK_DIVIDE[4:0] = 0x0;
    };

    reg GENERATOR_7_SAMPLE_CLK_CONFIG {
        desc = "Controls generator 7 sample-clock division.";
        field {
            sw = rw;
            hw = r;
            desc = "Selects division by 1, 2, 4, 8, 16, or 32. FIPS_LOCK.LOCK prevents software changes.";
            swwel = true;  // Locked by FIPS_LOCK.LOCK: certified-config field, SW writes ignored while locked (cleared only by reset).
        } SAMPLE_CLK_DIVIDE[4:0] = 0x0;
