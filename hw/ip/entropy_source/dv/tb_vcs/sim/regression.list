################################################################################
# Entropy Source Regression Test List
################################################################################
#
# This file defines which tests to run during regression (./run.sh --regre)
#
# Format:
#   test_module                    - Run ALL testcases in this module
#   test_module::testcase          - Run ONLY this specific testcase
#   # comment                      - Lines starting with # are ignored
#
# Examples:
#   test_smoke                     - Runs all tests in test_smoke.py
#   test_smoke::test_3_5_1_extended_operation_without_failures
#                                  - Runs only test_3_5_1 from test_smoke.py
#
# Usage:
#   ./run.sh --regre              # Run all tests/testcases in this list
#
################################################################################

# Sanity and Basic Tests
test_entropy_sanity

# Decorrelator Mode Tests
test_decorrelator_modes

# FIFO Tests
test_entropy_fifo

# Health Test Suite
test_health_tests

# Debug Monitor Tests
test_debug_monitor

# Register Tests
test_reg_walk

# APB Random Access Tests
#test_apb_random

# Miscellaneous Tests
#test_misc

################################################################################
# End of Regression List
################################################################################
