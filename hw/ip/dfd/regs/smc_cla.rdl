// DFD (CLA + DST + trace sink) MMR map as built by dfd_top_cla_dst_apb with
// NUM_CLA_INST=1, NUM_DST_INST=1, NUM_NTRACE_INST=0, TRACE_SINK_SUPPORT=1,
// NTRACE_SUPPORT=0 -- the parameters smc_dfd_wrap instantiates.
//
// mmrs.sv assigns one 4 KiB MMR block per present unit, in this order, and
// decodes the block from paddr[22:12]:
//
//   +0x0000  DST trace sink   DST_SINK_BLK_IDX = 0
//   +0x1000  Trace funnel     FUNNEL_BLK_IDX   = DST_SINK_EN + NTR_SINK_EN
//   +0x2000  CLA              CLA_START_IDX    = DST_SINK_EN + NTR_SINK_EN + 1
//   +0x3000  DST trace source DST_START_IDX    = CLA_START_IDX + NUM_CLA_INST
//
// NUM_MMR_BLOCKS is therefore 4 and the aperture is 16 KiB. An access inside
// a block that hits no register never asserts pready (apb2mmr.sv), so this
// map must not describe registers the build does not instantiate.
//
// Field geometry comes from vendor/tenstorrent/tt-hw-debug/upstream/rtl/mmr/
// <blk>_mmr_pkg.svh; reset values and the sw/hw write paths come from the
// matching <blk>_mmr.sv. Keep them in step when the vendor drop is bumped.
//
// The exception is HW_OWNED in the generator: a handful of live counters and
// pointers that the block rewrites after every software write. Their RTL is
// shaped like ordinary rw config, so they read as writable here and have to be
// pinned read-only by hand -- smc_register_test flags each one otherwise.

addrmap smc_cla {

    // ---------------------------------------------------------------------
    // DST trace-sink MMRs   (mmrs.sv block 0, DST_SINK_BLK_IDX)
    // ---------------------------------------------------------------------
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
        } Trdstramactive[0:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramenable[1:1] = 0x0;
        field {
            sw = r;
            hw = w;
        } Trdstramempty[3:3] = 0x1;
        field {
            sw = rw;
            hw = rw;
        } Trdstrammode[4:4] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramstoponwrap[8:8] = 0x0;
    } Trdstramcontrol @ 0x0;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = r;
        } Trdstramvermajor[3:0] = 0x1;
        field {
            sw = r;
            hw = r;
        } Trdstramverminor[7:4] = 0x0;
        field {
            sw = r;
            hw = r;
        } Trdstramcomptype[11:8] = 0x9;
        field {
            sw = r;
            hw = r;
        } Trdstramhassram[12:12] = 0x1;
        field {
            sw = r;
            hw = r;
        } Trdstramhassmem[13:13] = 0x1;
        field {
            sw = rw;
            hw = r;
        } Trdstramvendorframelength[27:24] = 0x1;
    } Trdstramimpl @ 0x4;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = r;
        } Rsvd10[1:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramstartlow[31:2] = 0x0;
    } Trdstramstartlow @ 0x10;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
        } Trdstramstarthigh[31:0] = 0x0;
    } Trdstramstarthigh @ 0x14;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = r;
        } Rsvd10[1:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramlimitlow[31:2] = 0x0;
    } Trdstramlimitlow @ 0x18;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
        } Trdstramlimithigh[31:0] = 0x0;
    } Trdstramlimithigh @ 0x1C;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = w;
        } Trdstramwrap[0:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramwplow[31:2] = 0x0;
    } Trdstramwplow @ 0x20;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = w;
        } Trdstramwphigh[31:0] = 0x0;
    } Trdstramwphigh @ 0x24;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = r;
        } Rsvd10[1:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trdstramrplow[31:2] = 0x0;
    } Trdstramrplow @ 0x28;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
        } Trdstramrphigh[31:0] = 0x0;
    } Trdstramrphigh @ 0x2C;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = w;
        } Trdstramdata[31:0] = 0x0;
    } Trdstramdata @ 0x40;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = r;
        } Data[31:0] = 0x0;
    } TrDstSinkScratchLo @ 0xFF8;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = r;
        } Data[31:0] = 0x0;
    } TrDstSinkScratchHi @ 0xFFC;

    // ---------------------------------------------------------------------
    // Trace-funnel MMRs     (mmrs.sv block 1, FUNNEL_BLK_IDX)
    // ---------------------------------------------------------------------
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
        } Trfunnelactive[0:0] = 0x0;
        field {
            sw = rw;
            hw = rw;
        } Trfunnelenable[1:1] = 0x0;
        field {
            sw = r;
            hw = w;
        } Trfunnelempty[3:3] = 0x1;
    } Trfunnelcontrol @ 0x1000;
    reg {
        regwidth = 0x20;

        field {
            sw = r;
            hw = r;
        } Trfunnelvermajor[3:0] = 0x1;
        field {
            sw = r;
            hw = r;
            desc = "e";
        } Trfunnelverminor[7:4] = 0x0;
        field {
            sw = r;
            hw = r;
        } Trfunnelcomptype[11:8] = 0x8;
    } Trfunnelimpl @ 0x1004;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = rw;
            desc = "Bits 7:0 are reserved for N-trace srcs and 15:8 for Dst sources";
        } Trfunneldisinput[15:0] = 0x0;
    } Trfunneldisinput @ 0x1008;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = r;
        } Data[31:0] = 0x0;
    } TrFunnelScratchLo @ 0x1FF8;
    reg {
        regwidth = 0x20;

        field {
            sw = rw;
            hw = r;
        } Data[31:0] = 0x0;
    } TrFunnelScratchHi @ 0x1FFC;

    // ---------------------------------------------------------------------
    // Core Logic Analyzer   (mmrs.sv block 2, CLA_START_IDX)
    // ---------------------------------------------------------------------
    reg {
        desc = "Configure CLA counter0. One of the 4 counters used for counting cycles after a event match, and trigger a action on match.";
        regwidth = 0x40;

        field {
            sw = r;
            hw = w;
        } Counter[15:0] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Target[31:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "When Counter = {upper_target,target} reset to 0.  With this bit set, counter will provide a periodic tick w/ frequency of (target +1) if the action is set to Auto Incr. The periodic tick will continue till Stop Auto Incr or Clear Counter action.";
        } ResetOnTarget[32:32] = 0x0;
        field {
            sw = r;
            hw = w;
        } UpperCounter[47:33] = 0x0;
        field {
            sw = rw;
            hw = r;
        } UpperTarget[62:48] = 0x0;
        field {
            sw = r;
            hw = r;
        } Rsvd[63:63] = 0x0;
    } CDbgClaCounter0Cfg @ 0x2100;
    reg {
        desc = "Configure CLA counter1. One of the 4 counters used for counting cycles after a event match, and trigger a action on match.";
        regwidth = 0x40;

        field {
            sw = r;
            hw = w;
        } Counter[15:0] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Target[31:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "When Counter = {upper_targe,target}, reset to 0.  With this bit set, counter will provide a periodic tick w/ frequency of (target +1) if the action is set to Auto Incr. The periodic tick will continue till Stop Auto Incr or Clear Counter action.";
        } ResetOnTarget[32:32] = 0x0;
        field {
            sw = r;
            hw = w;
        } UpperCounter[47:33] = 0x0;
        field {
            sw = rw;
            hw = r;
        } UpperTarget[62:48] = 0x0;
        field {
            sw = r;
            hw = r;
        } Rsvd[63:63] = 0x0;
    } CDbgClaCounter1Cfg @ 0x2108;
    reg {
        desc = "Configure CLA counter2. One of the 4 counters used for counting cycles after a event match, and trigger a action on match.";
        regwidth = 0x40;

        field {
            sw = r;
            hw = w;
        } Counter[15:0] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Target[31:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "When Counter = {upper_target,target}, reset to 0.  With this bit set, counter will provide a periodic tick w/ frequency of (target +1) if the action is set to Auto Incr. The periodic tick will continue till Stop Auto Incr or Clear Counter action.";
        } ResetOnTarget[32:32] = 0x0;
        field {
            sw = r;
            hw = w;
        } UpperCounter[47:33] = 0x0;
        field {
            sw = rw;
            hw = r;
        } UpperTarget[62:48] = 0x0;
        field {
            sw = r;
            hw = r;
        } Rsvd[63:63] = 0x0;
    } CDbgClaCounter2Cfg @ 0x2110;
    reg {
        desc = "Configure CLA counter3. One of the 4 counters used for counting cycles after a event match, and trigger a action on match.";
        regwidth = 0x40;

        field {
            sw = r;
            hw = w;
        } Counter[15:0] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Target[31:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "When Counter = {upper_target,target}, reset to 0.  With this bit set, counter will provide a periodic tick w/ frequency of (target +1) if the action is set to Auto Incr. The periodic tick will continue till Stop Auto Incr or Clear Counter action.";
        } ResetOnTarget[32:32] = 0x0;
        field {
            sw = r;
            hw = w;
        } UpperCounter[47:33] = 0x0;
        field {
            sw = rw;
            hw = r;
        } UpperTarget[62:48] = 0x0;
        field {
            sw = r;
            hw = r;
        } Rsvd[63:63] = 0x0;
    } CDbgClaCounter3Cfg @ 0x2118;
    reg {
        desc = "CLA Action(s) are tied to events(s) using \\\"event-action pairing\\\" registers. One of he 8 EAPs (Two EAPs per Node).";
        regwidth = 0x40;

        field {
            sw = rw;
            hw = r;
            desc = "Select Destination Node";
        } DestNode[1:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select an Action";
        } Action0[7:2] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select an Action";
        } Action1[13:8] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Relation to be satisfied among events to activate the actions";
        } LogicalOp[15:14] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType0[21:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType1[27:22] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select the bit position of custom action bus to be set when EAP trigger is met. External blocks can define and implement the specific action for a given bit.";
        } CustomAction0[31:28] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select the bit position of custom action bus to be set when EAP trigger is met. External blocks can define and implement the specific action for a given bit.";
        } CustomAction1[35:32] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "custom_action0 is valid only if custom_action0_enable is set";
        } CustomAction0Enable[36:36] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "custom_action1 is valid only if custom_action1_enable is set";
        } CustomAction1Enable[37:37] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType2[43:38] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "User Defined Function with event type 0, 1, and 2 as arguments";
        } Udf[51:44] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Action2[57:52] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Action3[63:58] = 0x0;
    } CDbgNode0Eap0 @ 0x2120;
    reg {
        desc = "CLA Action(s) are tied to events(s) using \\\"event-action pairing\\\" registers. One of he 8 EAPs (Two EAPs per Node).";
        regwidth = 0x40;

        field {
            sw = rw;
            hw = r;
            desc = "Select Destination Node";
        } DestNode[1:0] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select an Action";
        } Action0[7:2] = 0x0;
        field {
