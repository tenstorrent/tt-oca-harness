        } LogicalOp[15:14] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType0[21:16] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType1[27:22] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select the bit position of custom action bus to be set when EAP trigger is met. External blocks can define and implement the specific action for a given bit.";
        } CustomAction0[31:28] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select the bit position of custom action bus to be set when EAP trigger is met. External blocks can define and implement the specific action for a given bit.";
        } CustomAction1[35:32] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "custom_action0 is valid only if custom_action0_enable is set";
        } CustomAction0Enable[36:36] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "custom_action1 is valid only if custom_action1_enable is set";
        } CustomAction1Enable[37:37] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "Select a trigger event";
        } EventType2[43:38] = 0x0;
        field {
            sw = rw;
            hw = r;
            desc = "User Defined Function with event type 0, 1, and 2 as arguments";
        } Udf[51:44] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Action2[57:52] = 0x0;
        field {
            sw = rw;
            hw = r;
        } Action3[63:58] = 0x0;
    } CDbgNode0Eap1 @ 0x2128;
    reg {
        desc = "CLA Action(s) are tied to events(s) using \\\"event-action pairing\\\" registers. One of he 8 EAPs (Two EAPs per Node).";
        regwidth = 0x40;

        field {
