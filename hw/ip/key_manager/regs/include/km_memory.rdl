`ifndef KM_MEMORY_RDL
`define KM_MEMORY_RDL

mem km_rom {
    name = "Key Manager ROM";
    desc = "Key Manager boot ROM";
    mementries = 4096;
    memwidth = 32;
    sw = r;

`ifdef OCAH_DOC_MEMORY_MAP
    ocah_hole_note = "A write completes without an error response, is dropped, and sets IRQ_STATUS.ROM_WRITE_ERR.";
`endif
};

mem km_sram {
    name = "Key Manager SRAM";
    desc = "Key Manager data and executable SRAM";
    mementries = 8192;
    memwidth = 32;
    sw = rw;
};

`endif
