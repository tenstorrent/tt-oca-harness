`ifndef UART_LOG_ENGINE_WRAP_RDL
`define UART_LOG_ENGINE_WRAP_RDL

`include "log_engine.rdl"
`include "uart_16550_main.rdl"
`include "uart_log_engine_ctrl.rdl"

addrmap uart_log_engine_wrap {

    /////////////////
    // Address Map //
    /////////////////

    uart_log_engine_ctrl    uart_log_engine_ctrl    @0x0;
    uart_16550_main         uart                    @0x100;
    log_engine              log_engine              @0x200;

};

`endif
