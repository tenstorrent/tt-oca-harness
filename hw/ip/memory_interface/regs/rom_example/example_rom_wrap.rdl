`ifndef ROM_RDL_DEFINED
`define ROM_RDL_DEFINED

`include "example_rom_macro_csr.rdl"
`include "example_rom.rdl"

addrmap example_rom_wrap {
    name = "Example ROM Wrapper Address Map";
    desc = "Example ROM address map composing the ROM macro and its control and status registers.";

   
   ////////////////////////////////////////////////////////////////////////////
