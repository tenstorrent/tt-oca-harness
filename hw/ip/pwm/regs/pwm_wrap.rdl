`ifndef PWM_WRAP_RDL
`define PWM_WRAP_RDL

`include "pwm.rdl"
`include "pwm_ctrl.rdl"

addrmap pwm_wrap #(
    longint unsigned N_OUTPUTS = 4
) {
    name = "PWM Wrapper Address Map";
    desc = "Wrapper address map instantiating the PWM register block and its pad control.";

    /////////////////
    // Address Map //
    /////////////////

    pwm      #(.N_OUTPUTS(N_OUTPUTS))    pwm         @0x000;
    pwm_ctrl #(.N_OUTPUTS(N_OUTPUTS))    pwm_ctrl    @0x800;

`ifdef OCAH_DOC_MEMORY_MAP
    ocah_gap_resp = ocah_resp'{rresp: ocah_resp_e::DECERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::DECERR};
    // 0x80 is the PWM window for the default N_OUTPUTS, which the SMC uses.
    pwm->ocah_aperture_size = 0x80;
    pwm->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xFFFFFFFF, bresp: ocah_resp_e::SLVERR};
    pwm_ctrl->ocah_aperture_size = 0x8;
    pwm_ctrl->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0x0, bresp: ocah_resp_e::SLVERR};
`endif
};

`endif
