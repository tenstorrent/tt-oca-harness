`ifndef UART_WRAP_RDL
`define UART_WRAP_RDL

`include "uart_log_engine_wrap.rdl"

addrmap uart_wrap #(
    longint unsigned MAX_NUM_UARTS = 4
) {
    name = "UART Wrapper Address Map";
    desc = "Wrapper address map instantiating the per-UART log-engine blocks.";

    /////////////////
    // Address Map //
    /////////////////

    uart_log_engine_wrap    uart_log_engine_wrap[MAX_NUM_UARTS]    @0x0 += 0x400;

};

`endif
