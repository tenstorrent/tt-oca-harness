`ifndef OCA_I3C_WRAP_RDL_DEFINED
`define OCA_I3C_WRAP_RDL_DEFINED

`include "registers.rdl"

addrmap oca_i3c_wrap #(
    longint unsigned NUM_I3CS = 6
) {
    name = "OCA I3C Controller Wrapper Address Map";
    desc = "Wrapper address map instantiating the per-controller I3C CSR blocks.";
    
    /////////////////
    // Address Map //
    /////////////////

    I3CCSR      i3c_csr     [NUM_I3CS]      @0x0    += 0x1000;

};

`endif
