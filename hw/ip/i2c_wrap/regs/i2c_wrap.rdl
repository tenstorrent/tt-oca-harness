`ifndef I2C_WRAP_RDL
`define I2C_WRAP_RDL

`include "i2c.rdl"
`include "i2c_ctrl.rdl"

addrmap i2c_wrap #(
    // TODO: Fix
    // longint unsigned MAX_NUM_I2CS = 7
    longint unsigned NUM_I2CS = 3
) {

    /////////////////
    // Address Map //
    /////////////////

    i2c         i2c           [NUM_I2CS]  @0x0   += 0x200;
    i2c_ctrl    i2c_ctrl_regs             @0xe00;

};

`endif
