//
// Coverage scope of the shared AXI VIP selftest harness, passed to the
// compiler from [coverage.verilator].build_args in ocah_axi_vip_sim_cfg.toml,
// so what it drops never enters the database.
//
// `coverage_off` takes `-file` with globs only; the pattern is matched
// against the path as Verilator opened the file, so it starts with `*` and
// no `/` follows that `*` directly.
//
// Scored: interface/ocah_axi_if.sv, interface/ocah_axi_struct_bridge.sv,
// sva/ocah_axi_sva.sv.

`verilator_config

// The harness body is the test bench, not the collateral under test.
coverage_off -file "*hw/common/dv/vip/ocah_axi_vip/dv/tb/tb_top.sv"

// Vendored pulp packages reached through the struct typedefs are not part of
// the VIP.
coverage_off -file "*vendor/pulp-platform/*"
