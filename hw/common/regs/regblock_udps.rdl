/*
 * Property extensions understood by PeakRDL-Regblock.
 *
 * Compile this file before block-specific SystemRDL sources.
 */

property buffer_reads {
    component = reg;
    type = boolean;
};

property rbuffer_trigger {
    component = reg;
    type = ref;
};

property buffer_writes {
    component = reg;
    type = boolean;
};

property wbuffer_trigger {
    component = reg;
    type = ref;
};

property rd_swacc {
    component = field;
    type = boolean;
};

property wr_swacc {
    component = field;
    type = boolean;
};

property is_signed {
    type = boolean;
    component = field;
    default = true;
};

property intwidth {
    type = longint unsigned;
    component = field;
};

property fracwidth {
    type = longint unsigned;
    component = field;
};

/*
 * OpenTitan UDPs emitted by reggen_wrapper.py when exporting upstream OpenTitan
 * hjson (aes/hmac/kmac/otbn/csrng/edn/...). Defined here so the regenerated RDLs
 * compile without an `include "opentitan_udps.rdl"` (this file is already passed
 * to every peakrdl invocation).
 */

// hwre: true if the register's read latches a hardware read-enable pulse.
property hwre {
    type = boolean;
    component = reg;
    default = false;
};

// shadowed: true if the register is shadowed (guarded against fault injection).
property shadowed {
    type = boolean;
    component = reg;
    default = false;
};
