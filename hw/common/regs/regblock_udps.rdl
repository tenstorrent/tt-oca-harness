/*
 * This file defines several property extensions that are understood by the
 * PeakRDL-Regblock SystemVerilog code generator.
 *
 * Compile this file prior to your other SystemRDL sources.
 *
 * For more details, see: https://peakrdl-regblock.readthedocs.io/en/latest/udps/intro.html
 */

property buffer_reads {
    component = reg;
    type = boolean;
};

property rbuffer_trigger {
    component = reg;
    type = ref;
};

property buffer_writes {
    component = reg;
    type = boolean;
};

property wbuffer_trigger {
    component = reg;
    type = ref;
};

property rd_swacc {
    component = field;
    type = boolean;
};

property wr_swacc {
    component = field;
    type = boolean;
};

property is_signed {
    type = boolean;
    component = field;
    default = true;
};

property intwidth {
    type = longint unsigned;
    component = field;
};

property fracwidth {
    type = longint unsigned;
    component = field;
};

property ocah_aperture_size {
    component = addrmap | regfile | reg | mem;
    type = longint unsigned;
};

property ocah_full_stride_extent {
    component = addrmap | regfile | reg | mem;
    type = boolean;
};

enum ocah_resp_e {
    OKAY = 0;
    SLVERR = 2;
    DECERR = 3;
    ALIAS = 4 { name = "Aliases registers"; };
    FORWARD = 5 { name = "Forwarded"; };
    ADOPTER = 6 { name = "Adopter-defined"; };
};

struct ocah_resp {
    ocah_resp_e rresp;
    longint unsigned rdata;
    ocah_resp_e bresp;
};

property ocah_hole_resp {
    component = addrmap | regfile | mem;
    type = ocah_resp;
};

property ocah_past_extent_resp {
    component = addrmap | regfile | reg | mem;
    type = ocah_resp;
};

property ocah_gap_resp {
    component = addrmap | regfile;
    type = ocah_resp;
};

property ocah_hole_note {
    component = addrmap | regfile | mem;
    type = string;
};

property ocah_past_extent_note {
    component = addrmap | regfile | reg | mem;
    type = string;
};

property ocah_gap_note {
    component = addrmap | regfile;
    type = string;
};

property ocah_following_gap_note {
    component = addrmap | regfile | reg | mem;
    type = string;
};
