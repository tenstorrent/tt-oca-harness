# Local exporters, passed by rules.mk with --peakrdl-cfg:
# - c-header-desc (tools/regs/cheader.py): peakrdl-cheader 1.1.0 emits no RDL
#   `desc` text and has no --template hook. Drop it once the descriptions land
#   upstream.
# - regblock-range (tools/regs/regblock_range.py): regblock with an address error
#   for out-of-range accesses only.

[peakrdl]
# Absolute: the register flow runs peakrdl from the block directory, not the
# repository root, so a relative search path would not resolve. The path is a
# placeholder; rules.mk writes the real file with the checkout's path in it.
python_search_paths = ["@OCAH_ROOT@/tools/regs"]

[peakrdl.plugins.exporters]
c-header-desc = "cheader:Exporter"
regblock-range = "regblock_range:Exporter"
