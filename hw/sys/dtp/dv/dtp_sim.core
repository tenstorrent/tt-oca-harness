CAPI=2:
# SPDX-License-Identifier: Apache-2.0
# Optional FuseSoC/CAPI-2 view of the DTP OSS sim target. The native OSS flow
# (tools/dv/run_dv.py) builds from dtp_sim_cfg.toml [build].bender_targets and
# does NOT parse this file; it exists only for an external FuseSoC consumer.
name: "ocah:dv:dtp_sim:0.1"
description: "DTP OSS cocotb/Verilator simulation target"

filesets:
  files_rtl:
    depend:
      - ocah:subsystem:dtp

  files_dv:
    files:
      - tb/tb_top.sv
      - tb/verilator_stubs/prim_sync2.sv
    file_type: systemVerilogSource

  files_tests:
    files:
      - tests/__init__.py
      - tests/dtp_base_test.py
      - tests/dtp_sanity_test.py
      - tests/dtp_jtag2axi_smc_axi_wr_test.py
      - tests/dtp_jtag2axi_smc_axi_rd_test.py
      - testlists/smoke.toml
    file_type: pythonSource

targets:
  sim: &sim_target
    description: "Build and run the DTP OSS cocotb smoke environment"
    toplevel: dtp_uvm_top
    filesets:
      - files_rtl
      - files_dv
      - files_tests
    default_tool: verilator

  lint:
    <<: *sim_target
    description: "Lint the DTP OSS simulation target"
