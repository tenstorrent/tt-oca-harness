#=======================================================================================================================
# RULE INFO:
#=======================================================================================================================
# PortTypeMismatch-ML: Port type differs from the type of the connected signal
#=======================================================================================================================

#=======================================================================================================================
# Module-name prefix support
#=======================================================================================================================

if { ![info exists PREFIX] } {
    set PREFIX ""
}
# Substitute the literal ${PREFIX} token in a -filter expression with $PREFIX's
# value. Uses string map rather than brace interpolation so that $clog2, bus
# indices like [i], and embedded quotes inside the filter are preserved verbatim.
proc apply_prefix { filter } {
    return [string map [list {${PREFIX}} $::PREFIX] $filter]
}

#=======================================================================================================================
# Ruleset: tt_lint_d0
#=======================================================================================================================

# PortTypeMismatch-ML: smu integration ports whose type parameter, typedef alias or vector type matches the connected signal.
waive_violation -add {SMU_PortTypeMismatch_dtp_param} -comment {The port and the signal connected to it have different type names but are the same type: the instantiated module's type parameter is set to the signal's type. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}smu") AND (HDLModName == "${PREFIX}dtp") AND (((NodeType == "smc_jtag_axi_req_t") AND (NodeType1 == "smc_jtag_56_64_2_12_axi_req_t")) OR ((NodeType == "smc_jtag_axi_resp_t") AND (NodeType1 == "smc_jtag_56_64_2_12_axi_resp_t")) OR ((NodeType == "smc_otp_axil_req_t") AND (NodeType1 == "smc_axil_32_32_req_t")) OR ((NodeType == "smc_otp_axil_resp_t") AND (NodeType1 == "smc_axil_32_32_resp_t")) OR ((NodeType == "sep_otp_axil_req_t") AND (NodeType1 == "smc_axil_32_32_req_t")) OR ((NodeType == "sep_otp_axil_resp_t") AND (NodeType1 == "smc_axil_32_32_resp_t")) OR ((NodeType == "xtrig_axil_req_t") AND (NodeType1 == "smc_axil_32_32_req_t")) OR ((NodeType == "xtrig_axil_resp_t") AND (NodeType1 == "smc_axil_32_32_resp_t")) OR ((NodeType == "ic_reset_sep_t") AND (NodeType1 == "jtag_sep_reset_ctrl_t")) OR ((NodeType == "ic_reset_smc_t") AND (NodeType1 == "jtag_smc_reset_ctrl_t")))}] -app { lint } -tag { PortTypeMismatch-ML } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
