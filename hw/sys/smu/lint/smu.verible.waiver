# Generic testbench top names: each module identifies the driven block.
waive --rule=module-filename --regex="module smu_uvm_top" --location=".*hw/sys/smu/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module smu_wrapper_uvm_top " --location=".*hw/sys/smu/dv/tb/tb_wrapper_top\.sv$"
