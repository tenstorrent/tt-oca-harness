#
# Generic testbench top names: each module identifies the driven block.
waive --rule=module-filename --regex="module smu_uvm_top" --location=".*hw/sys/smu/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module smu_wrapper_uvm_top " --location=".*hw/sys/smu/dv/tb/tb_wrapper_top\.sv$"

# The simulated memory is an associative array. Verilator rejects nonblocking
# assignment to dynamically sized variables, and this model requires the
# merged value to become visible immediately.
waive --rule=always-ff-non-blocking --regex="store\[wr_addr\[AddrWidth-1:3\]\] = wr_merged" --location=".*hw/sys/smu/dv/tb/smu_axi_out_sim_slave\.sv$"
