CAPI=2:
# SPDX-License-Identifier: Apache-2.0
# Optional FuseSoC/CAPI-2 view of the SMU OSS sim target. The native OSS flow
# (tools/dv/run_dv.py) builds from smu_sim_cfg.toml [build].bender_targets and
# does NOT parse this file; it exists only for an external FuseSoC consumer.
name: "ocah:dv:smu_sim:0.1"
description: "SMU OSS cocotb/Verilator simulation target"

filesets:
  files_rtl:
    depend:
      - ocah:subsystem:smu

  files_dv:
    files:
      - tb/tb_top.sv
    file_type: systemVerilogSource

  files_tests:
    files:
      - cocotb/tests/__init__.py
      - testlists/all.toml
    file_type: pythonSource

targets:
  sim: &sim_target
    description: "Build and run the SMU OSS cocotb environment"
    toplevel: smu_uvm_top
    filesets:
      - files_rtl
      - files_dv
      - files_tests
    default_tool: verilator

  lint:
    <<: *sim_target
    description: "Lint the SMU OSS simulation target"
