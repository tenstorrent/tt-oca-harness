//
// VCS coverage scope for the smu wrapper DUT, the `-cm_hier` counterpart of
// ../verilator/smu_wrapper_cov_scope.vlt. VCS scopes by instance tree, so the
// subsystems SMU integrates are named by the instance that contains each of
// them; the Verilator file names the same trees by source path.
//
// Toggle is collected on the ports of smu_wrapper only. An integration level
// owns its interfaces, and a port has toggled when any of its bits has; the
// nets inside the subsystems belong to their own packages.

-tree smu_wrapper_uvm_top 1
-tree smu_wrapper_uvm_top.u_dut.u_smu.u_smc
-tree smu_wrapper_uvm_top.u_dut.u_smu.u_dtp
-tree smu_wrapper_uvm_top.u_dut.u_smu.u_sep
-tree smu_wrapper_uvm_top.u_dut.u_smc_ip_integration
-tree smu_wrapper_uvm_top.u_dut.u_sep_ip_integration

begin tgl(portsonly)
  +tree smu_wrapper_uvm_top.u_dut 0
end
