// functional-coverage monitors (cov/sv): out of the code and toggle metrics,
// kept in the assertion metric for their cover properties
begin line+cond+fsm+branch+tgl
  -module smu_alias_fcov
  -module smu_boot_fcov
  -module smu_clk_fcov
  -module smu_clkstop_fcov
  -module smu_dbg_fcov
  -module smu_dtp_fcov
  -module smu_ext_fcov
  -module smu_lc_fcov
  -module smu_rst_fcov
  -module smu_xbar_fcov
end
