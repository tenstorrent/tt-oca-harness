//
// Coverage scope for the smu wrapper DUT. Passed to Verilator at compile time
// from [coverage.verilator].build_args in smu_sim_cfg.toml, so what it drops
// never enters the coverage database. Edit then `--rebuild`.
//
// The wrapper is graded on its interface: what stays instrumented is
// hw/top/smu_wrapper.sv -- its ports and the nets it declares between them
// -- and the cov/sv functional-coverage modules. SMC, DTP and SEP are
// graded in their own DV packages. The VCS scope
// (`../vcs/smu_wrapper_cov_scope.hier`) is wider: it also grades `smu.sv`,
// its crossbar and the other SMU-owned units under u_smu, and carries
// toggle; ../vcs/README.md, "Two populations", says why the two differ.
//
// GLOB NOTE: the pattern is matched against the path as Verilator OPENED the
// file, not the absolute path it records in the generated code, and
// `+incdir+`-resolved files are opened relative. Never put a `/` straight
// after the leading `*` -- `*vendor/*` matches both forms, `*/vendor/*`
// matches only the absolute one and silently leaves the rest instrumented.
//
// DO NOT add hw/sys/smu/dv/cov/sv/* here. Those files carry the
// OCAH_FCOV_COVER points that populate the `user` metric family.

`verilator_config

// ---------------------------------------------------------------------------
// Testbench code.
// ---------------------------------------------------------------------------
coverage_off -file "*hw/sys/smu/dv/tb/tb_wrapper_top.sv"

// ---------------------------------------------------------------------------
// Internal logic: the SMU block itself, and the subsystems that carry their
// own DV package and their own coverage.
// ---------------------------------------------------------------------------
coverage_off -file "*hw/sys/smu/rtl/*"
coverage_off -file "*hw/sys/smc/*"
coverage_off -file "*hw/sys/dtp/*"
coverage_off -file "*hw/sys/sep/*"
// The SEP and SMC integration shells under hw/top belong to those packages:
// they instantiate the subsystem and its adopter-side collateral, not SMU logic.
coverage_off -file "*hw/top/sep_ip_integration.sv"
coverage_off -file "*hw/top/smc_ip_integration.sv"

// ---------------------------------------------------------------------------
// Third-party and generated RTL, and the IP blocks the subsystems integrate.
// ---------------------------------------------------------------------------
coverage_off -file "*vendor/*"
coverage_off -file "*chipyard_generated_files/*"
coverage_off -file "*hw/ip/*"
coverage_off -file "*hw/common/*"
