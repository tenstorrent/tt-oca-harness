// Leaves reach into the design hierarchically, and this scope decides how
// far: the bench top, smu_wrapper, smu and the SMC and DTP modules the
// leaves observe.

`verilator_config
public_flat_rw -module "smu_wrapper_uvm_top" -var "*"
// The shared AXI VIP interface on the outbound SMN boundary: cocotb binds the
// slave agent to its members.
public_flat_rw -module "ocah_axi_if" -var "*"
public_flat_rw -module "smu_wrapper" -var "*"
public_flat_rw -module "smu" -var "*"
public_flat_rw -module "axi_iw_converter" -var "*"
public_flat_rw -module "dtp" -var "*"
public_flat_rw -module "jtag_intf_unit" -var "*"
public_flat_rw -module "jtag_stap" -var "*"
public_flat_rw -module "jtag_ptap" -var "*"
public_flat_rw -module "smc" -var "*"
public_flat_rw -module "smc_base" -var "*"
public_flat_rw -module "smc_fabric" -var "*"
public_flat_rw -module "smc_local_fabric" -var "*"
public_flat_rw -module "smc_local_xbar" -var "*"
public_flat_rw -module "smc_internal_axi_lite_xbar" -var "*"
public_flat_rw -module "smc_peripherals" -var "*"
public_flat_rw -module "smc_periph_axi_lite_xbar" -var "*"
public_flat_rw -module "smc_efuse_wrapper" -var "*"
public_flat_rw -module "efuse_interface_controller" -var "*"
public_flat_rw -module "smc_cpu_wrapper" -var "*"
public_flat_rw -module "smc_4core_cpu" -var "*"
// The SEP SPI host's pad-facing ports and its RX FIFO read port: the host side
// that smu_sep_spi_test compares against the SMC pads.
public_flat_rw -module "sep_ot_spi_wrap" -var "spi_*"
public_flat_rw -module "spi_host" -var "rx_*"
