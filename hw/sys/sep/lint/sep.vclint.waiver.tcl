waive_violation -add {CombLoop_entropy_ring_oscillator} -comment {Hand-instantiated ring oscillator (buffer/inverter delay chain with feedback) - the physical noise source for the TRNG. The combinational feedback loop is intentional and must not be synthesized/optimized; timing is broken via set_false_path SDC. Documented intentional violation. TT IP. Created by gchang on 09-Jun-2026} -filter [apply_prefix {(Goal == "lint_rtl_enhanced") AND (Module == "${PREFIX}entropy_ring_oscillator") AND (DesignNode =~ "*.feedback")}] -app { lint } -tag { CombLoop } -user { gchang } -timestamp { 09-06-2026 14:34:55 }
waive_violation -add {STARC05-1_4_3_4_entropy_source_noise_obs_sclk} -comment {TRNG raw-noise observation path. The asynchronously divided sampler clock is deliberately sampled as data into the clk_i domain so an edge detect (noise_obs_sample_stb) can strobe capture of one raw noise bit per sample period. Metastability is already handled by the 2-FF synchroniser on these very lines; removing this would delete a feature required for entropy certification. Created by gchang on 17-Aug-2026} -filter [apply_prefix {(Goal == "lint_rtl_enhanced") AND (Module == "${PREFIX}entropy_source") AND (NonClkPath =~ "*.noise_obs_raw_sclk") AND (Statement =~ "*noise_obs_sclk_meta <= noise_obs_raw_sclk;")}] -app { lint } -tag { STARC05-1.4.3.4 } -user { gchang } -timestamp { 17-08-2026 00:00:00 }

