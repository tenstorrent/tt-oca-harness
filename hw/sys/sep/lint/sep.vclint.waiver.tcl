waive_violation -add {ImproperRangeIndex-ML_efuse_shadow_normal_storage} -comment {Indexed by efuse_pkg::normal_shadow_storage_idx(), which returns a 32-bit int unsigned. The array is sized NumNormalShadowWords = NumShadowWords - ActualNumClass1ShadowWords, and the function subtracts exactly those same class-1 words from the incoming word index, so the result always lands inside the array. Covered by the same Class1ShadowRangesValid_A / Class1ShadowCountFits_A elaboration assertions. Created by gchang on 17-Aug-2026} -filter [apply_prefix {(Goal == "lint_rtl_enhanced") AND (Module == "${PREFIX}efuse_shadow_regs") AND (NodeName == "shadow_efuse_values") AND (RTL_EXPRESSION =~ "*normal_shadow_storage_idx*") AND (NewExprSize == "32")}] -app { lint } -tag { ImproperRangeIndex-ML } -user { gchang } -timestamp { 17-08-2026 00:00:00 }
waive_violation -add {SetBeforeRead-ML_efuse_token_digest_sha256_sticky} -comment {Intentional sticky HOLD-LATCHES (always_latch) that retain the SHA digest and its valid bit across cold reset (by design; see comments L166-167/L176). The flagged "read before set" is the latch's own hold path (x <= x), the latches are deliberately unreset so the value persists across cold reset. Benign: the valid bit (cleared by start_i) gates use of the digest, and a power-up garbage 256-bit digest cannot spuriously match the fused token. TT IP. Created by gchang on 19-Jun-2026} -filter [apply_prefix {(Goal == "lint_rtl_enhanced") AND (Module == "${PREFIX}efuse_token_digest_sha256") AND (Signal_Name =~ "*sticky_n0_scan*")}] -app { lint } -tag { SetBeforeRead-ML } -user { gchang } -timestamp { 19-06-2026 15:00:00 }
waive_violation -add {STARC05-2_11_3_1_sep_efuse_wrapper_reset_cycle_cnt} -comment {The lint tool thinks this is an FSM, but it's really just a counter. Writing a counter in one block is safe, no need to split it into different always blocks. TT IP. Created by gchang on 19-Jun-2026} -filter [apply_prefix {(Goal == "lint_rtl_enhanced") AND (Module == "${PREFIX}sep_efuse_wrapper") AND (Signal == "reset_cycle_cnt")}] -app { lint } -tag { STARC05-2.11.3.1 } -user { gchang } -timestamp { 19-06-2026 14:51:59 }

