waive_violation -add {SEP_STARC05-2_10_6_1_abr_guarded} -comment {Each subtraction is used only when the first operand is the larger, and the PISO and splitter check that directly. In sigdecode_h a negative difference comes only from a malformed signature, which raises the decode error and aborts. Third-party Adams Bridge IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {((Module == "${PREFIX}abr_piso_multi") AND (LHSExpr == "buffer_rw_ptr")) OR ((Module == "${PREFIX}abr_splitter") AND (LHSExpr =~ "rand_reduced*")) OR ((Module == "${PREFIX}sigdecode_h") AND (LHSExpr == "hintsum_curr_poly"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_opentitan_modular_wrap} -comment {Wrap is intended behaviour for the SHA-2 digest additions (modulo 2^32 or 2^64 is FIPS 180-4 standard) and the OTBN add (RV32I wraps modulo 2^32). The HMAC message length only wraps after 2^64 bits (over 2 exabytes) of input. OTBN branch targets are also checked against the full 32-bit ALU result, which raises an error on overflow. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {((Module == "${PREFIX}prim_sha2") AND ((LHSExpr =~ "digest_d*") OR (LHSExpr =~ "digest256_d*"))) OR ((Module == "${PREFIX}hmac") AND (LHSExpr == "message_length_d")) OR ((Module == "${PREFIX}otbn_alu_base") AND (LHSExpr == "adder_result")) OR ((Module == "${PREFIX}otbn_predecode") AND (LHSExpr == "ctrl_flow_target_predec_o"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_opentitan_bounded} -comment {Each result stays below its width. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {((Module == "${PREFIX}hmac") AND (LHSExpr == "wmask_ones")) OR ((Module == "${PREFIX}prim_packer") AND ((LHSExpr == "inmask_ones") OR (LHSExpr == "pos_with_input"))) OR ((Module == "${PREFIX}otbn_mac_bignum_fsm") AND (LHSExpr == "cycle_count_d")) OR ((Module == "${PREFIX}otbn_vec_multiplier") AND (LHSExpr == "result_o")) OR ((Module == "${PREFIX}spi_controller_data_fifos") AND (LHSExpr == "tx_qd_o")) OR ((Module == "${PREFIX}spi_controller_fsm") AND (LHSExpr == "bit_cntr_d"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_prim_sum_tree_threshold_scope} -comment {The sum is only used in aggregate mode, but entropy_health_test hardwires the other mode (per-lane). Therefore, this potential overflow is irrelevant. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}prim_sum_tree") AND (LHSExpr == "node_sum")}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_secure_dma_byte_counters} -comment {The DMA stops once bytes copied reaches the programmed size, so the counters stay close to that size. The only way to overflow is for software to program a size within a few bytes of 4 GB (impractical/unrealistic), which wraps the counter to zero so the DMA never stops. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}secure_dma") AND ((LHSExpr == "transfer_byte_d") OR (LHSExpr == "chunk_byte_d"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_secure_dma_remaining_bytes} -comment {Bytes left is the programmed size minus bytes copied, only used while bytes copied is below the size, so it never goes negative. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}secure_dma") AND ((LHSExpr == "transfer_remaining_bytes") OR (LHSExpr == "chunk_remaining_bytes"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_secure_dma_addresses} -comment {Dropping the carry is the correct behaviour for an address: a carry out of the 64-bit address would point past the end of the address space, which does not exist, so the address wraps to 0 as a CPU address would. Third-party OpenTitan IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}secure_dma") AND ((LHSExpr == "src_addr_d") OR (LHSExpr == "dst_addr_d") OR (LHSExpr == "new_src_addr") OR (LHSExpr == "new_dst_addr"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_pulp_axi_beat_address} -comment {AXI forbids a burst from crossing a 4 KB boundary, so stepping the address from one word to the next inside a burst only changes the low 12 bits and can never carry out of the top. Third-party PULP IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}axi_to_detailed_mem") AND ((LHSExpr == "rd_meta.addr") OR (LHSExpr == "wr_meta.addr"))}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
waive_violation -add {SEP_STARC05-2_10_6_1_pulp_axi_splitter_beats} -comment {The burst splitter's subtraction only runs when the value being subtracted is less than the value being subtracted from, so it never goes negative. Third-party PULP IP shouldn't be modified. Created by gchang on 17-Nov-2026} -filter [apply_prefix {(Module == "${PREFIX}axi_burst_splitter_gran_ax_chan") AND (LHSExpr == "num_beats_d")}] -app { lint } -tag { STARC05-2.10.6.1 } -user { gchang } -timestamp { 17-11-2026 12:00:00 }
