#=======================================================================================================================
# CDC_UNSYNC_CTRL / CDC_UNSYNC_DATA : EL2 DMI JTAG-to-core crossings (i_jtag_tap/dr -> veer/dbg)
#=======================================================================================================================
# JTAG DR addr/data bits cross TCK -> SEPCLK unsynchronized by design. Every capture in the debug module
# is gated by dmi_reg_en/dmi_reg_wr_en, single-cycle pulses from the dmi_jtag_to_core_sync multiflop
# synchronizer. DR only reloads at Update-DR, the same TCK edge that launches the enable bits, so all
# crossing bits are static when the qualifier pulse fires: a valid qualifier scheme on every path.
# The two waivers below cover the read path (dmi_rddata_reg) and the qualified write/enable paths.
#=======================================================================================================================
waive_violation -add {SEP_CDC_UNSYNC_CTRL_5822} -comment {el2 DMI read path: dmi_rddata_reg and dbg/sbcs_error_reg is gated by the synchronized dmi_reg_en qualifier, therefore not a risk} -filter [apply_prefix {((DestObject == "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/veer/dbg/dmi_rddata_reg/genblock.genblock.dff/dout/Q[31:0]") OR (DestObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/veer/dbg/sbcs_*")) AND (ReasonInfoList:ReasonInfo:ReasonCode == "NO_SYNC_METHOD") AND (SrcObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/dmi_wrapper/i_jtag_tap/dr/Q*") AND (SrcClockInfoList:SrcClockInfo:ClockName == "JTAG_TCK") AND ((DestClockInfoList:DestClockInfo:ClockName == "SEPCLK") OR (DestClockInfoList:DestClockInfo:ClockName == "SMUCLK")) AND (SrcObjectType == "flop") AND (DestObjectType == "flop") AND (Module == "el2_veer_wrapper") AND (FullyContainedViolation == "true")}] -app { cdc } -tag { CDC_UNSYNC_NOSCHEME } -user { danielkim } -timestamp { 08-07-2026 17:39:58 }
waive_violation -add {SEP_CDC_UNSYNC_DATA_5705} -comment {el2 DMI write/enable paths are gated by the synchronized dmi_reg_en/dmi_reg_wr_en qualifier, therefore not a risk} -filter [apply_prefix {(DestObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/veer/dbg/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "NFF_USED_AS_QUALIFIER") AND (ReasonInfoList:ReasonInfo:ReasonCodeMsg == "[INFO] Tool detected multiflop synchronizer used as control path qualifier") AND (SrcObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/dmi_wrapper/i_jtag_tap/dr/Q*") AND (SrcClockInfoList:SrcClockInfo:ClockName == "JTAG_TCK") AND ((DestClockInfoList:DestClockInfo:ClockName == "SEPCLK") OR (DestClockInfoList:DestClockInfo:ClockName == "SMUCLK")) AND (CtrlPathList:CtrlPathInfo:SyncObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/dmi_wrapper/i_dmi_jtag_to_core_sync/*") AND (Module == "el2_veer_wrapper") AND (FullyContainedViolation == "true")}] -app { cdc } -tag { CDC_UNSYNC_DATA } -user { danielkim } -timestamp { 08-07-2026 17:43:08 }

waive_violation -add {SEP_CDC_UNSYNC_ASYNCRESET_7593} -comment {jtag_trst_ni and tck are companion pins of one host-driven JTAG interface; trst is released while tck is idle so there is no edge to race, therefore not a risk} -filter [apply_prefix {(ReasonInfoList:ReasonInfo:ReasonCode == "RST_ASYNC_DEASSERTION") AND (ReasonInfoList:ReasonInfo:ReasonCodeMsg == "[ERROR] Asynchronous reset deassertion") AND (SrcObject == "jtag_trst_ni") AND (DestObject =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/dmi_wrapper/i_jtag_tap*") AND (SrcClockInfoList:SrcClockInfo:ClockName == "ck_feedthru") AND (DestClockInfoList:DestClockInfo:ClockName == "JTAG_TCK")  AND (SrcObjectType == "primary input") AND (AllSrcResets:SrcResetInfo:ResetObject == "jtag_trst_ni") AND ((AllSrcResets:SrcResetInfo:ResetName == "JTAG_TRST_N") OR (AllSrcResets:SrcResetInfo:ResetName == "trst_n_combined")) AND (DestObjectType == "Reset pin of flop") AND (Module == "sep")}] -app { cdc } -tag { CDC_UNSYNC_ASYNCRESET } -user { danielkim } -timestamp { 07-07-2026 11:32:03 }
waive_violation -add {SEP_CDC_UNSYNC_DATA_2959} -comment {Opentitan prim_reg_cdc handles the crossing with a synchronized qualifier, therefore it is not a risk} -filter [apply_prefix {(DestObject =~ "${PREFIX}u_sep_wdt_wrap/u_wdt_aon_timer/u_reg/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "QUAL_CONVERGES_OTHER_SYNC_SRC") AND (ReasonInfoList:ReasonInfo:ReasonCode == "UDS_USED_AS_QUALIFIER") AND (ReasonInfoList:ReasonInfo:ReasonCodeMsg == "[ERROR] Qualifier converges with another synchronous source before gating logic") AND (ReasonInfoList:ReasonInfo:ReasonCodeMsg == "[INFO] User defined synchronizer cell used as control path qualifier") AND (SrcObject =~ "${PREFIX}u_sep_wdt_wrap/u_wdt_aon_timer/u_reg/*_cdc/src_q/*") AND ((SrcClockInfoList:SrcClockInfo:ClockName == "SEPCLK") OR (SrcClockInfoList:SrcClockInfo:ClockName == "SMUCLK")) AND ((DestClockInfoList:DestClockInfo:ClockName == "WDTCLK") OR (DestClockInfoList:DestClockInfo:ClockName == "SEP_WDT_CLK")) AND (CtrlPathList:CtrlPathInfo:SyncObject =~ "${PREFIX}u_sep_wdt_wrap/u_wdt_aon_timer/u_reg/*_cdc/u_src_to_dst_req/prim_flop_2sync/*") AND (FullyContainedViolation == "true")}] -app { cdc } -tag { CDC_UNSYNC_DATA } -user { danielkim } -timestamp { 08-07-2026 18:53:33 }
waive_violation -add {SEP_CDC_UNSYNC_NOSCHEME_3011} -comment {ext_debug_bus_o is an observability-only primary output with no capture flop, therefore not a risk.} -filter [apply_prefix {(DestObject =~ "ext_debug_bus_o*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "NO_SYNC_METHOD") AND (ReasonInfoList:ReasonInfo:ReasonCodeMsg == "[ERROR] Enable Criteria not satisfied, no valid qualifier") AND (DestClockInfoList:DestClockInfo:ClockName == "ck_feedthru") AND (DestObjectType == "primary output") AND (Module == "sep")}] -app { cdc } -tag { CDC_UNSYNC_NOSCHEME } -user { danielkim } -timestamp { 08-07-2026 19:31:00 }

