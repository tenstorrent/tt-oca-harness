#=======================================================================================================================
# CDC_COHERENCY_RECONV_* : reconvergence of independently synchronized control bits (EL2 + aon_timer)
#=======================================================================================================================
# All reconvergence flags fall inside third-party IP and involve independent single-bit control signals,
# not multi-bit encoded values that must arrive coherently. EL2: tlu halt/run/irq requests and the DMI op
# bits are separate handshakes arbitrated by the tlu/dbg FSMs; the lockstep shadow core reuses the same
# synchronized dmi_reg_en qualifier through the delay_input_d buffers, which the tool mistakes for
# synchronizers. aon_timer: prim_reg_cdc handshake syncs converge at the cdc arb FSM / wdog compare /
# sticky intr logic, all designed for asynchronous arrival.
#=======================================================================================================================
waive_violation -add {SEP_CDC_COHERENCY_RECONV_COMB_5939} -comment {Tlu halt/run/irq requests are independent single-bit handshakes each synchronized alone; the tlu FSM arbitrates arrival order so no coherent multi-bit value is required, therefore not a risk} -filter [apply_prefix {(ConvergencePoint =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/veer/dec/tlu/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "SYNC_SRC_CONV")}] -app { cdc } -tag { CDC_COHERENCY_RECONV_COMB } -user { danielkim } -timestamp { 08-07-2026 21:26:00 }
waive_violation -add {SEP_CDC_COHERENCY_RECONV_COMB_5940} -comment {DMI op bits rd_en/wr_en are mutually exclusive by protocol (op=01 read / 10 write) so only one sync chain pulses per transaction and the OR at reg_en cannot merge skewed pulses, therefore not a risk} -filter [apply_prefix {(ConvergencePoint == "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/dmi_wrapper/i_dmi_jtag_to_core_sync/reg_en") AND (ReasonInfoList:ReasonInfo:ReasonCode == "SYNC_SRC_CONV")}] -app { cdc } -tag { CDC_COHERENCY_RECONV_COMB } -user { danielkim } -timestamp { 08-07-2026 21:26:00 }
waive_violation -add {SEP_CDC_COHERENCY_RECONV_COMB_5942} -comment {Opentitan aon_timer internal single-bit prim_reg_cdc handshake syncs converge at the cdc arb FSM and sticky intr logic, both designed for async arrival, therefore not a risk} -filter [apply_prefix {(ConvergencePoint =~ "${PREFIX}u_sep_wdt_wrap/u_wdt_aon_timer/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "SYNC_SRC_CONV")}] -app { cdc } -tag { CDC_COHERENCY_RECONV_COMB } -user { danielkim } -timestamp { 08-07-2026 21:26:00 }
waive_violation -add {SEP_CDC_COHERENCY_RECONV_SEQ_5981} -comment {Opentitan aon_timer register cdc handshakes serialize per register and wdog config is quasi-static before enable; convergence is registered in the dest domain, therefore not a risk} -filter [apply_prefix {(ConvergencePoint =~ "${PREFIX}u_sep_wdt_wrap/u_wdt_aon_timer/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "SYNC_SRC_CONV")}] -app { cdc } -tag { CDC_COHERENCY_RECONV_SEQ } -user { danielkim } -timestamp { 08-07-2026 21:26:00 }
waive_violation -add {SEP_CDC_COHERENCY_ASYNCSRCS_RECONV_SEQ_5975} -comment {Independent requests from different domains (DMI op bits, halt/run reqs, irqs) converge at the mstatus update enable; events are independent so arrival order is functionally arbitrary, therefore not a risk} -filter [apply_prefix {(ConvergencePoint =~ "${PREFIX}u_sep_cpu/u_el2_veer_wrapper/veer/dec/tlu/*") AND (ReasonInfoList:ReasonInfo:ReasonCode == "ASYNC_SRC_CONV")}] -app { cdc } -tag { CDC_COHERENCY_ASYNCSRCS_RECONV_SEQ } -user { danielkim } -timestamp { 08-07-2026 21:26:00 }

