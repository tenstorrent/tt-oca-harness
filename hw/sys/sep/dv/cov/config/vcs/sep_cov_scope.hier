-module prim_subreg_ext
-module prim_subreg_shadow
-module prim_sum_tree
-module prim_sync_reqack
-module prim_sync_reqack_data
-module prim_xnor2
-module prim_xor2

// pulp-platform common_cells (vendor/pulp-platform/common_cells/upstream).
// The complete pulp-platform AXI modules are handled by the ownership scope.
-module addr_decode
-module addr_decode_dync
-module counter
-module delta_counter
-module fifo_v3
-module id_queue
-module lzc
-module onehot_to_bin
-module rr_arb_tree
-module spill_register
-module spill_register_flushable
-module stream_fifo
-module stream_fork
-module stream_fork_dynamic
-module stream_join
-module stream_join_dynamic
-module stream_mux
-module stream_register

// TT-owned generic standard-cell wrappers (hw/common/ocah_prim_generic).
// Authored by TT, but library-class by the same rule as the two blocks above.
-module prim_and3
-module prim_ao222
-module prim_clock_nand2
-module prim_flop_3sync
-module prim_metastab_hardened_dffr
-module prim_nand4
-module prim_nor4
-module prim_or2
-module prim_or4
-module prim_stdmux2

// DV models and AXI error slaves inside the integration wrapper. The memory
// arrays themselves are prim_ram_*/prim_rom and are already held by the library
// rules above. The wrapper's TT interface shims -- sep_sram_interface_shim,
// sep_rom_interface_shim, sep_tcm_wrapper, efuse_interface_shim -- stay graded:
// they are SEP RTL under hw/sys/sep/rtl and hw/ip/efuse/rtl, and a SEP test
// states a contract on the SRAM path through them.
//
// The two wrapper error slaves are named by INSTANCE, not by module. `-module`
// would also match TT-owned prim_axi_lite_err_slv instances elsewhere in SEP:
// the prim_axi_lite_err_slv instances in sep_efuse_wrapper.sv,
// sep_system_csr.sv, sep_io.sv, sep_crypto.sv and key_manager.sv.
// sep_axi_map_refuse_test, the
// dead-space decode tests and sep_km_otp_shim_unreachable_test grade those
// refusals. The third-party axi_err_slv module is handled by
// the ownership scope below.
-module efuse_bank_model
-tree sep_uvm_top.u_dut.u_sep_ip_integration.u_ext_trng_axil_err_slv
-tree sep_uvm_top.u_dut.u_sep_ip_integration.u_axi_extension_err_slv

// Entropy ring oscillator delay stages. A ring oscillator is an analog
// construct: in digital simulation the chain is either X or externally forced
// (+ENABLE_ENTROPY_NOISE_GEN), so a toggle on a delay buffer states nothing
// about the design. The oscillator wrapper itself stays graded -- its enable
// and stage-select logic is digital and a bug there is observable.
-module entropy_ring_buf_wrapper
-module entropy_ring_nand2_wrapper
-module entropy_ring_mux2_wrapper

// SystemVerilog packages. A package holds types, parameters and functions; it
// has no instance and no state, so it can only ever score 0.00 and drags the
// average with a denominator that represents no logic. axi_pkg also carries
// one unnamed immediate assertion, inside wrap_boundary()
// (vendor/pulp-platform/axi/upstream/src/axi_pkg.sv), on the length of
// an AXI BURST_WRAP transfer. It is a protocol check on the caller's burst, not
// SEP logic; the SEP burst-type tests that issue WRAP bursts grade the SEP
// response at the bus.
-module axi_pkg

// TT-owned CDC, reset and code-conversion primitives (hw/common/ocah_prim).
// Library-class by the same rule as the blocks above: a synchroniser chain, a
// reset synchroniser, a scan/bypass reset mux, a Gray codec and a revision-ID
// cell carry the same behaviour in every design that instantiates them, and no
// SEP test states a requirement about one.
//
// The rest of ocah_prim stays graded, because a SEP test does name the function:
// prim_axi_lite_err_slv (sep_axi_map_refuse_test and the dead-space decode
// tests grade the refusal), prim_axi_addr_fixer, prim_axil_addr_fixer,
// prim_axi_id_converter and prim_axi_user_override (the remap and filter
// datapath), prim_axi_lite_to_apb_single (the eFuse interface controller
// bridge), prim_refclk_count_w_cdc (the reference counter is itself a CSR
// feature) and prim_ram_1p_scr_ext / prim_ram_1p_adv_ext (OTBN scrambled
// imem and dmem). The pulp-platform AXI modules are not this set; the
// ownership scope excludes them.
//
// prim_carry_select_adder stays graded because it forms the remapped
// address in u_axi_alias_remap's AW and AR adders, so a wrong sum is a wrong
// remap. prim_diff_encode_multi and prim_diff_decode_multi stay graded because
// they carry the lifecycle, class-key and chiplet-UID redundant encodings.
-module prim_bin2gray
-module prim_gray2bin
-module prim_rev_cell
-module prim_rst_mux2_hf_n
-module prim_sync3
-module prim_sync_reset

// adams-bridge's vendored copy of the OpenTitan prim library
// (vendor/chipsalliance/adams-bridge/upstream/src/abr_prim{,_generic}/rtl).
// Each of these is the same cell as an OpenTitan prim already excluded above,
// carrying an abr_ prefix: abr_prim_buf/prim_buf, abr_prim_flop/prim_flop,
// abr_prim_sec_anchor_buf/prim_sec_anchor_buf, abr_prim_slicer/prim_slicer,
// abr_prim_count/prim_count, abr_prim_sparse_fsm_flop/prim_sparse_fsm_flop.
//
// abr_prim_lfsr is not library-class: its function is part of the accelerator.
// The ownership scope below applies the same policy to it and the original.
//
// abr_libs/ is not library-class either. Despite the "libs" name it holds the ML-KEM
// and ML-DSA arithmetic -- abr_adder, abr_add_sub_mod, abr_ntt_add_sub_mod,
// abr_piso_multi, abr_splitter, the sample, message and read-latency buffers
// and the AHB slave interface. That is the functional core of adams-bridge.
// The ownership scope below excludes those modules with the rest of the
// accelerator. They are not in the score.
-module abr_prim_buf
-module abr_prim_count
-module abr_prim_flop
-module abr_prim_generic_buf
-module abr_prim_generic_flop
-module abr_prim_sec_anchor_buf
-module abr_prim_slicer
-module abr_prim_sparse_fsm_flop

// TCM memory array. Same class as prim_ram_1p and prim_rom above: a RAM array
// implements no SEP contract. The TT wrapper around it, sep_tcm_wrapper, stays
// graded, as the DV-model rule above already states.
-module ram_16384x39

// The eFuse bank model's register block. `-module efuse_bank_model` above
// drops that module's own body only; a child instance is a separate module and
// keeps its own score, so without this line
// u_efuse_bank_model.u_efuse_bank_reg would stay in the DUT denominator. It is
// DV-model code under hw/ip/efuse/dv/models, states no SEP contract, and
// belongs out of the number with its parent.
-module efuse_bank_reg

// ===========================================================================
// OWNERSHIP SCOPE -- third-party functional IP.
//
// Everything below is graded by its own upstream verification, not by SEP. This
// is an OWNERSHIP decision, not an unreachability claim: the logic can fail, and
// a hole here is not evidence that it cannot be reached.
//
// What stays graded: every TT wrapper, interconnect, register block and shim --
// hw/sys/sep, hw/ip and hw/common -- because that is where SEP states its
// contracts and where an integration defect is SEP's to fix.
//
// The cost, stated plainly: integration defects DO occur inside vendored RTL as
// TT configures it. Such a defect shows up as a failing test, not as a
// coverage hole. Scoping these out means the score does not point at them; the
// tests that target them still run and still fail.
//
// 262 modules and 5 SystemVerilog interfaces (the interfaces carry the
// third-party IP's own bus and memory ports). urg writes a `(x)` suffix on a
// multi-instance module; that suffix is stripped before the name is matched,
// or modules like kmac(x) and axi_dw_downsizer(x) silently miss their -module
// line and stay in the score.
// ===========================================================================

