// Compile-time coverage scope of the SEP bench on VCS (`-cm_hier` with
// `-lca -cm_common_hier`, from `[coverage.vcs]` in sep_sim_cfg.toml). A
// `-tree` or `-module` line removes that hierarchy from the code-coverage
// database. Everything else under u_dut stays graded.

// ---------------------------------------------------------------------------
// Testbench. SEP DV code states no SEP RTL contract, so its code is not in the
// number. u_dut (sep_wrapper) and everything under it stays graded unless a
// rule below removes it.
//
// sep_uvm_top body: the shared bench top (hw/sys/sep/dv/tb/tb_top.sv). Depth 1 drops
// the top's own code only; its child instances keep their own rules.
-tree sep_uvm_top 1
// u_mbx: sep_outbound_mbx (hw/sys/sep/dv/tb/sep_outbound_mbx.sv), the TB
// outbound-mailbox responder and firmware-console monitor.
-tree sep_uvm_top.u_mbx
// u_smc_route_mem: sep_smc_route_mem (hw/sys/sep/dv/tb/sep_smc_route_mem.sv),
// the TB SMC responder of the BH-SMC hook.
-tree sep_uvm_top.u_smc_route_mem
// u_sep_fcov: sep_fcov (hw/sys/sep/dv/cov/sv/sep_fcov.sv), the passive
// covergroup collector. Its covergroups are the separate functional number;
// its procedural code is TB code and is not part of the code-coverage score.
-tree sep_uvm_top.u_sep_fcov
// u_ic_reset_sep: a TB-side jtag_ic_reset_reg (hw/ip/jtag/jtag_ptap/rtl) that
// drives the SEP IC-reset inputs from the cocotb JTAG pins. In the system this
// register is in the JTAG PTAP, outside the SEP hierarchy, and the JTAG DV
// grades it there.
-tree sep_uvm_top.u_ic_reset_sep
// u_tbadp_vehicle stays graded: it is a drbg_axil64_lane_adapter
// (hw/ip/drbg/rtl) that the TB instantiates as a test vehicle.
// sep_drbg_axil_adapter_port_arbitration_test drives its ports directly and
// grades the adapter contract, so its coverage is SEP RTL coverage.
//
// ocah_axi_sva: the AXI protocol checker (hw/common/dv/vip/ocah_axi_vip/sva),
// bound into the DUT. It is a DV checker, not SEP RTL.
-module ocah_axi_sva

// ---------------------------------------------------------------------------
// SEP CPU core complex. el2_veer_wrapper is the vendored VeeR EL2 core with
// its PIC, debug module and ICCM/DCCM controllers
// (vendor/chipsalliance/Cores-VeeR-EL2). It is third-party functional IP with
// its own upstream verification -- the same ownership decision as the
// OWNERSHIP SCOPE below. The TT wrapper around it, sep_cpu
// (hw/sys/sep/rtl/sep_cpu.sv), stays graded: the LSU/IFU/debug window
// remaps, the IFU and LSU demux decode and the reset-run synchroniser are
// where SEP states its CPU integration contract.
-tree sep_uvm_top.u_dut.u_sep.u_sep_cpu.u_el2_veer_wrapper

// ---------------------------------------------------------------------------
// Library cells. These implement no SEP contract: a generic FIFO, synchroniser
// or standard-cell wrapper carries the same behaviour in every design that
// instantiates it, and no SEP test states a requirement about one. Grading them
// puts the score on plumbing the DUT does not own.
//
// The discriminator is library CLASS, not authorship and not a path prefix: a
// cell whose behaviour is the same in every design that instantiates it, and
// about which no SEP test states a requirement. `/upstream/` in the source path
// is the common case, not the rule -- the TT-owned ocah_prim and
// ocah_prim_generic cells below are library-class too, and each block states
// its own reason. A `vendor/` or `/upstream/` path rule would be wrong in both
// directions: TT-authored files sit under vendor/ (the overlay/prim_shim
// cells, for example vendor/chipsalliance/adams-bridge/overlay/prim_shim), and
// a path rule would not separate a library cell from a functional IP in the
// same upstream tree.
//
// Functional third-party IP is handled by the ownership scope below. Keeping
// that policy separate prevents a library-cell rule from silently deciding
// whether a complete IP belongs in the SEP denominator.
// ---------------------------------------------------------------------------

// OpenTitan prim library (vendor/lowRISC/opentitan/upstream/hw/ip/prim*).
// Generic cells only. Functional prims a SEP test names (prim_sha2*,
// prim_prince, prim_subst_perm, prim_gf_mult, prim_dom_and_2share,
// prim_trivium, prim_lfsr, prim_crc32, prim_secded_*, prim_arbiter_ppc,
// prim_intr_hw, prim_reg_cdc) are excluded by the ownership scope below,
// with the IP that contains them. They are not in this list, and they are
// not in the score.
-module prim_alert_receiver
-module prim_alert_sender
-module prim_and2
-module prim_arbiter_fixed
-module prim_blanker
-module prim_buf
-module prim_cdc_rand_delay
-module prim_clock_gating
-module prim_clock_mux2
-module prim_count
-module prim_diff_decode
-module prim_edge_detector
-module prim_edn_req
-module prim_fifo_async
-module prim_fifo_sync
-module prim_fifo_sync_cnt
-module prim_flop
-module prim_flop_2sync
-module prim_flop_en
-module prim_inv
-module prim_lc_sync
-module prim_leading_one_ppc
-module prim_max_tree
-module prim_mubi4_sender
-module prim_mubi4_sync
-module prim_mubi8_sync
-module prim_onehot_check
-module prim_onehot_enc
-module prim_onehot_mux
-module prim_packer
-module prim_packer_fifo
-module prim_pulse_sync
-module prim_ram_1p
-module prim_ram_1p_adv
