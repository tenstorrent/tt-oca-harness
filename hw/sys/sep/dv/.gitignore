# Firmware build artifacts (regenerated by the shared DV firmware engine,
# hw/common/dv/fw/compile.mk via fw/fw.mk, from the C/asm source).
fw/tests/**/*.elf
fw/tests/**/*.hex
fw/tests/**/*.dis
fw/tests/**/*.map
fw/tests/**/*.o
fw/tests/*/build*/

# TCM images staged into the test cwd by the boot test at run time.
cocotb/tests/sep_itcm.hex
cocotb/tests/sep_dtcm.hex
!cocotb/tests/sep_boot_rom.hex

# Local working folder (not part of the flow).
/sim/

# Local agent instruction files.
/AGENTS.md
/CLAUDE.md

# Python bytecode
**/__pycache__/
*.pyc

# Staged real KM firmware. c_compile [c_build.km_rom_main] builds it from
# tracked source; do not commit the blob.
cocotb/tests/rom_main.rom.parhex

# Local DV audit reports: evidence about a working tree, not a shipped artifact.
/docs/dv_audit/
/docs/dv_audit_*.md

# Assembler-safe field-mask extract, lifted out of the generated km_csr.h by
# cocotb/tests/km_fw/Makefile at build time.
cocotb/tests/km_fw/km_fields.inc
cocotb/tests/km_fw/km_csr_fields.inc
cocotb/tests/km_fw/*.elf
cocotb/tests/km_fw/*.bin
