`ifndef SEP_AXI_EXTENSION_RDL_DEFINED
`define SEP_AXI_EXTENSION_RDL_DEFINED

addrmap sep_axi_extension {
    name = "SEP AXI Extension";
    desc = "SEP AXI Extension address map";

    // xSPI XIP region (256 MB: 0x1000_0000 - 0x2000_0000)
    mem {
        memwidth = 0x40;
        mementries = 0x200_0000;
    } external xip_region @0x1000_0000;
};

`endif
