`ifndef SEP_EFUSE_WRAP_RDL
`define SEP_EFUSE_WRAP_RDL

`include "efuse_interface_ctrl.rdl"
`include "efuse_mmr.rdl"
`include "sep_efuse_map.rdl"


addrmap sep_efuse_wrap {
    name = "SEP eFuse Wrapper Address Map";
    desc = "Places the SEP eFuse controller, its security-token registers and its shadow registers in one 4 KiB page.";

    /////////////////
    // Address Map //
    /////////////////

    efuse_interface_ctrl    efuse_interface_ctrl    @0x000_0000;
    efuse_mmr               efuse_mmr               @0x000_0400;
    sep_efuse_map           sep_efuse_map           @0x000_0800;

`ifdef OCAH_DOC_MEMORY_MAP
    efuse_interface_ctrl->ocah_aperture_size = 0x400;
    efuse_interface_ctrl->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0x0, bresp: ocah_resp_e::SLVERR};
    efuse_interface_ctrl->desc = "eFuse command and status registers.";
    efuse_mmr->ocah_aperture_size = 0x400;
    efuse_mmr->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0x0, bresp: ocah_resp_e::SLVERR};
    efuse_mmr->desc = "eFuse security-token registers.";
    sep_efuse_map->ocah_aperture_size = 0x800;
    sep_efuse_map->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    sep_efuse_map->desc = "Cached eFuse shadow registers.";
`endif
};

`endif
