`ifndef SEP_SCRATCH_WRAP_RDL
`define SEP_SCRATCH_WRAP_RDL

`include "sep_scratch.rdl"


addrmap sep_scratch_wrap {
    name = "SEP Scratch Wrapper Address Map";
    desc = "Places the cold-reset and warm-reset scratch register banks in one 4 KiB page.";

    /////////////////
    // Address Map //
    /////////////////

    sep_scratch     scratch_cold    @0x000_0000;
    sep_scratch     scratch_warm    @0x000_0080;

`ifdef OCAH_DOC_MEMORY_MAP
    scratch_cold->desc = "Cold-reset scratch register bank.";
    scratch_warm->desc = "Warm-reset scratch register bank.";
`endif
};

`endif
