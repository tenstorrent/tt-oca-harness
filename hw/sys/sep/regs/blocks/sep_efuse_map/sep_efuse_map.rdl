`ifndef SEP_EFUSE_MAP_RDL
`define SEP_EFUSE_MAP_RDL


addrmap sep_efuse_map {
    desc = "";

    ////////////////////////////////////////////////////////////////////////////
    // Register Definitions
    ////////////////////////////////////////////////////////////////////////////

    default regwidth = 64;
    default accesswidth = 64;

    // The spec's 96-bit LOCK field is split across two RDL registers because
    // PeakRDL requires power-of-2 regwidths. All 96 bits are physically fused.
    //   LOCKS      (64-bit @0x0): slots 0-31, functional fields LC_STATE..SEP_SYS_ID
    //   LOCKS_SPARE (32-bit @0x8): slots 32-40, spare0-spare8 field locks;
    //                              slots 41-47 unassigned (SPARE_LOCK_RSVD[31:18])
    // firmware reads the full lock state as three consecutive 32-bit words.
    reg LOCKS {
        regwidth    = 64;
        accesswidth = 64;
        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "lc_state_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } LC_STATE_WRITE_LOCK[0:0] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "lc_state_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } LC_STATE_READ_LOCK[1:1] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sboot_dis_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SBOOT_DIS_WRITE_LOCK[2:2] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sboot_dis_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SBOOT_DIS_READ_LOCK[3:3] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "TRANSIENT_RMA_EN_WRITE_LOCK, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } TRANSIENT_RMA_EN_WRITE_LOCK[4:4] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "TRANSIENT_RMA_EN_READ_LOCK, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } TRANSIENT_RMA_EN_READ_LOCK[5:5] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_dis_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_DIS_WRITE_LOCK[6:6] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_dis_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_DIS_READ_LOCK[7:7] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_dis_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SYS_DIS_WRITE_LOCK[8:8] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_dis_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SYS_DIS_READ_LOCK[9:9] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rma_sip_token_digest_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } RMA_SIP_TOKEN_DIGEST_WRITE_LOCK[10:10] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rma_sip_token_digest_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } RMA_SIP_TOKEN_DIGEST_READ_LOCK[11:11] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rma_chiplet_token_digest_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } RMA_CHIPLET_TOKEN_DIGEST_WRITE_LOCK[12:12] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rma_chiplet_token_digest_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } RMA_CHIPLET_TOKEN_DIGEST_READ_LOCK[13:13] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "class_key_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CLASS_KEY_WRITE_LOCK[14:14] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "class_key_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CLASS_KEY_READ_LOCK[15:15] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_revoke_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_REVOKE_WRITE_LOCK[16:16] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_revoke_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_REVOKE_READ_LOCK[17:17] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "bl1_version_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } BL1_VERSION_WRITE_LOCK[18:18] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "bl1_version_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } BL1_VERSION_READ_LOCK[19:19] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "bl2_version_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } BL2_VERSION_WRITE_LOCK[20:20] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "bl2_version_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } BL2_VERSION_READ_LOCK[21:21] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_uid_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_UID_WRITE_LOCK[22:22] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_uid_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_UID_READ_LOCK[23:23] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_hash0_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_HASH0_WRITE_LOCK[24:24] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_hash0_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_HASH0_READ_LOCK[25:25] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_uid_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_UID_WRITE_LOCK[26:26] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_uid_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_UID_READ_LOCK[27:27] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_pubk_hash_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SYS_PUBK_HASH_WRITE_LOCK[28:28] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_pubk_hash_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SYS_PUBK_HASH_READ_LOCK[29:29] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_uid_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SYS_UID_WRITE_LOCK[30:30] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_uid_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SYS_UID_READ_LOCK[31:31] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "status_rpt_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } STATUS_RPT_WRITE_LOCK[32:32] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "status_rpt_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } STATUS_RPT_READ_LOCK[33:33] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rom_ctl_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } ROM_CTL_WRITE_LOCK[34:34] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "rom_ctl_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } ROM_CTL_READ_LOCK[35:35] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sysclk_freq_mhz_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SYSCLK_FREQ_MHZ_WRITE_LOCK[36:36] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sysclk_freq_mhz_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SYSCLK_FREQ_MHZ_READ_LOCK[37:37] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_hash0_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_HASH0_WRITE_LOCK[38:38] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_hash0_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_HASH0_READ_LOCK[39:39] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_hash1_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_HASH1_WRITE_LOCK[40:40] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_hash1_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_HASH1_READ_LOCK[41:41] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "required_signers_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } REQUIRED_SIGNERS_WRITE_LOCK[42:42] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "required_signers_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } REQUIRED_SIGNERS_READ_LOCK[43:43] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "required_algs_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } REQUIRED_ALGS_WRITE_LOCK[44:44] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "required_algs_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } REQUIRED_ALGS_READ_LOCK[45:45] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_pqc_hash0_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_PQC_HASH0_WRITE_LOCK[46:46] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_pqc_hash0_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_PQC_HASH0_READ_LOCK[47:47] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_pqc_hash1_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_PQC_HASH1_WRITE_LOCK[48:48] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "chiplet_pubk_pqc_hash1_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } CHIPLET_PUBK_PQC_HASH1_READ_LOCK[49:49] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_pqc_hash0_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_PQC_HASH0_WRITE_LOCK[50:50] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_pqc_hash0_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_PQC_HASH0_READ_LOCK[51:51] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_pubk_pqc_hash_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SYS_PUBK_PQC_HASH_WRITE_LOCK[52:52] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sys_pubk_pqc_hash_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SYS_PUBK_PQC_HASH_READ_LOCK[53:53] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_hash1_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_HASH1_WRITE_LOCK[54:54] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_hash1_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_HASH1_READ_LOCK[55:55] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_pqc_hash1_write_lock, when set, this field is not write-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_PQC_HASH1_WRITE_LOCK[56:56] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "sip_pubk_pqc_hash1_read_lock, when set, this field is not read-able (neither the eFuse nor the shadow register)";
        } SIP_PUBK_PQC_HASH1_READ_LOCK[57:57] = 0x0;

        field {
            sw = rw; 
            onwrite = woset; 
            hw = r;
            desc = "sep_chiplet_id_write_lock (slot 29): when set, SEP_CHIPLET_ID is not write-able.";
        } SEP_CHIPLET_ID_WRITE_LOCK[58:58] = 0x0;

        field {
            sw = rw; onwrite = woset; hw = r;
            desc = "sep_chiplet_id_read_lock (slot 29): when set, SEP_CHIPLET_ID is not read-able.";
        } SEP_CHIPLET_ID_READ_LOCK[59:59] = 0x0;

        field {
            sw = rw; onwrite = woset; hw = r;
            desc = "sep_sip_id_write_lock (slot 30): when set, SEP_SIP_ID is not write-able.";
        } SEP_SIP_ID_WRITE_LOCK[60:60] = 0x0;

        field {
            sw = rw; onwrite = woset; hw = r;
            desc = "sep_sip_id_read_lock (slot 30): when set, SEP_SIP_ID is not read-able.";
        } SEP_SIP_ID_READ_LOCK[61:61] = 0x0;

        field {
