// Memory-map annotations of sep_top: aperture sizes, descriptions and the response an access
// outside a unit's registers receives. sep.rdl includes this file inside sep_top, and only
// the memory-map generator defines OCAH_DOC_MEMORY_MAP. The generator gives a unit with a
// generated decoder its window and the response past its registers, and fails on a line
// that states them again.

`define OCAH_SEP_OKAY ocah_resp'{rresp: ocah_resp_e::OKAY, rdata: 0x0, bresp: ocah_resp_e::OKAY}
`define OCAH_SEP_SLVERR ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0x0, bresp: ocah_resp_e::SLVERR}
`define OCAH_SEP_DECERR ocah_resp'{rresp: ocah_resp_e::DECERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::DECERR}

    sep_boot_rom->desc = "BL0 immutable instruction memory.";
    ocah_hole_resp = `OCAH_SEP_OKAY;
    ocah_gap_resp = `OCAH_SEP_DECERR;
    secure_dma->ocah_aperture_size = 0x1000;
    secure_dma->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    secure_dma->ocah_past_extent_note = "Up to offset 0x1FF the DMA answers with read data 0xFFFFFFFF and also latches PIC source 41.";
    secure_dma->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xFFFFFFFF, bresp: ocah_resp_e::SLVERR};
    secure_dma->ocah_hole_note = "An access to an unmapped offset also latches PIC source 41.";
    secure_dma->desc = "Secure DMA control and status registers.";
    wdt_timer->ocah_aperture_size = 0x1000;
    wdt_timer->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    wdt_timer->ocah_past_extent_note = "Up to offset 0x3F the timer answers with read data 0xFFFFFFFF and also latches PERIPH_BUS_ERR_STATUS.wdt, one of the bits behind PIC source 43.";
    otbn->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xFFFFFFFF, bresp: ocah_resp_e::SLVERR};
    aes->ocah_aperture_size = 0x1000;
    aes->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    aes->ocah_past_extent_note = "Up to offset 0xFF the AES answers with read data 0xFFFFFFFF and also latches PERIPH_BUS_ERR_STATUS.aes, one of the bits behind PIC source 43.";
    aes->desc = "AES block-cipher accelerator.";
    hmac->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xFFFFFFFF, bresp: ocah_resp_e::SLVERR};
    kmac->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xFFFFFFFF, bresp: ocah_resp_e::SLVERR};
    edn->ocah_aperture_size = 0x1000;
    edn->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    edn->ocah_past_extent_note = "Up to offset 0x7F the EDN answers with read data 0xFFFFFFFF and also latches PERIPH_BUS_ERR_STATUS.edn, one of the bits behind PIC source 43.";
    csrng->ocah_aperture_size = 0x1000;
    csrng->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    csrng->ocah_past_extent_note = "Up to offset 0x7F the CSRNG answers with read data 0xFFFFFFFF and also latches PERIPH_BUS_ERR_STATUS.csrng, one of the bits behind PIC source 43.";
    trng->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::ADOPTER, rdata: 0x0, bresp: ocah_resp_e::ADOPTER};
    trng->ocah_hole_note = "With no TRNG fitted, the reference integration answers DECERR, 0xBADCAB1E / DECERR.";
    sep_lifecycle_ctrl->desc = "Lifecycle state and transition control.";
    abr->ocah_aperture_size = 0xD000;
    abr->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    abr->desc = "Adams Bridge post-quantum accelerator for ML-DSA and ML-KEM.";
    entropy_pool->ocah_aperture_size = 0x1000;
    entropy_pool->ocah_past_extent_resp = `OCAH_SEP_SLVERR;
    entropy_pool->ocah_past_extent_note = "A 32-bit read of the upper word of a register also answers SLVERR, 0x0.";
    axil_mailbox->ocah_aperture_size = 0x8000;
    axil_mailbox->ocah_past_extent_resp = `OCAH_SEP_SLVERR;
    axil_mailbox->desc = "Eight bidirectional mailbox pairs.";
    outbound_filter_ctrl_wrap->ocah_full_stride_extent = true;
    inbound_filter_ctrl_wrap->ocah_full_stride_extent = true;
    sep_cpu_ctrl->desc = "SEP CPU control and interrupt registers.";
    spi_controller->ocah_aperture_size = 0x1000;
    spi_controller->ocah_past_extent_resp = ocah_resp'{rresp: ocah_resp_e::SLVERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::SLVERR};
    spi_controller->ocah_past_extent_note = "Up to offset 0x3F the SPI controller answers with read data 0xFFFFFFFF.";
    spi_controller->desc = "External I/O SPI controller bridge.";
    sep_external->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::ADOPTER, rdata: 0x0, bresp: ocah_resp_e::ADOPTER};
`ifndef EXCLUDE_CORE_LOCAL_RESOURCES
    pic->ocah_aperture_size = 0x8000;
    pic->ocah_past_extent_resp = `OCAH_SEP_OKAY;
`endif
