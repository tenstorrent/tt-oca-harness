    smc_cluster_core0_wdt->ocah_window_resp = `OCAH_SMC_OKAY;
    smc_cluster_core0_wdt->ocah_window_note = "The local crossbar sends this unit's whole 4 KiB page to the CPU cluster, which answers OKAY for an address it does not map. An AXI burst routes by its start address and cannot cross 4 KiB, so page-sized windows keep a burst on one crossbar target.";
    smc_cluster_core0_wdt->desc = "Core 0 watchdog timer.";
