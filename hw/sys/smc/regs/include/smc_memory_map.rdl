// Memory-map annotations of smc_top: aperture sizes, descriptions and the response an access
// outside a unit's registers receives. smc.rdl includes this file inside smc_top, and only
// the memory-map generator defines OCAH_DOC_MEMORY_MAP.

`define OCAH_SMC_OKAY ocah_resp'{rresp: ocah_resp_e::OKAY, rdata: 0x0, bresp: ocah_resp_e::OKAY}
`define OCAH_SMC_DECERR ocah_resp'{rresp: ocah_resp_e::DECERR, rdata: 0xBADCAB1E, bresp: ocah_resp_e::DECERR}

    ocah_full_stride_extent = true;
    ocah_hole_resp = `OCAH_SMC_OKAY;
    ocah_gap_resp = `OCAH_SMC_DECERR;
    smc_cluster_core0_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core0_wdt->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core0_wdt->desc = "Core 0 watchdog timer.";
    smc_cluster_core1_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core1_wdt->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core1_wdt->desc = "Core 1 watchdog timer.";
    smc_cluster_core2_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core2_wdt->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core2_wdt->desc = "Core 2 watchdog timer.";
    smc_cluster_core3_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core3_wdt->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core3_wdt->desc = "Core 3 watchdog timer.";
    debug_module->ocah_hole_resp = `OCAH_SMC_DECERR;
    debug_module->ocah_hole_note = "Only the harts of the CPU cluster reach this unit. An access from outside the cluster answers the same at every address in its aperture.";
    smc_reset_unit->ocah_aperture_size = 0x800;
    smc_reset_unit->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_reset_unit->desc = "System reset control.";
    smc_misc_wrap->ocah_aperture_size = 0x800;
    smc_misc_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    gpio_intf_wrap->ocah_aperture_size = 0x1000;
    gpio_intf_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_avsbus_controller->ocah_aperture_size = 0x1000;
    smc_avsbus_controller->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_i2c_wrap->ocah_aperture_size = 0x1000;
    smc_i2c_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_i2c_wrap->desc = "I2C and SMBus controller.";
    smc_uart_wrap->desc = "UART controller.";
    smc_efuse_map->ocah_aperture_size = 0x1000;
    smc_efuse_map->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    efuse_interface_ctrl->ocah_aperture_size = 0x1000;
    efuse_interface_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    efuse_interface_ctrl->desc = "eFuse command and status registers.";
    smc_telemetry_receiver_wrap->ocah_aperture_size = 0x1000;
    smc_telemetry_receiver_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_telemetry_receiver_wrap->desc = "Telemetry data receiver.";
    smc_system_timer_octs->ocah_aperture_size = 0x1000;
    smc_system_timer_octs->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    dfx_ctrl->ocah_aperture_size = 0x800;
    dfx_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    dfx_ctrl->desc = "DFT status exposed to boot firmware.";
    smc_base_config->ocah_aperture_size = 0x2000;
    smc_base_config->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_base_config->desc = "SMC base-address and aperture configuration.";
    smc_alias_remap_wrap->ocah_aperture_size = 0x1000;
    smc_alias_remap_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_mmode_remap_wrap->ocah_aperture_size = 0x1000;
    smc_mmode_remap_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_xvisor_remap_wrap->ocah_aperture_size = 0x1000;
    smc_xvisor_remap_wrap->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_inbound_filter_ctrl->ocah_aperture_size = 0x1000;
    smc_inbound_filter_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_outbound_filter_ctrl->ocah_aperture_size = 0x1000;
    smc_outbound_filter_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_mailbox->ocah_aperture_size = 0x20000;
    smc_mailbox->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_mailbox->desc = "Thirty-two bidirectional mailbox pairs.";
    dma_ctrl->ocah_aperture_size = 0x200;
    dma_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    dma_ctrl->desc = "Direct-memory-access controller.";
    zeroer_ctrl->ocah_aperture_size = 0x100;
    zeroer_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cpu_ctrl->ocah_aperture_size = 0x1000;
    smc_cpu_ctrl->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cpu_ctrl->desc = "SMC CPU-cluster control.";
    dtp_ctrl_reg->desc = "512-entry DTP control block.";
    dtp_ctrl_reg->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::FORWARD, rdata: 0x0, bresp: ocah_resp_e::FORWARD};
    smc_cla->desc = "Core Logic Analyzer debug and trace aperture.";
    smc_external->desc = "Adopter-owned external peripheral aperture.";
    smc_external->ocah_hole_resp = ocah_resp'{rresp: ocah_resp_e::ADOPTER, rdata: 0x0, bresp: ocah_resp_e::ADOPTER};

`ifndef EXCLUDE_CORE_LOCAL_RESOURCES
    smc_cluster_plic->ocah_aperture_size = 0x4000000;
    smc_cluster_plic->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_plic->desc = "Platform-Level Interrupt Controller.";
    smc_cluster_clint->ocah_aperture_size = 0x10000;
    smc_cluster_clint->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_clint->desc = "Core-Local Interruptor.";
    smc_cluster_core0_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core0_beu->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core0_beu->desc = "Core 0 bus-error unit.";
    smc_cluster_core1_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core1_beu->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core1_beu->desc = "Core 1 bus-error unit.";
    smc_cluster_core2_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core2_beu->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core2_beu->desc = "Core 2 bus-error unit.";
    smc_cluster_core3_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core3_beu->ocah_past_extent_resp = `OCAH_SMC_DECERR;
    smc_cluster_core3_beu->desc = "Core 3 bus-error unit.";
    smc_cluster_error_device->desc = "Error responder for unmapped cluster-bus accesses.";
    smc_cluster_error_device->ocah_hole_resp = `OCAH_SMC_DECERR;
    smc_cluster_error_device->ocah_hole_note = "Only the harts of the CPU cluster reach this unit. An access from outside the cluster answers the same at every address in its aperture.";
`endif
