`ifndef SMC_EXTERNAL_RDL
`define SMC_EXTERNAL_RDL

`include "smc_external_supplementary.rdl"
`include "smc_external_mandatory.rdl"
`include "ext_memory.rdl"

// Adopter external window (instantiated in smc_top @ 0xC040_0000).
// Split into two regions purely for readability/documentation — hardware treats
// them identically (same demux, same handling; no functional gating):
//   - mandatory     (low  @0x0000): blocks an adopter MUST implement
//                                   (efuse shim, per-pad GPIO ctrl, PLL, straps)
//   - supplementary (high @0x4000): blocks an adopter MAY omit
//                                   (I3C, PLL/PVT clk-obs, poc_pbias,
//                                    refclk, PVT)
addrmap smc_external {
    name = "SMC External Window Address Map";
    desc = "Adopter-provided external register window, split into mandatory and supplementary regions.";

    /////////////////
    // Address Map //
    /////////////////

    smc_external_mandatory         mandatory                       @0x0000;
    smc_external_supplementary     supplementary                   @0x4000;

    external ext_memory #(.NUM_ENTRIES(1041408), .WIDTH(32)) reserved @0x7000;

};

`endif
