// Available includes

`include "avsbus_controller.rdl"
`include "chip_config.rdl"
`include "dma_ctrl.rdl"
`include "dfx_ctrl_status.rdl"
`include "filter_ctrl.rdl"
`include "gpio_intf.rdl"
`include "remapped_region.rdl"
`include "reset_unit.rdl"
`include "scratch.rdl"
`include "alias_remap.rdl"
`include "axil_mailbox_smc_wrap.rdl"
`include "output_remap.rdl"
`include "spm_memory.rdl"
`include "spm_rom_memory.rdl"
`include "system_timer_octs.rdl"
`include "telemetry_receiver_wrap.rdl"
`include "uart_wrap.rdl"
`include "zeroer_ctrl.rdl"
`include "misc_wrap.rdl"
`include "bus_error_unit.rdl"
`include "clint.rdl"
`include "debug_module.rdl"
`include "efuse_interface_ctrl.rdl"
`include "error_device.rdl"
`include "ext_memory.rdl"
`include "oca_i3c_wrap.rdl"
`include "plic.rdl"
`include "cpu_ctrl.rdl"
`include "smc_base_config.rdl"
`include "smc_efuse_map.rdl"
`include "wdt.rdl"
`include "i2c_wrap.rdl"
`include "smc_cla.rdl"
`include "smc_external.rdl"

// SMC resource accessible from external agents
addrmap smc_top #(
    longint unsigned BASE_ADDR = 0xC000_0000
) {
    name = "SMC Top-Level Address Map";
    desc = "Top-level SMC address map exposing the resources accessible to external agents.";

    wdt                            smc_cluster_core0_wdt      @BASE_ADDR + 0x000_0000;
    wdt                            smc_cluster_core1_wdt      @BASE_ADDR + 0x000_0400;
    wdt                            smc_cluster_core2_wdt      @BASE_ADDR + 0x000_0800;
    wdt                            smc_cluster_core3_wdt      @BASE_ADDR + 0x000_0c00;

    debug_module                   debug_module               @BASE_ADDR + 0x000_1000;

    reset_unit                     smc_reset_unit             @BASE_ADDR + 0x000_2000;
    misc_wrap                      smc_misc_wrap              @BASE_ADDR + 0x000_2800;

    gpio_intf                      gpio_intf[65]              @BASE_ADDR + 0x000_3000 += 0x10;

    avsbus_controller              smc_avsbus_controller          @BASE_ADDR + 0x000_4000;

    i2c_wrap                       smc_i2c_wrap                   @BASE_ADDR + 0x000_5000;

    uart_wrap                      smc_uart_wrap                  @BASE_ADDR + 0x000_6000;

    smc_efuse_map                  smc_efuse_map                  @BASE_ADDR + 0x000_7000;
    efuse_interface_ctrl           efuse_interface_ctrl           @BASE_ADDR + 0x000_8000;

    telemetry_receiver_wrap        smc_telemetry_receiver_wrap    @BASE_ADDR + 0x000_9000;

    system_timer_octs              smc_system_timer_octs          @BASE_ADDR + 0x000_a000;

    external ext_memory #(.NUM_ENTRIES(512)) dtp_ctrl_reg         @BASE_ADDR + 0x000_b000;
    dfx_ctrl_status                dfx_ctrl                       @BASE_ADDR + 0x000_b800; // These CSRs are for ROMs knowledge of dfx status

    smc_base_config                smc_base_config                @BASE_ADDR + 0x001_0000;
    alias_remap                    smc_alias_remap[8]             @BASE_ADDR + 0x001_2000 += 0x20;
    output_remap                   smc_mmode_remap[8]             @BASE_ADDR + 0x001_3000 += 0x8;
    output_remap                   smc_xvisor_remap[8]            @BASE_ADDR + 0x001_4000 += 0x8;

    filter_ctrl                    smc_inbound_filter_ctrl[16]    @BASE_ADDR + 0x001_5000 += 0x20;
    filter_ctrl                    smc_outbound_filter_ctrl[16]   @BASE_ADDR + 0x001_6000 += 0x20;

    axil_mailbox_smc_wrap          smc_mailbox                    @BASE_ADDR + 0x001_8000;

    dma_ctrl                       dma_ctrl                       @BASE_ADDR + 0x003_8000;
    zeroer_ctrl                    zeroer_ctrl                    @BASE_ADDR + 0x003_8200;

    cpu_ctrl                       smc_cpu_ctrl                   @BASE_ADDR + 0x003_9000;

    oca_i3c_wrap                   oca_i3c_wrap                   @BASE_ADDR + 0x003_a000;

    external spm_rom_memory        spm_rom_memory              @BASE_ADDR + 0x004_0000;

    external spm_memory            spm_memory                  @BASE_ADDR + 0x006_0000;

    smc_cla                        smc_cla                     @BASE_ADDR + 0x016_0000;

    smc_external                   smc_external                @BASE_ADDR + 0x040_0000;

    external remapped_region       ecam_region                 @BASE_ADDR + 0x080_0000;

    external remapped_region       mmode_region                @BASE_ADDR + 0x100_0000;

    external remapped_region       xvisor_region               @BASE_ADDR + 0x180_0000;

`ifdef OCAH_DOC_MEMORY_MAP
    smc_cluster_core0_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core0_wdt->desc = "Core 0 watchdog timer.";
    smc_cluster_core1_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core1_wdt->desc = "Core 1 watchdog timer.";
    smc_cluster_core2_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core2_wdt->desc = "Core 2 watchdog timer.";
    smc_cluster_core3_wdt->ocah_aperture_size = 0x400;
    smc_cluster_core3_wdt->desc = "Core 3 watchdog timer.";
    smc_reset_unit->ocah_aperture_size = 0x800;
    smc_reset_unit->desc = "System reset control.";
    smc_misc_wrap->ocah_aperture_size = 0x800;
    gpio_intf->ocah_aperture_size = 0x1000;
    smc_avsbus_controller->ocah_aperture_size = 0x1000;
    smc_i2c_wrap->ocah_aperture_size = 0x1000;
    smc_i2c_wrap->desc = "I2C and SMBus controller.";
    smc_uart_wrap->desc = "UART controller.";
    smc_efuse_map->ocah_aperture_size = 0x1000;
    efuse_interface_ctrl->ocah_aperture_size = 0x1000;
    efuse_interface_ctrl->desc = "eFuse command and status registers.";
    smc_telemetry_receiver_wrap->ocah_aperture_size = 0x1000;
    smc_telemetry_receiver_wrap->desc = "Telemetry data receiver.";
    smc_system_timer_octs->ocah_aperture_size = 0x1000;
    dfx_ctrl->ocah_aperture_size = 0x800;
    dfx_ctrl->desc = "DFT status exposed to boot firmware.";
    smc_base_config->ocah_aperture_size = 0x2000;
    smc_base_config->desc = "SMC base-address and aperture configuration.";
    smc_alias_remap->ocah_aperture_size = 0x1000;
    smc_mmode_remap->ocah_aperture_size = 0x1000;
    smc_xvisor_remap->ocah_aperture_size = 0x1000;
    smc_inbound_filter_ctrl->ocah_aperture_size = 0x1000;
    smc_outbound_filter_ctrl->ocah_aperture_size = 0x1000;
    smc_mailbox->ocah_aperture_size = 0x20000;
    smc_mailbox->desc = "Thirty-two bidirectional mailbox pairs.";
    dma_ctrl->ocah_aperture_size = 0x200;
    dma_ctrl->desc = "Direct-memory-access controller.";
    zeroer_ctrl->ocah_aperture_size = 0x100;
    smc_cpu_ctrl->ocah_aperture_size = 0x1000;
    smc_cpu_ctrl->desc = "SMC CPU-cluster control.";
    dtp_ctrl_reg->desc = "512-entry DTP control block.";
    smc_cla->desc = "Core Logic Analyzer debug and trace aperture.";
    smc_external->desc = "Adopter-owned external peripheral aperture.";
`endif

    // Core-local resources below are reachable only by the SMC cluster's own harts
`ifndef EXCLUDE_CORE_LOCAL_RESOURCES
    plic                           smc_cluster_plic            @BASE_ADDR + 0x400_0000;

    clint                          smc_cluster_clint           @BASE_ADDR + 0x800_0000;

    bus_error_unit                 smc_cluster_core0_beu       @BASE_ADDR + 0x801_0000;
    bus_error_unit                 smc_cluster_core1_beu       @BASE_ADDR + 0x801_1000;
    bus_error_unit                 smc_cluster_core2_beu       @BASE_ADDR + 0x801_2000;
    bus_error_unit                 smc_cluster_core3_beu       @BASE_ADDR + 0x801_3000;

    external error_device          smc_cluster_error_device    @BASE_ADDR + 0x801_4000;

`ifdef OCAH_DOC_MEMORY_MAP
    smc_cluster_plic->ocah_aperture_size = 0x4000000;
    smc_cluster_plic->desc = "Platform-Level Interrupt Controller.";
    smc_cluster_clint->ocah_aperture_size = 0x10000;
    smc_cluster_clint->desc = "Core-Local Interruptor.";
    smc_cluster_core0_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core0_beu->desc = "Core 0 bus-error unit.";
    smc_cluster_core1_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core1_beu->desc = "Core 1 bus-error unit.";
    smc_cluster_core2_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core2_beu->desc = "Core 2 bus-error unit.";
    smc_cluster_core3_beu->ocah_aperture_size = 0x1000;
    smc_cluster_core3_beu->desc = "Core 3 bus-error unit.";
    smc_cluster_error_device->desc = "Error responder for unmapped cluster-bus accesses.";
`endif
`endif


};
