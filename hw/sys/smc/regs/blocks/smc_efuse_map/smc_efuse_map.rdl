        } spare19_write_lock[46:46] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 19 read lock (slot 23). When set, SPARE[19] is not readable.";
        } spare19_read_lock[47:47] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 20 write lock (slot 24). When set, SPARE[20] is not writable.";
        } spare20_write_lock[48:48] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 20 read lock (slot 24). When set, SPARE[20] is not readable.";
        } spare20_read_lock[49:49] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 21 write lock (slot 25). When set, SPARE[21] is not writable.";
        } spare21_write_lock[50:50] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 21 read lock (slot 25). When set, SPARE[21] is not readable.";
        } spare21_read_lock[51:51] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 22 write lock (slot 26). When set, SPARE[22] is not writable.";
        } spare22_write_lock[52:52] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 22 read lock (slot 26). When set, SPARE[22] is not readable.";
        } spare22_read_lock[53:53] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 23 write lock (slot 27). When set, SPARE[23] is not writable.";
