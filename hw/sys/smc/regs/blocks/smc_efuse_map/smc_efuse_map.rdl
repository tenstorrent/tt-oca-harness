    reg JTAG_PUBLIC_IDENTITY {
        desc = "JTAG-public exception window. In PROD and RMA_SiP, JTAG reads of this range
                are admitted while JTAG access to every other fuse field is blocked. Encoding
                is adopter-defined; the harness does not interpret or consume the value. The
                slot-0 read lock still hides the bits when set.";
        regwidth = 256;

        field {
            sw = rw;
            hw = r;
            desc = "Opaque payload. Encoding is adopter-defined; the harness does not interpret
                    it.";
        } value [255:0] = 0x0;
    };

    reg I2C_I3C_ID {
        desc = "I2C/I3C interface ID";
        regwidth = 64;

        field {
            sw = rw;
            hw = r;
            desc = "I2C or I3C ID configuration:
                   * Static ID mode: [6:0] contains ID, [63:7] reserved
                   * Provisional ID mode: [63:0] full ID";
        } interface_id[63:0] = 0x0;
    };

    reg SMC_CONFIG {
        desc = "SMC boot and configuration controls sourced from fuse. Only the low word carries
                assigned bits, so firmware reads it as a single 32-bit access.";
        regwidth = 64;

        field {
            sw = rw;
            hw = r;
            desc = "When set, the ROM interface swaps byte order on instruction fetch.";
        } rom_flip_endianness[0:0] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "Reserved for future configuration bits.";
        } config_rsvd_low[6:1] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "When set, boot skips the SRAM auto-zero initialisation pass.";
        } sram_auto_zero_disable[7:7] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "Reserved for future configuration bits.";
        } config_rsvd_mid[14:8] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "When set, boot continues despite a reported memory repair or MBIST failure.";
        } dft_ignore_error[15:15] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "Reserved for future configuration bits.";
        } config_rsvd_high[63:16] = 0x0;
    };

    reg OCCP_TRANSPORT_TIMEOUT {
        desc = "OCCP transport timeout in the low word; upper word reserved.";
        regwidth = 64;

        field {
            sw = rw;
            hw = r;
            desc = "Transport timeout value consumed by the boot ROM OCCP driver.";
        } timeout[31:0] = 0x0;

        field {
            sw = rw;
            hw = r;
            desc = "Reserved for extension of the timeout encoding.";
        } timeout_rsvd[63:32] = 0x0;
    };

    reg SPARE_256_BITS {
        desc = "Individually lockable 256-bit spare region, reserved for fields assigned after the
                RTL is frozen. Each element has its own write/read lock pair in HARNESS_LOCKS.";
        regwidth = 256;

        field {
            sw = rw;
            hw = r;
            desc = "Spare fuse bits for future use.";
        } rsvd[255:0] = 0x0;
    };

    reg SPARE_64_BITS {
        desc = "64-bit spare region at the end of the map, reserved for fields assigned after the
                RTL is frozen. All elements share the slot-31 write/read lock pair in
                HARNESS_LOCKS.";
        regwidth = 64;

        field {
            sw = rw;
            hw = r;
            desc = "Spare fuse bits for future use.";
        } rsvd[63:0] = 0x0;
    };

    /////////////////
    // Address Map //
    /////////////////

    // Sizes total 8 + 8 + 32 + 72 + 8 + 8 + 864 + 24 = 1024 B, ending at 0x3FF.
    HARNESS_LOCKS           HARNESS_LOCKS           @ 0x0;
    ADOPTER_LOCKS           ADOPTER_LOCKS           @ 0x8;
    JTAG_PUBLIC_IDENTITY    JTAG_PUBLIC_IDENTITY    @ 0x10;
    I2C_I3C_ID              I2C_I3C_ID[9]           @ 0x30;
    SMC_CONFIG              SMC_CONFIG              @ 0x78;
    OCCP_TRANSPORT_TIMEOUT  OCCP_TRANSPORT_TIMEOUT  @ 0x80;
    SPARE_256_BITS          SPARE[27]               @ 0x88;
    SPARE_64_BITS           SPARE_TAIL[3]           @ 0x3E8;

};

`endif
