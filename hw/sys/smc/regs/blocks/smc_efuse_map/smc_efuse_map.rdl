    // ADOPTER_LOCKS holds one write/read pair per adopter lock region, at bits 2n and 2n+1 of
    // pair n. Pair n governs the n-th region of the adopter fuse region; pairs beyond the last
    // region are unused.
    reg ADOPTER_LOCKS {
        desc = "Lock controls for the adopter fuse region. When write locked, the corresponding
                adopter lock region is not programmable. When read locked, its shadow register is
                not readable.";

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Adopter region 0 write lock. When set, adopter lock region 0 is not writable.";
        } region0_write_lock[0:0] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Adopter region 0 read lock. When set, adopter lock region 0 is not readable.";
        } region0_read_lock[1:1] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Adopter region 1 write lock. When set, adopter lock region 1 is not writable.";
        } region1_write_lock[2:2] = 0x0;

