        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 12 write lock (slot 16). When set, SPARE[12] is not writable.";
        } spare12_write_lock[32:32] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 12 read lock (slot 16). When set, SPARE[12] is not readable.";
        } spare12_read_lock[33:33] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 13 write lock (slot 17). When set, SPARE[13] is not writable.";
        } spare13_write_lock[34:34] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 13 read lock (slot 17). When set, SPARE[13] is not readable.";
        } spare13_read_lock[35:35] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 14 write lock (slot 18). When set, SPARE[14] is not writable.";
        } spare14_write_lock[36:36] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 14 read lock (slot 18). When set, SPARE[14] is not readable.";
        } spare14_read_lock[37:37] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
            desc = "Spare 15 write lock (slot 19). When set, SPARE[15] is not writable.";
        } spare15_write_lock[38:38] = 0x0;

        field {
            sw = rw;
            onwrite = woset;
            hw = r;
