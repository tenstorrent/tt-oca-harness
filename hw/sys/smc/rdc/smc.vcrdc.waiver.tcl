# isolate_req_pinen_reg is the fifth register of the same retention set (Section 4.9 of the reset spec): it is
# written only through the same AXI-Lite external-register path, but it carries no async reset (cleared
# synchronously by cold reset only while isolate_req_pin is low), so the sibling waivers above, which key on the
# COLD destination reset objects, do not match it.
waive_violation -add {SMC_FLR_RDC_CORRUPT_OBSERVED_ISOLATE_REQ_PINEN} -comment {isolate_req_pinen_reg persists through FLR and cool reset (synchronous cold clear gated by isolate_req_pin low, no async reset) and is only updated by an SMC CPU write through the reset-unit register block; firmware writes ISOLATE_REQ_PINEN_REG first, the axil handshake completes, then FLR is triggered. By the time primary reset asserts there is no active AXI-Lite write into this retention register, so there is no RDC metastability risk and the crossing is safe (same disposition as the four sibling registers above).} -filter [apply_prefix {(RdcSourceResets:ResetName == "PRIMARY_RESET_N") AND (SrcObject =~ "${PREFIX}u_smc_peripherals/u_smc_reset_unit/u_reset_unit_reg/*") AND (RdcDestResets:DestResetInfo:ResetName == "'no-reset'") AND (DestSyncResetInfoList:DestResetInfo:ResetName == "COLD_RESET_N_SMC_CLK") AND (DestObject =~ "${PREFIX}u_smc_peripherals/u_smc_reset_unit/u_smc_cool_reset_wrap/isolate_req_pinen_reg/Q*")}] -app { rdc } -tag { RDC_CORRUPT_OBSERVED } -user { nbetik } -timestamp { 17-09-2026 11:44:06 }

