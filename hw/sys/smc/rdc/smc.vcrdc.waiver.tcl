# Reset-unit AND/deglitch combinational terms ahead of downstream reset syncs:
# every functional input to the reset AND-tree is itself registered or
# deglitched, and each consuming domain re-synchronizes the combined reset
# through its prim_sync_reset chain, so a combinational hazard on the tree
# cannot reach a flop reset pin unfiltered.
waive_violation -add {SMC_INTEGRITY_RESET_GLITCH_RESET_TREE} -comment {AND-combined reset tree with registered/deglitched inputs and per-domain resynchronization; every flagged destination is a reset-unit resynchronizer or stretcher flop.} -filter [apply_prefix {(GlitchyDestObjectList:GlitchyDestObject =~ "${PREFIX}u_smc_peripherals/u_smc_reset_unit/*")}] -app { rdc } -tag { INTEGRITY_RESET_GLITCH } -user { nbetik } -timestamp { 16-09-2026 12:50:22 }

