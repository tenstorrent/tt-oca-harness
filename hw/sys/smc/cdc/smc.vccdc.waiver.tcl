waive_violation -add {SMC_INTEGRITY_RESET_ASYNC_AND_SYNC_USAGE_METHODOLOGY} -comment {Async-assert/sync-consume on the reset-unit outputs, the AVS reset-sync tails, the JTAG reset input and the CPU-wrapper generated resets is the project reset methodology.} -filter [apply_prefix {(ResetObject =~ "${PREFIX}u_smc_peripherals/u_smc_reset_unit/rst_*") OR (ResetObject =~ "${PREFIX}u_smc_peripherals/u_avsbus_controller/*/gen_rst_sync_stage*.u_sync_dffr/q_d/Q") OR (ResetObject == "${PREFIX}smc_cpu_jtag_reset_i") OR (ResetObject =~ "${PREFIX}u_smc_cpu_wrapper/u_smc_cpu_ctrl_wrap/*reset_n*") OR (ResetObject =~ "${PREFIX}u_smc_cpu_wrapper/u_smc_cpu/u_digital_top/tlDM/dmOuter/dmOuter/hartResetReg_*/Q") OR (ResetObject == "${PREFIX}u_smc_cpu_wrapper/u_smc_cpu/init_mem_complete/Q")}] -app { cdc } -tag { INTEGRITY_RESET_ASYNC_AND_SYNC_USAGE } -user { nbetik } -timestamp { 16-09-2026 12:50:22 }
