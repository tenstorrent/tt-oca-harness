# --- chipyard CPU cluster reset-as-data methodology (class waiver) ---
# One ResetCatchAndSync_d3 per cluster reset in ClockGroupResetSynchronizer; the
# generated tree downstream uses Chisel synchronous resets (RegInit), so every
# register reports as a data consumer of the declared -async reset.
waive_violation -add {SMC_CPU_SETUP_RESET_DRIVING_NON_ASYNC_PIN_CLUSTER} -comment {11 -async cluster resets (smc.resets.tcl) pass one chipyard ResetCatchAndSync_d3 each and are then consumed as Chisel synchronous resets; async use is limited to IntSyncCrossingSource, clock_en and cluster_ded_o. Also covers the cluster boundary axi_isolate control (init_mem_complete & rst_*_ni) in smc_4core_cpu.} -filter [apply_prefix {(ResetName =~ "${PREFIX}u_smc_cpu_wrapper/*") AND ((NonResetInstance =~ "${PREFIX}u_smc_cpu_wrapper/*") OR (NonResetInstance =~ "cluster_*") OR (NonResetInstance =~ "smc_cluster_*"))}] -app { cdc } -tag { SETUP_RESET_DRIVING_NON_ASYNC_PIN } -user { nbetik } -timestamp { 16-09-2026 12:50:22 }

