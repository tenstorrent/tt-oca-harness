`verilator_config
// Same posture as smc_public_scope.vlt: cocotb reaches the TB top only, since
// global --public-flat-rw explodes the gpio hierarchy. Doubling the instance
// count makes that cost worse, not better, so keep the scope tight.
public_flat_rw -module "smc_dual_uvm_top" -var "*"
// Backdoor $readmemh into the prim_rom arrays: the target's production ROM and
// the controller's ROM override. prim_ram_1p/2p are the CPU scratch banks and
// the I3C table memories, opened for read-only peeks rather than backdoor load.
public_flat_rw -module "prim_rom" -var "mem"
public_flat_rw -module "prim_ram_1p" -var "mem"
public_flat_rw -module "prim_ram_2p" -var "mem"
