#
# Central waiver file for hand-authored Verible lint findings that a path
# exclusion would be too coarse for, because the file is otherwise linted
# normally and only one specific rule/declaration needs waiving. Loaded via
# --waiver_files by ocah-lint-sv-verible; see
# https://chipsalliance.github.io/verible/verilog_lint.html for the format.
#
# Every entry matches on a substring of the flagged declaration's own line
# via --regex (so it survives edits elsewhere in the file, unlike a
# --line=N pin), scoped with --location to the one file it's meant for,
# since the waiver file is shared across every invocation of the one-file-
# at-a-time lint command. --regex is a substring search, not a full-line
# match, so entries deliberately leave off `^`/`$` anchors.

# module-filename: intentional stub swaps. Each stub keeps the real module's
# name so it can drop into the same instantiation/filelist slot; renaming
# either the module or the file would break that substitution.
waive --rule=module-filename --regex="module sep_cpu" --location=".*hw/sys/sep/dv/shims/cpu/sep_cpu_stub\.sv$"
waive --rule=module-filename --regex="module abr_wrapper_key_reg " --location=".*hw/sys/sep/dv/shims/crypto/abr_wrapper_key_reg_stub\.sv$"

# module-filename: bundle file. OCAH4CORECluster_mem_swaps.sv carries six
# CIRCT-style memory-macro modules; the rule checks only the last one against
# the file name, but no single module name is meant to match a file that
# intentionally bundles several.
waive --rule=module-filename --regex="module OCAH4CORECluster_rom_ext " --location=".*hw/sys/smc/rtl/smc_cpu/mem_swaps/4core/OCAH4CORECluster_mem_swaps\.sv$"

# module-filename: the repo-wide `tb_top.sv` / `tb_wrapper_top.sv` convention
# (dtp, sep, smc, smu, the three cross_trigger sub-blocks, ocah_axi_vip). The
# file name is deliberately generic so every testbench directory exposes the
# same path regardless of which block it drives; the module inside is named
# for the block instead. dtp/sep/smc's copies fail single-file parsing
# (conditional `ifndef` headers) and never reach this rule at all; these are
# the ones that do parse standalone.
waive --rule=module-filename --regex="module smu_uvm_top" --location=".*hw/sys/smu/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module smu_wrapper_uvm_top " --location=".*hw/sys/smu/dv/tb/tb_wrapper_top\.sv$"
waive --rule=module-filename --regex="module cross_trigger_matrix_tb_top" --location=".*hw/ip/cross_trigger/cross_trigger_matrix/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module cross_trigger_network_tb_top" --location=".*hw/ip/cross_trigger/cross_trigger_network/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module cross_trigger_port_tb_top" --location=".*hw/ip/cross_trigger/cross_trigger_port/dv/tb/tb_top\.sv$"
waive --rule=module-filename --regex="module ocah_axi_vip_tb_top" --location=".*hw/common/dv/vip/ocah_axi_vip/dv/tb/tb_top\.sv$"

# interface-name-style: both interfaces predate the `_if` convention and are
# candidates for eventual elimination rather than a rename in this pass:
# axi4lite_intf.sv is a straight PeakRDL AXI4-Lite CPUIF import (renaming it
# would diverge it from its upstream source for a cosmetic gain), and
# apb_intf.sv's whole APB VIP is expected to fold into the shared AXI/APB VIP
# rather than be renamed in place.
waive --rule=interface-name-style --regex="interface apb_intf " --location=".*hw/ip/entropy_source/dv/tb_vcs/apb_vip/apb_intf\.sv$"
waive --rule=interface-name-style --regex="interface axi4lite_intf " --location=".*hw/common/axi/axi4lite_intf\.sv$"
