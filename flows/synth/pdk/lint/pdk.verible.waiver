#
# Technology prim cells replace the generic modules one-for-one, so their
# parameter names must match the generic interfaces that callers bind by name.
waive --rule=parameter-name-style --location=".*flows/synth/pdk/[^/]+/prim/prim_[a-z0-9_]+\.sv$"
