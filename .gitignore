.venv/
.bender/
__pycache__/
*.pyc

# Optional overlay repositories cloned by make agents-init / make nonfree-init
agents/
nonfree/
overlay/*
!overlay/
!overlay/examples/
!overlay/examples/**

# Transient per-block build outputs. Keep .gitkeep placeholders when used to show structure.
**/build/**
!**/build/
!**/build/**/
!**/build/**/.gitkeep

# Generated register HTML docs: commit the raw .html files, but drop the
# PeakRDL viewer assets (fonts, JS, CSS, search/data JSON, launchers, etc.).
**/regs/gen/html/**
!**/regs/gen/html/**/
!**/regs/gen/html/**/*.html

