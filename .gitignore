.venv/
.bender/
# Bender knowledge-graph cache emitted next to .bender/ by the flist/graph flows
# (e.g. `make -C hw/sys/smu -f flow.mk ocah-lint-slang-flist`).
.bender-kg/
__pycache__/
*.pyc

# Optional repositories cloned by make nonfree-init. No trailing slash, so a
# symlink into a companion checkout is covered too; anchored, so a nested path
# that happens to be named nonfree is not.
/nonfree

# The DV runner's site-local override layer: one deployment's tool binaries,
# launcher prefixes, and environment hooks (tools/dv/doc/run-dv.adoc).
/hw/common/dv/configs/site.local.toml

# Transient per-block build outputs. The build_ot* variants come from the SEP
# boot ROM BUILD_DIR overrides (OpenTitan SPI DMA/PIO boot images); build_dual is
# the dual-SMC DV tree, kept separate from build/ so concurrent --rebuild runs do
# not race on bender filelist generation (hw/sys/smc/dv/smc_dual_sim_cfg.toml).
**/build/
**/build_dual/
**/build_ot/
**/build_ot_pio/

# Legacy generated register markdown is not part of the current doc flow.
**/regs/gen/adoc/**/*.md
**/regs/gen/adoc/*.md

# The JSON register model is the whole address space serialised (~10 MB per top),
# and the only thing that reads it -- the cocotb register_test -- regenerates it
# during cgen. Tracking it would put a full copy in every commit that touches an
# RDL. nonfree ignores its own copy for the same reason.
**/regs/gen/json/**

# Generated register HTML docs: track the compact single-file fragments used by
# Antora, but keep the old PeakRDL mini-site layout (`index.html` + `content/`)
# ignored/removed.
**/regs/gen/html/**
!**/regs/gen/html/
!**/regs/gen/html/*.html
!**/regs/gen/html/blocks/
!**/regs/gen/html/blocks/*.html
**/regs/gen/html/index.html
**/regs/gen/html/blocks/index.html
**/regs/gen/html/**/content/**

# Documentation builds: staged Antora module sources and rendered output. Product
# builds stage pages/partials/images from product src/meta trees and the hw tree
# (see doc/stage-docs.sh); source of truth stays outside staged module output.
doc/_build/
doc/*/_build/
# Keep the released PDFs tracked (like tt-oca-hw's doc/dist), ignore the rest.
doc/*/dist/*
!doc/*/dist/ocah-*.pdf
doc/*/assets/*
doc/*/src/assets
!doc/trm/assets/.gitignore
doc/trm/assets/*
doc/integrator/assets/*
!doc/integrator/assets/.gitignore
doc/*/modules/ROOT/pages/
doc/*/modules/ROOT/partials/hw/
doc/*/modules/ROOT/assets/
doc/*/modules/smc/
doc/*/modules/sep/
doc/*/modules/dtp/
doc/*/modules/aou/
doc/*/modules/smu/
doc/*/modules/ip/


# Local Antora install for doc builds
.antora-tools/

# npm install target for @antora/lunr-extension (search), installed at
# build time into the bind-mounted repo root by docker-run.sh's
# doc-html-all path -- see scripts/docker-run.sh.
node_modules/

# setuptools metadata generated by an editable install of the DV VIP package
*.egg-info/

# Bender resolves vendored package locks at build time
vendor/**/Bender.lock

# Cocotb testbench transient outputs: Bender-generated filelists, simulation
# build/log trees, and cached cycle counts (e.g. hw/ip/key_manager/dv/tb).
**/dv/tb/rtl.f
**/dv/tb/tb.f
**/dv/tb/i3ccore_filelist.f
**/dv/tb/sim/
**/dv/tb/cycle_counts/
**/dv/tb/ucli.key

# Local bring-up notes: these record host-specific tool paths and license
# server settings, so they stay on the machine that produced them.
**/BRINGUP_STATUS.md

# Nonfree EDA flow bridge and transient outputs at the harness root:
# block_flow_customizations is a symlink into nonfree/ (created by
# nonfree/setup_env.sh for the site wspace_bender.pl flows); the rest are
# generated by the weekly synth/lint/cdc/rdc/fev/elab CI jobs.
/block_flow_customizations
/customer_smu.f
/sim_build_xrun/
/sim_build/
/hw/ip/i3ccore_wrap/dv/tb/sim_build/
/flow_runs/
/flow_runs_*.tar.gz
/packaged_ip/
/weekly_packaged_ip/

# npm install target for a11y
tools/a11y/node_mo#dules/
tools/a11y/report/

# Rendered doc output (sep_book.html / sep_book.pdf)
doc_render/

# sep-vp writes its CSML global log into the current working directory, so it
# lands wherever the simulator was started from (repo root for
# `docker-run.sh vp-run .../sep-vp`, virtual_platform/ under pytest).
och_sep_ss.log
.direnv/
