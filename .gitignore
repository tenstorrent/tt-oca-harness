.venv/
.bender/
__pycache__/
*.pyc

# Optional overlay repositories cloned by make agents-init / make nonfree-init
agents/
nonfree/
overlay/*
!overlay/
!overlay/examples/
!overlay/examples/**

# Transient per-block build outputs. Keep .gitkeep placeholders when used to show structure.
**/build/**
!**/build/
!**/build/**/
!**/build/**/.gitkeep

# Generated register HTML docs are transient PeakRDL viewer output.
**/regs/gen/html/**

