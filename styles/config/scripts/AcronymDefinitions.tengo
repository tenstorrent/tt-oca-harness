//
// Checks that this repo's own acronyms expand to the one phrase each is
// canonically defined as, wherever the document spells the expansion out:
// "<Phrase> (ACRONYM)" or "ACRONYM (<Phrase>)". A mismatch is flagged
// regardless of how the wrong expansion is worded.
//
// This registry is the single source of truth for both canonical and
// additionally accepted expansions. Add an acronym only after confirming
// its expansion in-tree, and cite that source beside the entry.
//
// Tengo's regex support (Go's RE2) has no lookaround, so the phrase-match
// pattern below just grabs the run of hyphen/space-joined words immediately
// before or after the acronym; a joining word (an article, "for", "of") is
// allowed mid-phrase but the run must start with a capitalized word so it
// doesn't wander back across an unrelated earlier sentence.

text := import("text")

canonical := {
  DFD:    ["design-for-debug"], // hw/sys/smc/doc/dfd.adoc
  OCA:    ["open chiplet atlas"], // README.md, NOTICE, doc/**/antora.yml
  OCAH:   ["open chiplet atlas harness"], // README.md
  OCCP:   ["open chiplet configuration protocol"], // hw/sys/smc/bootrom/prod/doc/index.adoc
