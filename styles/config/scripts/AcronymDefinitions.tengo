  SMBus:  ["system management bus"], // hw/ip/i2c/doc/architecture.adoc
  PEC:    ["packet error checking", "smbus packet error checking"], // hw/ip/i2c/doc/architecture.adoc
  ARA:    ["alert response address"], // hw/ip/i2c/doc/architecture.adoc
  MDB:    ["mandatory data byte"], // hw/ip/i3ccore_wrap/dv/tb/I3C_DV_GUIDE.md
  DLL:    ["divisor latch low"], // hw/ip/uart/uart_16550/doc/architecture.adoc
  DLM:    ["divisor latch high"], // hw/ip/uart/uart_16550/doc/architecture.adoc
  LCR:    ["line control register"], // hw/ip/uart/uart_16550/doc/memmap.adoc
  CVD:    ["coordinated vulnerability disclosure"], // doc/starting/src/defects.adoc
  DDR:    ["double data rate"], // hw/common/dv/vip/ocah_spi_vip/README.md
  TCRI:   ["transfer command response interface"], // hw/ip/i3ccore_wrap/doc/architecture.adoc
  RO:     ["ring oscillator"], // hw/ip/entropy_source/dv/tb_vcs/README.md
  PQC:    ["post-quantum cryptography"], // hw/sys/sep/doc/crypto.adoc
  "R/O":  ["read only"], // hw/ip/entropy_source/dv/tb_vcs/doc/REGISTER_VERIFICATION_GUIDE.md
  "R/W":  ["read write"], // hw/ip/entropy_source/dv/tb_vcs/doc/REGISTER_VERIFICATION_GUIDE.md
  "W/O":  ["write only"], // hw/ip/entropy_source/dv/tb_vcs/doc/REGISTER_VERIFICATION_GUIDE.md
  "W1/C": ["write-1-clear"] // hw/ip/entropy_source/dv/tb_vcs/doc/REGISTER_VERIFICATION_GUIDE.md
}

matches := []

canonicalize := func(phrase) {
  // A phrase that line-wrapped in the source carries the hard newline the
  // capture crossed; collapse any run of whitespace back to one space
  // before comparing. Hyphens, commas, and apostrophes are folded so
  // "Memory-Mapped" and "Reliability, Availability" compare equal to the
  // unpunctuated canonical form. Expected values are run through the same
  // function, so a hyphen in the map is not a mismatch.
  collapsed := text.trim_space(text.re_replace("\\s+", phrase, " "))
  lower := text.to_lower(collapsed)
  lower = text.re_replace("'", lower, "")
  lower = text.re_replace("\\s*&\\s*", lower, " and ")
  lower = text.re_replace("[-,]", lower, " ")
  lower = text.trim_space(text.re_replace("\\s+", lower, " "))
  if text.has_prefix(lower, "the ") {
    lower = text.trim_space(text.trim_prefix(lower, "the "))
  }
  if text.has_prefix(lower, "a ") {
    lower = text.trim_space(text.trim_prefix(lower, "a "))
  }
  if text.has_prefix(lower, "an ") {
    lower = text.trim_space(text.trim_prefix(lower, "an "))
  }
  return lower
}

accepted := func(acr, phrase) {
  got := canonicalize(phrase)
  for accepted_phrase in canonical[acr] {
    if got == canonicalize(accepted_phrase) {
      return true
    }
  }
  return false
}

flag := func(begin, end, acr, phrase) {
  if !accepted(acr, phrase) {
    expected := canonical[acr][0]
    display := text.trim_space(text.re_replace("\\s+", phrase, " "))
    matches = append(matches, {
      begin: begin,
      end: end,
      message: "'" + display + "' (" + acr + ") -- this repo defines " +
        acr + " as \"" + expected + "\", not \"" + display + "\"."
    })
  }
}

// A run of Title Case words, optionally joined by a handful of lowercase
// linking words (as in "Design-for-Debug"), anchored to start on a
// capitalized word so it can't wander back into ordinary sentence prose
// (e.g. "This is the Open Chiplet Atlas (OCA) standard" must not capture
// "This is the Open Chiplet Atlas" -- "is" isn't Title Case or a linking
// word, so the run stops there and the match retries starting at "Open").
// AsciiDoc/Markdown prose wraps at ~80 columns, so the words of a phrase
// routinely split across a line break -- the separator class has to match
// a hard newline, not just a space or hyphen.
linking_word := "for|of|the|and|on|in|to|over|&"
// Digits are allowed mid-phrase so "Write-1-Clear" is one expansion, not a
// capture that stops at "Write".
word := "(?:[A-Z][A-Za-z']*|[0-9]+|" + linking_word + ")"
// At least one repetition: a lone capitalized word next to an unrelated
// acronym's parenthetical (e.g. an OS license tag like "(FOSS)" landing
// beside an unrelated "SEP") is far more likely to be coincidence than a
// genuine one-word acronym expansion -- every canonical entry here is at
// least two tokens. Commas are separators so a list expansion such as
// "Reliability, Availability, and Serviceability" is one phrase.
phrase_pattern := "[A-Z][A-Za-z']*(?:[-,\\s]" + word + "){1,6}"

for acr, accepted_phrases in canonical {
  // "<Phrase> (ACRONYM)"
  forward := text.re_find("(" + phrase_pattern + ")\\s*\\(" + acr + "\\)", scope, -1)
  if !is_undefined(forward) {
    for m in forward {
      flag(m[0].begin, m[0].end, acr, m[1].text)
    }
  }

  // "ACRONYM (<Phrase>)"
  reverse := text.re_find("\\b" + acr + "\\s*\\((" + phrase_pattern + ")\\)", scope, -1)
  if !is_undefined(reverse) {
    for m in reverse {
      flag(m[0].begin, m[0].end, acr, m[1].text)
    }
  }
}
