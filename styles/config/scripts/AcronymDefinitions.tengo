  AoU:    ["axi-over-ucie bridge", "axi-over-ucie"], // doc/home/src/features.adoc
  CLA:    ["core logic analyzer"], // hw/sys/smc/doc/dfd.adoc
  PTAP:   ["primary tap", "jtag primary tap"], // hw/ip/jtag/jtag_ptap/doc/index.adoc
  STAP:   ["secondary tap"], // hw/ip/jtag/jtag_stap/doc/index.adoc
