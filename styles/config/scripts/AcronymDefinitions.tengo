  CLAs:   ["core logic analyzers"], // hw/ip/cross_trigger/cross_trigger_matrix/doc/index.adoc
  DFT:    ["design for test"], // hw/ip/gpio/doc/interface.adoc
  VROM:   ["virtual rom"], // hw/ip/key_manager/dv/tb/README.md
