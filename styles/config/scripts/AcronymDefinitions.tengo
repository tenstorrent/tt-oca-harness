  CTP:    ["cross trigger port"], // hw/ip/cross_trigger/cross_trigger_port/doc/index.adoc
  CTN:    ["cross trigger network"], // hw/ip/cross_trigger/cross_trigger_network/dv/README.md
  KM:     ["key manager"], // hw/ip/key_manager/doc/architecture.adoc
  KPV:    ["key and policy vault"], // hw/ip/key_manager/doc/architecture.adoc
  LCC:    ["life cycle controller"], // hw/sys/sep/doc/lifecycle_controller.adoc
  AGP:    ["alarm aggregation processor"], // hw/sys/sep/doc/cpu.adoc
  ARBC:   ["anti-rollback counter"], // hw/sys/sep/doc/periphs.adoc
  FLR:    ["function level reset"], // hw/sys/smc/doc/clk_rst.adoc
  CLINT:  ["core local interruptor"], // hw/sys/smc/doc/interrupts.adoc
  PLIC:   ["platform-level interrupt controller"], // hw/sys/smc/doc/interrupts.adoc
  BIRA:   ["built-in redundancy analysis"], // hw/sys/smc/doc/cpu.adoc
  TMP:    ["test mode persistence"], // hw/ip/jtag/jtag_ptap/doc/architecture.adoc
  TRNG:   ["true random number generator"], // hw/sys/sep/doc/crypto.adoc
  DRBG:   ["deterministic random bit generator"], // hw/ip/drbg/doc/architecture.adoc
  DCLS:   ["dual core lock step"], // hw/sys/sep/doc/cpu.adoc
