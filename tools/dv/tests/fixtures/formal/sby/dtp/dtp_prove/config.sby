#
# Open-path formal run with dtp as the top. The filelist in [files] is generated by bender into
# ../../build/ (hw/common/dv/docs/formal-property-style.adoc); sby copies every [files] entry into
# the task's src/ directory, so the paths inside the filelist must be absolute.
# The TAP clocks flops on both tck edges, so the clocks are modelled explicitly (multiclock on):
# every step is a time point, a tck cycle costs at least two steps, and dtp_sby_env.sv supplies the
# reset model.
# The cover depth must exceed the step at which the deepest cov_ label is reached; the bmc depth
# matches it so that every property is checked over the same horizon.

[options]
multiclock on
mode prove

[engines]
abc pdr

[script]
plugin -i slang
read_slang -D FORMAL --top dtp --single-unit --allow-use-before-declare --timescale=1ns/1ps -f dtp.f dtp_tap_props.sv dtp_tap_bind.sv dtp_sby_env.sv
prep -top dtp

[files]
../../build/dtp.f
../../props/dtp_tap_props.sv
../../props/dtp_tap_bind.sv
dtp_sby_env.sv
