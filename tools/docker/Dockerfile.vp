#
# ocah-vp-toolchain: everything needed to BUILD and RUN the SEP virtual
# platform (virtual_platform/) inside a container, for hosts without a native
# C++20 toolchain. Deliberately a separate image from the RISC-V firmware image
# (Dockerfile): extending that one would change its dockerfile-sha and force
# firmware rebuilds for every consumer.
#
# Contents:
# - Native C++20 toolchain + cmake/autotools for SystemC/CCI/sep-vp builds.
#   (Boost/OpenSSL come from apt and satisfy the VP's floors: Boost >= 1.74,
#   OpenSSL >= 3.0 — the harness Makefile's system-deps detection picks them.)
# - The RISC-V + picolibc firmware toolchain (same packages as the firmware
#   image) so the pytest suites can build the boot ROM / DV tests in here.
# - Runner Python from apt (pexpect/pytest/yaml/pyelftools/toml — the host
#   .venv is not usable inside; cryptography/ruamel.yaml serve the
#   tt-boot-manifest packer's uv-less fallback).
#
# NOTE: a sep-vp built in here links this image's glibc/libstdc++ and must also
# RUN in here (scripts/docker-run.sh vp-run / vp-shell). Build artifacts land
# in ctr-tagged trees (local-ctr/, vp/build-ctr) so they never mix with a
# native build.

FROM debian:trixie-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2

RUN apt-get update && apt-get install -y --no-install-recommends \
        make \
        g++ \
        cmake \
        autoconf \
        automake \
        wget \
        ca-certificates \
        git \
        libboost-iostreams-dev \
        libboost-program-options-dev \
        libboost-log-dev \
        libssl-dev \
        zlib1g-dev \
        python3 \
        python3-pexpect \
        python3-pytest \
        python3-yaml \
        python3-pyelftools \
        python3-toml \
        python3-cryptography \
        python3-ruamel.yaml \
        python3-tomlkit \
        python3-bitarray \
        gcc-riscv64-unknown-elf \
        picolibc-riscv64-unknown-elf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
