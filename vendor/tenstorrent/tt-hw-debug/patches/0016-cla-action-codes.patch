@@ -357,7 +357,7 @@ c_dbg_node0_eap0:
     FIELDS_RANGE: '63:58'
     RESET_VALUE: '0'
     LEGAL_VALUE: ''
-    DESCRIPTION: Select an Action
+    DESCRIPTION: "Action code: 0 none; 1 clock halt; 2 debug interrupt; 3 GPIO output, held while the action is active; 4 trace start; 5 trace stop; 6 trace pulse; 7 cross-trigger 0 out; 8 cross-trigger 1 out; 16+4n, 17+4n, 18+4n and 19+4n increment, clear, start auto-increment and stop auto-increment of counter n, for n from 0 to 3. Codes 9 to 15 and 32 to 63 select no action."
