# Backport of chipsalliance/Cores-VeeR-EL2 fe5a6e13ef ("configs: Fix packed el2_param_t vector when
# lockstep options are dropped"), restricted to the lockstep options this revision defines. With
# lockstep disabled, the lockstep_* %verilog_parms entries kept their field widths as digit strings,
# which corrupted the packed el2_param_t vector around them and forced LOAD_TO_USE_PLUS1 to 0 even
# when the snapshot set it to 1. dump_parms now refuses any non-binary field instead of packing it.

--- a/configs/veer.config
+++ b/configs/veer.config
@@ -1871,6 +1871,14 @@
 $c=$config{protection}{lockstep_delay}; if ($d==0 || ($c==0 && !grep(/lockstep_delay=/, @sets))) { delete $config{"protection"}{"lockstep_delay"}; }
 $c=$config{protection}{lockstep_regfile_enable}; if ($d==0 || ($c==0 || !grep(/lockstep_regfile_enable=/, @sets))) { delete $config{"protection"}{"lockstep_regfile_enable"}; }
 
+# gen_define() only converts %verilog_parms entries whose key is still in %config. For the lockstep_*
+# keys deleted above, %verilog_parms still holds the field width (e.g. "7"), which would end up as
+# non-binary characters in the packed el2_param_t vector. Zero them explicitly instead.
+foreach my $k (qw(lockstep_enable lockstep_regfile_enable lockstep_delay)) {
+    next unless exists $verilog_parms{$k} && !exists $config{protection}{$k};
+    $verilog_parms{$k} = d2b($k, 0, $verilog_parms{$k});
+}
+
 print "\nVeeR configuration for target=$target\n\n";
 dump_define("","", \%config,[]);
 
@@ -2619,6 +2627,7 @@
     my $parmcnt=0;
     foreach my $key (sort keys %$hash) {
         #printf("// $key = %s\n",$verilog_parms{$key});
+        die("dump_parms: parameter $key has non-binary value '$hash->{$key}'\n") if $hash->{$key} !~ /^[01]+$/;
         $bcat.=$hash->{$key};
         $parmcnt++;
     }
