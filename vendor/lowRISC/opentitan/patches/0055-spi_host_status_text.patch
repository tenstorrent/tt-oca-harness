# STATUS.BYTEORDER states that it reads the ByteOrder parameter (1) from the first clock after reset,
# and STATUS.RXWM and EVENT_ENABLE.RXWM state the RX watermark as RXQD >= RX_WATERMARK.

diff --git a/hw/ip/spi_host/data/spi_host.hjson b/hw/ip/spi_host/data/spi_host.hjson
--- a/hw/ip/spi_host/data/spi_host.hjson
+++ b/hw/ip/spi_host/data/spi_host.hjson
@@ -305,12 +305,14 @@
         { bits: "22",
           name: "BYTEORDER",
           desc: '''The value of the ByteOrder parameter, provided so that firmware
-                   can confirm proper IP configuration.'''
+                   can confirm proper IP configuration. Reads 1 in SEP (ByteOrder = 1);
+                   the listed reset value of 0 holds only for the first clock after
+                   reset.'''
         }
         { bits: "20",
           name: "RXWM",
-          desc: '''If high, the number of 32-bits in the RX FIFO now exceeds the
-                   !!CONTROL.RX_WATERMARK entries (32b each).'''
