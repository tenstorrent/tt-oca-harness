# An exception sets its HW_EXC_STS bit, which holds until software writes 0, as the register
# description states. Hardware reads the field (hrw) so a new exception keeps the bits already set.

diff --git a/hw/ip/csrng/data/csrng.hjson b/hw/ip/csrng/data/csrng.hjson
index 1122b9a832..1fe65c7208 100644
--- a/hw/ip/csrng/data/csrng.hjson
+++ b/hw/ip/csrng/data/csrng.hjson
@@ -589,7 +589,7 @@
       name: "HW_EXC_STS",
       desc: "Hardware instance exception status register",
       swaccess: "rw0c",
-      hwaccess: "hwo",
+      hwaccess: "hrw",
       fields: [
         { bits: "15:0",
           name: "HW_EXC_STS",
diff --git a/hw/ip/csrng/rtl/csrng_core.sv b/hw/ip/csrng/rtl/csrng_core.sv
index a61ca8ea51..591b02b0b2 100644
--- a/hw/ip/csrng/rtl/csrng_core.sv
+++ b/hw/ip/csrng/rtl/csrng_core.sv
@@ -999,8 +999,9 @@ module csrng_core import csrng_pkg::*; #(
   //--------------------------------------------
   // Misc status
 
-  assign hw2reg.hw_exc_sts.de = cs_enable_fo[50];
-  assign hw2reg.hw_exc_sts.d  = hw_exception_sts;
+  // An exception sets its bit, which holds until software writes 0.
+  assign hw2reg.hw_exc_sts.de = cs_enable_fo[50] && (|hw_exception_sts);
+  assign hw2reg.hw_exc_sts.d  = reg2hw.hw_exc_sts.q | hw_exception_sts;
 
   // unused signals
   logic               unused_err_code_test_bit;
