# RANGE_REGWEN states the MuBi write-zero-to-clear read-back, and SRC_CONFIG and DST_CONFIG state
# that INCREMENT acts within a chunk while WRAP sets where the next chunk starts.

diff --git a/hw/ip/dma/data/dma.hjson b/hw/ip/dma/data/dma.hjson
--- a/hw/ip/dma/data/dma.hjson
+++ b/hw/ip/dma/data/dma.hjson
@@ -336,9 +336,9 @@
           resval: true
           desc: '''
                 Used by firmware to lock the DMA enabled memory range configuration registers from further modification.
-                Once this register is set to kMultiBitBool4False, it can only be set to kMultiBitBool4True through a reset event.
-
-                Default Value = kMultiBitBool4True -> Unlocked at reset.
+                The range registers are writable only while this field reads kMultiBitBool4True (0x6), its reset value.
+                A write from the reset value stores the written value, so writing kMultiBitBool4False (0x9) reads back 0x9, and any value other than 0x6 locks the range.
+                After that, writes can only clear bits 1 and 2 and set bits 0 and 3, so the field cannot return to kMultiBitBool4True before a reset.
                 '''
         }
       ]
@@ -558,18 +558,19 @@
           name: "wrap"
           resval: 0x0
           desc: '''
-                When 0: Chunks occupy contiguous ascending addresses.
-                When 1: Source address wraps back to the starting address when finishing a chunk.
+                When 0: each chunk starts where the previous one ended: with INCREMENT = 0, SRC_ADDR_LO/HI advance by CHUNK_DATA_SIZE after each chunk; with INCREMENT = 1, reads continue ascending from the end of the previous chunk.
+                When 1: every chunk starts at SRC_ADDR_LO/HI.
+                Set INCREMENT = 0 and WRAP = 1 to read every chunk from one fixed address, such as a peripheral FIFO.
                 '''
         }
         { bits: "0"
           name: "increment"
           resval: 0x0
           desc: '''
-                Defines the increment behavior after every DMA read.
-                When 0: Source address is not changed.
-                        All reads are done from the same address.
-                When 1: Source address is incremented by transfer_width after each read.
+                Defines the address step within a chunk.
+                When 0: every read of a chunk uses the chunk's start address.
+                When 1: each read is transfer_width bytes above the previous one.
+                WRAP sets where the next chunk starts.
                 '''
         }
       ]
@@ -585,18 +586,19 @@
           name: "wrap"
           resval: 0x0
           desc: '''
-                When 0: Chunks occupy contiguous ascending addresses.
-                When 1: Destination address wraps back to the starting address when finishing a chunk.
+                When 0: each chunk starts where the previous one ended: with INCREMENT = 0, DST_ADDR_LO/HI advance by CHUNK_DATA_SIZE after each chunk; with INCREMENT = 1, writes continue ascending from the end of the previous chunk.
+                When 1: every chunk starts at DST_ADDR_LO/HI.
+                Set INCREMENT = 0 and WRAP = 1 to write every chunk to one fixed address, such as a peripheral FIFO.
                 '''
         }
         { bits: "0"
           name: "increment"
           resval: 0x0
           desc: '''
-                Defines the increment behavior after every DMA write.
-                When 0: Destination address is not changed.
-                        All writes are done to the same address.
-                When 1: Destination address is incremented by transfer_width after each write.
+                Defines the address step within a chunk.
+                When 0: every write of a chunk uses the chunk's start address.
+                When 1: each write is transfer_width bytes above the previous one.
+                WRAP sets where the next chunk starts.
                 '''
         }
       ]
diff --git a/hw/ip/dma/doc/registers.md b/hw/ip/dma/doc/registers.md
--- a/hw/ip/dma/doc/registers.md
+++ b/hw/ip/dma/doc/registers.md
@@ -344,9 +344,9 @@ Used to lock the DMA enabled memory range configuration registers.
 
 ### RANGE_REGWEN . regwen
 Used by firmware to lock the DMA enabled memory range configuration registers from further modification.
-Once this register is set to kMultiBitBool4False, it can only be set to kMultiBitBool4True through a reset event.
-
-Default Value = kMultiBitBool4True -> Unlocked at reset.
+The range registers are writable only while this field reads kMultiBitBool4True (0x6), its reset value.
+A write from the reset value stores the written value, so writing kMultiBitBool4False (0x9) reads back 0x9, and any value other than 0x6 locks the range.
+After that, writes can only clear bits 1 and 2 and set bits 0 and 3, so the field cannot return to kMultiBitBool4True before a reset.
 
 ## CFG_REGWEN
 Indicates whether the configuration registers are locked because the DMA controller is operating.
@@ -539,8 +539,8 @@ Defines the addressing behavior of the DMA for the source address.
 |  Bits  |  Type  |  Reset  | Name      | Description                                                                                                                                                                                                    |
 |:------:|:------:|:-------:|:----------|:---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
 |  31:2  |        |         |           | Reserved                                                                                                                                                                                                       |
-|   1    |   rw   |   0x0   | wrap      | When 0: Chunks occupy contiguous ascending addresses. When 1: Source address wraps back to the starting address when finishing a chunk.                                                                        |
-|   0    |   rw   |   0x0   | increment | Defines the increment behavior after every DMA read. When 0: Source address is not changed. All reads are done from the same address. When 1: Source address is incremented by transfer_width after each read. |
+|   1    |   rw   |   0x0   | wrap      | When 0: each chunk starts where the previous one ended: with INCREMENT = 0, SRC_ADDR_LO/HI advance by CHUNK_DATA_SIZE after each chunk; with INCREMENT = 1, reads continue ascending from the end of the previous chunk. When 1: every chunk starts at SRC_ADDR_LO/HI. Set INCREMENT = 0 and WRAP = 1 to read every chunk from one fixed address, such as a peripheral FIFO. |
+|   0    |   rw   |   0x0   | increment | Defines the address step within a chunk. When 0: every read of a chunk uses the chunk's start address. When 1: each read is transfer_width bytes above the previous one. WRAP sets where the next chunk starts. |
 
 ## DST_CONFIG
 Defines the addressing behavior of the DMA for the destination address.
@@ -558,8 +558,8 @@ Defines the addressing behavior of the DMA for the destination address.
 |  Bits  |  Type  |  Reset  | Name      | Description                                                                                                                                                                                                               |
 |:------:|:------:|:-------:|:----------|:--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|
 |  31:2  |        |         |           | Reserved                                                                                                                                                                                                                  |
-|   1    |   rw   |   0x0   | wrap      | When 0: Chunks occupy contiguous ascending addresses. When 1: Destination address wraps back to the starting address when finishing a chunk.                                                                              |
-|   0    |   rw   |   0x0   | increment | Defines the increment behavior after every DMA write. When 0: Destination address is not changed. All writes are done to the same address. When 1: Destination address is incremented by transfer_width after each write. |
+|   1    |   rw   |   0x0   | wrap      | When 0: each chunk starts where the previous one ended: with INCREMENT = 0, DST_ADDR_LO/HI advance by CHUNK_DATA_SIZE after each chunk; with INCREMENT = 1, writes continue ascending from the end of the previous chunk. When 1: every chunk starts at DST_ADDR_LO/HI. Set INCREMENT = 0 and WRAP = 1 to write every chunk to one fixed address, such as a peripheral FIFO. |
+|   0    |   rw   |   0x0   | increment | Defines the address step within a chunk. When 0: every write of a chunk uses the chunk's start address. When 1: each write is transfer_width bytes above the previous one. WRAP sets where the next chunk starts. |
 
 ## STATUS
